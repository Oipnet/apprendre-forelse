# Sauvegarde quotidienne vers le NAS de la Freebox Pro (/srv/forelse/sauvegarde/sauvegarde.env, droits 600).
# Voir deploy/README.md, « Sauvegarde quotidienne ». Une valeur par ligne, sans guillemets.

# VPN de la Freebox Pro (IPsec IKEv2, identifiant et mot de passe créés dans l'onglet VPN de l'espace client).
VPN_SERVEUR=508488734.box.freepro.com
VPN_UTILISATEUR=vps-sauvegarde
VPN_MOT_DE_PASSE=

# NAS : son adresse sur le réseau de la Freebox et le partage réservé aux sauvegardes. Le NAS de la Freebox Pro s'ouvre
# en invité depuis son réseau : laissez le compte vide. Un NAS à comptes : NAS_UTILISATEUR et NAS_MOT_DE_PASSE.
NAS_IP=192.168.10.246
NAS_PARTAGE=saveForelse
NAS_UTILISATEUR=
NAS_MOT_DE_PASSE=
# Jours de sauvegardes gardés sur le NAS.
NAS_GARDER=30

# Sur le serveur : où garder les copies locales, et combien de jours.
SAUVEGARDE_DIR=sauvegardes/quotidiennes
SAUVEGARDE_GARDER_LOCAL=7

# Facultatif : une adresse de surveillance (healthchecks.io ou équivalent), appelée à chaque sauvegarde réussie, et
# avec /fail en cas d'échec. Sans elle, une sauvegarde qui échoue ne se voit que dans sauvegardes/sauvegarde.log.
SAUVEGARDE_PING_URL=
