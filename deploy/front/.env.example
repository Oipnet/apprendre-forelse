# Le proxy commun (/srv/front/.env). Voir deploy/README.md.

# Adresse de contact donnée à Let's Encrypt (expiration de certificats, incidents).
ACME_EMAIL=contact@forelse.fr

# Production : les noms d'hôte publics, séparés par des virgules. Le bac à sable est sur un AUTRE domaine que la
# plateforme ; ajoutez le nom du tableau de bord d'Umami s'il est exposé (ANALYTICS_SERVER_NAME).
PRODUCTION_HOSTS=apprendre.forelse.fr, bac-a-sable.example.net

# Préproduction : chaque adresse en sous-domaine de celle de la production correspondante, jamais le bac à sable
# sous le domaine de la plateforme (même « site » pour le navigateur, voir auto-hebergement/README.md).
PREPRODUCTION_APP_HOST=preprod.forelse.fr
PREPRODUCTION_SANDBOX_HOST=preprod.bac-a-sable.example.net

# Mot de passe de la préproduction. L'empreinte, jamais le mot de passe :
#   docker run --rm -it caddy:2.10-alpine caddy hash-password
# (il demande le mot de passe deux fois, sans l'afficher ni le laisser dans l'historique du shell)
# Entre guillemets simples : sans eux, Docker Compose lirait ses $ comme des variables.
PREPRODUCTION_USER=forelse
PREPRODUCTION_PASSWORD_HASH='$2a$14$...'

# Vide en production. Essai local : local_certs.
FRONT_OPTIONS=
