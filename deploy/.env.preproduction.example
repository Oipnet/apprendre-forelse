# Préproduction (/srv/forelse-staging/.env). Voir deploy/README.md.
# Mêmes variables que la production (voir compose.yaml) ; seules celles qui changent sont ici.

COMPOSE_FILE=compose.yaml:derriere-front.yaml:preproduction.yaml
# Son nom sur le réseau du proxy (deploy/front/Caddyfile l'attend sous ce nom).
FRONT_ALIAS=forelse-preprod
# Son étiquette d'image sur le serveur, distincte de celle de la production (:edge).
IMAGE_TAG=preprod

# Chacune en sous-domaine de l'adresse correspondante de la production.
APP_URL=https://preprod.forelse.fr
SANDBOX_URL=https://preprod.bac-a-sable.example.net

# Sa propre base, avec son propre mot de passe.
POSTGRES_PASSWORD=

# Les packs et la marque de la production, en lecture seule : ce que les apprenants verront à la prochaine version.
PACKS_DIR=/srv/forelse/packs
BRANDING_HOST_DIR=/srv/forelse/marque

# Inscriptions ouvertes : elle est derrière le mot de passe du proxy, et sa base démarre sans aucun compte.
REGISTRATION_INVITE_ONLY=0

# Le même DSN que la production : ses erreurs y sont rangées sous « preproduction » (preproduction.yaml).
SENTRY_DSN=

# Rien vers le monde réel.
MAILER_DSN=null://null
REGISTRATION_ALERT_EMAIL=
CONTACT_EMAIL=
# Clés Stripe de TEST (sk_test_…), ou vide : pas de bouton d'achat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Le mentor coûte à chaque appel : vide pour le couper, ou une limite basse.
ANTHROPIC_API_KEY=
MENTOR_DAILY_LIMIT=20

# Plafonds bas : elle ne doit jamais priver la production, qui tourne à côté.
APP_MEM_LIMIT=768m
EMPAQUETEUR_MEM_LIMIT=512m
ENVIRONMENTS_AUTO_INSTALL=0
