{
    "name": "forelse/simulateur-docker",
    "description": "Simulateur Docker en PHP pur : docker build / run / compose sans démon, pour apprendre Docker dans le navigateur (php-wasm).",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.15",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Forelse\\DockerSim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Forelse\\DockerSim\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/docker"
    ],
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/tests",
            "/composer.lock",
            "/.phpunit.cache"
        ]
    }
}
