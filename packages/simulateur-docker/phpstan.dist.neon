# Analyse statique du simulateur. Les erreurs connues sont gelées dans phpstan-baseline.neon : la CI échoue sur
# toute erreur nouvelle. Corriger une erreur de la baseline, puis la régénérer :
#   vendor/bin/phpstan analyse --generate-baseline
includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: .phpstan.cache
