{
	"name": "@forelse/simulateur-nuxt",
	"version": "0.1.0",
	"description": "Simulateur Nuxt en TypeScript : routes serveur Nitro/h3 sans Node, pour apprendre Nuxt dans le navigateur.",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./node": "./src/node/index.ts",
		"./browser": "./src/browser/forelse.ts",
		"./vite": "./src/node/vite.ts",
		"./package.json": "./package.json",
		"./tests": "./bin/tests.ts"
	},
	"scripts": {
		"test": "vitest run tests/",
		"conformite": "vitest run conformite/",
		"typecheck": "tsc --noEmit",
		"demo": "node --experimental-transform-types demo/serveur.ts"
	},
	"dependencies": {
		"@forelse/runtime-contract": "file:../../packages/runtime-contract",
		"@unhead/vue": "3.4.1",
		"@vitest/expect": "5.0.1",
		"@vitest/spy": "5.0.1",
		"@vue/test-utils": "2.4.6",
		"acorn": "8.18.0",
		"buffer": "6.0.3",
		"chai": "^6.2.2",
		"cookie-es": "1.2.3",
		"cookie-es-nuxt": "npm:cookie-es@3.1.1",
		"devalue": "5.9.2",
		"es-module-lexer": "^3.0.2",
		"fflate": "^0.8.3",
		"fnv1a-64": "0.1.2",
		"happy-dom": "20.14.5",
		"hookable": "6.1.1",
		"klona": "2.0.6",
		"object-identity": "0.2.3",
		"ofetch": "1.5.1",
		"ohash": "2.0.12",
		"sucrase": "^3.35.1",
		"ufo": "1.6.4",
		"unhead": "3.4.1",
		"unrouting": "^0.2.3",
		"unstorage": "1.17.5",
		"vue": "3.5.42",
		"vue-router": "5.3.1"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"rolldown": "^1.2.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
