.idea/
.DS_Store

# Playground (îlot JS)
playground/node_modules/
packages/*/node_modules/

# Artefacts générés par environments/bin/build-env.sh
platform/public/envs/

# Environnements Symfony (reconstruits par composer install)
environments/*/vendor/
environments/*/var/
environments/*/.phpunit.cache/

# Simulateur Docker (runtime du moteur, installé dans environments/docker par build-env.sh)
packages/simulateur-docker/vendor/
packages/simulateur-docker/composer.lock
packages/simulateur-docker/.phpunit.cache/

# Simulateur Nuxt (vrai Nuxt de référence pour les tests de conformité)
packages/simulateur-nuxt/node_modules/
packages/simulateur-nuxt/conformite/reference/node_modules/
packages/simulateur-nuxt/conformite/reference/.nuxt/
packages/simulateur-nuxt/conformite/reference/.output/
packages/simulateur-nuxt/conformite/reference/.data/
packages/simulateur-nuxt/conformite/sans-pages/node_modules
packages/simulateur-nuxt/conformite/sans-pages/.nuxt/
packages/simulateur-nuxt/conformite/runner/node_modules/
packages/simulateur-docker/.phpstan.cache/
