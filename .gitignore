tools/docker-sim/vendor/
tools/docker-sim/composer.lock
tools/docker-sim/.phpunit.cache/

# Simulateur Nuxt (vrai Nuxt de référence pour les tests de conformité)
tools/nuxt-sim/node_modules/
tools/nuxt-sim/conformite/reference/node_modules/
tools/nuxt-sim/conformite/reference/.nuxt/
tools/nuxt-sim/conformite/reference/.output/
tools/nuxt-sim/conformite/reference/.data/
tools/nuxt-sim/conformite/sans-pages/node_modules
tools/nuxt-sim/conformite/sans-pages/.nuxt/
