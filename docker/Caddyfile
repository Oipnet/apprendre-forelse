{
	frankenphp
}

# Deux origines, une seule application : la plateforme (APP_URL) et le bac à sable (SANDBOX_URL),
# qui sert l'aperçu du code des apprenants. Symfony cloisonne ce que chacune a le droit de servir.
# Une adresse en https:// active le HTTPS automatique (Let's Encrypt) ; en http://, aucun certificat.
# SERVER_NAME vaut « APP_URL, SANDBOX_URL » par défaut (voir docker-entrypoint.sh). Derrière un reverse proxy qui
# gère déjà le HTTPS : SERVER_NAME=:80, du HTTP simple pour tous les noms d'hôte.
{$SERVER_NAME} {
	root /app/platform/public

	# Le binaire PHP WebAssembly (≈ 19 Mo) tombe à ≈ 7 Mo compressé. Les fichiers sans type connu
	# (données ICU .dat ≈ 29 Mo, extensions .so) sortent en application/octet-stream : compressés
	# aussi. Les archives .zip des environnements (application/zip) ne le sont pas, inutile.
	encode {
		zstd
		br
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/wasm*
			header Content-Type application/octet-stream*
			header Content-Type image/svg+xml*
		}
	}

	# Assets Vite (noms hashés) et archives d'environnement : cache long.
	@immutable path /build/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Images du site (logos, favicons) : noms stables, un mois de cache. Un visuel modifié change de nom.
	@img path /img/*
	header @img Cache-Control "public, max-age=2592000"
	@envs path /envs/*
	header @envs Cache-Control "public, max-age=86400"
	# Le Service Worker de l'aperçu doit toujours être revalidé.
	@sw path /preview-sw.js
	header @sw Cache-Control "no-cache"

	# Mesure d'audience : le traceur et son point de collecte sont servis par le site lui-même, et non
	# depuis le domaine d'Umami. Même origine = rien à autoriser côté navigateur, et un bloqueur de
	# publicités n'y voit pas un traceur tiers. Le traceur déduit son point de collecte du dossier de son
	# propre src : /mesure/traceur.js envoie donc à /mesure/api/send, d'où le préfixe commun, retiré ici.
	# Seuls ces deux chemins passent : le reste d'Umami (tableau de bord, API d'administration) n'est pas
	# exposé par cette origine. Sans conteneur « umami », ces deux chemins répondent 502 et rien d'autre
	# ne change : une instance auto-hébergée sans mesure d'audience n'a rien à retirer d'ici.
	@mesure path /mesure/traceur.js /mesure/api/send
	handle @mesure {
		uri strip_prefix /mesure
		reverse_proxy {$ANALYTICS_UPSTREAM:umami:3000}
	}

	handle {
		php_server
	}
}

# Tableau de bord d'Umami, sur son propre nom d'hôte (ANALYTICS_SERVER_NAME, ex. https://suivi.example.org) :
# l'image officielle est construite pour la racine d'un domaine, elle ne sait pas vivre sous un sous-chemin.
# Variable absente, le cas par défaut : Caddy écoute une adresse locale inutilisée, le tableau de bord n'est
# donc accessible que par un tunnel SSH (voir auto-hebergement/README.md). À n'ouvrir qu'après avoir changé
# le mot de passe du compte « admin », qui vaut « umami » à la première installation.
{$ANALYTICS_SERVER_NAME:http://127.0.0.1:9998} {
	reverse_proxy {$ANALYTICS_UPSTREAM:umami:3000}
}
