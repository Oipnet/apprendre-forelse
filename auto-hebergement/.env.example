# Réglages de votre instance. Copiez ce fichier en .env à côté de compose.yaml, remplissez-le,
# puis `docker compose up -d`. Après toute modification : `docker compose up -d` à nouveau.
# Ne le commitez jamais : il contient des secrets.

# --- Indispensable ---------------------------------------------------------------------------------

# Adresse de la plateforme, et celle du bac à sable où s'affiche le code des apprenants.
# Deux DOMAINES différents (pas deux sous-domaines du même domaine), qui pointent tous deux vers ce serveur.
APP_URL=https://apprendre.example.org
SANDBOX_URL=https://apprendre-bac-a-sable.net

# Mot de passe de la base, lettres et chiffres uniquement (il est inséré dans une URL).
# Par exemple : openssl rand -hex 24. À choisir avant le premier démarrage : le changer ensuite ne suffit pas.
POSTGRES_PASSWORD=

# Fuseau des heures affichées (administration, exports). À choisir avant les premiers comptes.
APP_TIMEZONE=Europe/Paris

# Image du moteur. :latest suit la dernière version publiée ; :1 reste sur la 1.x (aucun changement cassant) ;
# :1.0 ne prend que les correctifs de la 1.0 ; :1.0.0 est une version figée.
APP_IMAGE=ghcr.io/oipnet/apprendre-forelse:1

# --- Emails ----------------------------------------------------------------------------------------
# Confirmation d'adresse, mot de passe oublié, achats, formulaire de contact. Sans eux, rien ne part.
# Un serveur SMTP (caractères spéciaux du mot de passe encodés : @ → %40) :
#   MAILER_DSN=smtp://utilisateur:mot-de-passe@smtp.example.org:587
# ou l'API Brevo, incluse dans l'image :
#   MAILER_DSN=brevo+api://CLE_API@default
MAILER_DSN=
# Expéditeur affiché, « Nom <adresse> ». Son domaine doit être autorisé chez votre fournisseur (SPF, DKIM).
MAILER_FROM="Apprendre <ne-pas-repondre@example.org>"
# Destinataire du formulaire de contact. Vide : LEGAL_PUBLISHER_EMAIL.
CONTACT_EMAIL=
# Un email à chaque nouvelle inscription. Vide : pas d'alerte.
REGISTRATION_ALERT_EMAIL=

# --- Mentions légales et confidentialité (/mentions-legales, /confidentialite) -------------------------
# Qui édite et héberge cette instance. Tant qu'un champ obligatoire manque, les pages le signalent.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_LEGAL_FORM=
LEGAL_PUBLISHER_REGISTRATION=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Facultatifs.
LEGAL_PUBLISHER_VAT=
LEGAL_PUBLISHER_PHONE=
LEGAL_HOST_PHONE=

# --- Inscription et référencement ------------------------------------------------------------------

# 0 = inscription libre ; 1 = sur invitation, avec un code de cohorte créé dans /admin.
REGISTRATION_INVITE_ONLY=0
# 1 = les pages publiques s'indexent (robots.txt, sitemap.xml) ; 0 = instance interne ou de préproduction.
SEARCH_INDEXING=1
# Google Search Console, méthode « balise HTML » : la valeur de content="…".
GOOGLE_SITE_VERIFICATION=

# --- Contenu ---------------------------------------------------------------------------------------

# Dossier des packs de contenu sur ce serveur, monté en lecture seule. Vide : pack de démonstration.
PACKS_DIR=./packs
# Packs chargés, chemins DANS le conteneur séparés par des virgules. Ajoutez /app/examples/packs pour
# garder le parcours de démonstration à côté de vos packs.
CONTENT_PACKS_PATHS=/packs

# --- Réseau ----------------------------------------------------------------------------------------
# Par défaut, le conteneur publie 80 et 443 et obtient seul ses certificats HTTPS (Let's Encrypt).
#
# Derrière un reverse proxy qui gère déjà le HTTPS (nginx, Traefik, Caddy…) :
#   SERVER_NAME=:80
#   SYMFONY_TRUSTED_PROXIES=private_ranges
#   HTTP_PORT=127.0.0.1:8080
#   HTTPS_PORT=127.0.0.1:8443
#
# Pour un essai sur votre poste, sans nom de domaine :
#   APP_URL=http://localhost:8080
#   SANDBOX_URL=http://127.0.0.1:8080
#   SERVER_NAME=:80
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
SERVER_NAME=
SYMFONY_TRUSTED_PROXIES=
HTTP_PORT=80
HTTPS_PORT=443

# --- Facultatif ------------------------------------------------------------------------------------

# Mentor de l'apprenant et génération assistée dans l'atelier des auteurs (clé d'API Anthropic).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Vente des parcours (Stripe Checkout + Stripe Tax). Vide : les parcours tarifés ne peuvent pas être achetés.
# Webhook à déclarer chez Stripe : <APP_URL>/paiement/stripe/webhook, événements checkout.session.completed
# et checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_CODE=txcd_10000000
# Conditions générales de vente (/cgv) : médiateur de la consommation (obligatoire pour vendre à des
# particuliers en France) et garantie « satisfait ou remboursé » en jours (vide : pas de garantie).
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
LEGAL_REFUND_DAYS=

# Secret de l'application. Vide : généré au premier démarrage et conservé dans le volume data.
APP_SECRET=
