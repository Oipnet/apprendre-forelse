# Réglages de votre instance. Copiez ce fichier en .env à côté de compose.yaml, remplissez-le,
# puis `docker compose up -d`. Après toute modification : `docker compose up -d` à nouveau.
# Ne le commitez jamais : il contient des secrets.

# --- Indispensable ---------------------------------------------------------------------------------

# Adresse de la plateforme, et celle du bac à sable où s'affiche le code des apprenants.
# Deux DOMAINES différents (pas deux sous-domaines du même domaine), qui pointent tous deux vers ce serveur.
APP_URL=https://apprendre.example.org
SANDBOX_URL=https://apprendre-bac-a-sable.net

# Mot de passe de la base, lettres et chiffres uniquement (il est inséré dans une URL).
# Par exemple : openssl rand -hex 24. À choisir avant le premier démarrage : le changer ensuite ne suffit pas.
POSTGRES_PASSWORD=

# Fuseau des heures affichées (administration, exports). À choisir avant les premiers comptes.
APP_TIMEZONE=Europe/Paris

# Image du moteur. :latest suit la dernière version publiée ; :1 reste sur la 1.x (aucun changement cassant) ;
# :1.0 ne prend que les correctifs de la 1.0 ; :1.0.0 est une version figée.
APP_IMAGE=ghcr.io/oipnet/apprendre-forelse:1

# --- Emails ----------------------------------------------------------------------------------------
# Confirmation d'adresse, mot de passe oublié, achats, formulaire de contact. Sans eux, rien ne part.
# Un serveur SMTP (caractères spéciaux du mot de passe encodés : @ → %40) :
#   MAILER_DSN=smtp://utilisateur:mot-de-passe@smtp.example.org:587
# ou l'API Brevo, incluse dans l'image :
#   MAILER_DSN=brevo+api://CLE_API@default
MAILER_DSN=
# Expéditeur affiché, « Nom <adresse> ». Son domaine doit être autorisé chez votre fournisseur (SPF, DKIM).
MAILER_FROM="Apprendre <ne-pas-repondre@example.org>"
# Destinataire du formulaire de contact. Vide : LEGAL_PUBLISHER_EMAIL.
CONTACT_EMAIL=
# Un email à chaque nouvelle inscription. Vide : pas d'alerte.
REGISTRATION_ALERT_EMAIL=

# --- Mentions légales et confidentialité (/mentions-legales, /confidentialite) -------------------------
# Qui édite et héberge cette instance. Tant qu'un champ obligatoire manque, les pages le signalent.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_LEGAL_FORM=
LEGAL_PUBLISHER_REGISTRATION=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Facultatifs.
LEGAL_PUBLISHER_VAT=
LEGAL_PUBLISHER_PHONE=
LEGAL_HOST_PHONE=

# --- Inscription et référencement ------------------------------------------------------------------

# 0 = inscription libre ; 1 = sur invitation, avec un code de cohorte créé dans /admin.
REGISTRATION_INVITE_ONLY=0
# 1 = les pages publiques s'indexent (robots.txt, sitemap.xml) ; 0 = instance interne ou de préproduction.
SEARCH_INDEXING=1
# Google Search Console, méthode « balise HTML » : la valeur de content="…".
GOOGLE_SITE_VERIFICATION=

# --- Mesure d'audience (facultative) ---------------------------------------------------------------
# Umami, hébergé avec l'instance : sans cookie, sans adresse IP conservée, donc sans bandeau de
# consentement. Rien ne tourne et rien n'est mesuré tant que le profil n'est pas activé :
#   docker compose --profile mesure up -d
# Décommentez la ligne suivante pour ne plus avoir à taper --profile.
#COMPOSE_PROFILES=mesure
# Renseignées après avoir créé le site dans le tableau de bord d'Umami (voir README) ; vides, aucune
# balise n'est posée dans les pages.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
# Nom d'hôte qui sert le tableau de bord, avec son enregistrement DNS (ex. https://suivi.example.org).
# Vide, le choix le plus sûr : rien n'est exposé sur l'internet, et le tableau de bord se consulte par
# un tunnel SSH (voir README). L'exposer publie une page de connexion, à ne faire qu'après avoir changé
# le mot de passe du compte « admin ».
ANALYTICS_SERVER_NAME=
# Port du tableau de bord sur la boucle locale du serveur, cible du tunnel SSH.
ANALYTICS_LOCAL_PORT=3000
# Au-delà, les visites détaillées sont effacées ; les totaux restent.
ANALYTICS_RETENTION_DAYS=365

# --- Suivi des erreurs (facultatif) ----------------------------------------------------------------
# Les erreurs du serveur (pas les 404), avec leur pile, envoyées à Sentry ou à GlitchTip (même protocole) :
# le DSN est donné par le projet créé dans l'un ou l'autre. Rien qui désigne un utilisateur n'est envoyé
# (ni adresse IP, ni compte, ni contenu des formulaires). Vide : rien ne part.
# Vérification : docker compose exec app php bin/console app:sentry:essai
SENTRY_DSN=
# Nom sous lequel ranger les erreurs de cette instance.
SENTRY_ENVIRONMENT=production

# --- Votre marque (facultatif) ----------------------------------------------------------------------
# Sans rien, l'instance porte la marque du moteur (Forelse). Pour poser la vôtre : créez un dossier
# `marque/` à côté de ce fichier, avec un `marque.yaml` (nom, couleurs, images, textes de l'accueil) —
# copiez examples/marque/marque.yaml du dépôt comme point de départ. Un gabarit déposé dans
# `marque/templates/` remplace la page de même nom (voir README, « Habiller son instance »).
# Dès qu'un marque.yaml existe, plus rien de la marque du moteur n'est servi.
BRANDING_HOST_DIR=./marque

# Devis de cohorte (mode « établissement ») : prix par apprenant et par parcours, TTC, en centimes,
# puis barème dégressif « effectif:pourcentage ». Estimation : le devis signé se saisit dans /admin.
COHORT_UNIT_PRICE=3000
COHORT_TIERS=1:100,10:70,30:50

# --- Contenu ---------------------------------------------------------------------------------------

# Dossier des packs de contenu sur ce serveur, monté en lecture seule. Vide : pack de démonstration.
PACKS_DIR=./packs
# Dossier des archives à télécharger (facultatif), servi par /telechargements aux comptes connectés.
DOWNLOADS_HOST_DIR=./downloads
# Packs chargés, chemins DANS le conteneur séparés par des virgules. Ajoutez /app/examples/packs pour
# garder le parcours de démonstration à côté de vos packs.
CONTENT_PACKS_PATHS=/packs

# Environnements d'exécution installés depuis un dépôt Git, via /admin/environnements. Le volume
# « environnements » du compose les reçoit ; videz cette ligne pour désactiver la fonctionnalité —
# l'administration affiche alors la page sans formulaire, et seuls les environnements livrés avec le
# moteur sont disponibles.
# ATTENTION : empaqueter un environnement exécute le code du dépôt sur ce serveur (composer install et
# ses greffons). N'installez que des dépôts en qui vous avez confiance, comme un pack de contenu.
INSTALLED_ENVIRONMENTS_DIR=/environnements
# Hôtes acceptés pour ces dépôts, séparés par des virgules (ex. github.com,gitlab.com). Vide : tous.
ENVIRONMENT_SOURCES_ALLOWLIST=
# 1 : au démarrage, installer tout seul les environnements que vos packs déclarent et qui manquent
# (clé « environments » de leur pack.yaml). Le démarrage n'attend pas : l'installation tourne en fond.
# 0 (défaut) : rien ne s'installe sans un geste dans /admin → Environnements.
ENVIRONMENTS_AUTO_INSTALL=0

# --- Réseau ----------------------------------------------------------------------------------------
# Par défaut, le conteneur publie 80 et 443 et obtient seul ses certificats HTTPS (Let's Encrypt).
#
# Derrière un reverse proxy qui gère déjà le HTTPS (nginx, Traefik, Caddy…) :
#   SERVER_NAME=:80
#   SYMFONY_TRUSTED_PROXIES=private_ranges
#   HTTP_PORT=127.0.0.1:8080
#   HTTPS_PORT=127.0.0.1:8443
#
# Pour un essai sur votre poste, sans nom de domaine :
#   APP_URL=http://localhost:8080
#   SANDBOX_URL=http://127.0.0.1:8080
#   SERVER_NAME=:80
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
SERVER_NAME=
SYMFONY_TRUSTED_PROXIES=
HTTP_PORT=80
HTTPS_PORT=443

# --- Facultatif ------------------------------------------------------------------------------------

# Mentor de l'apprenant et génération assistée dans l'atelier des auteurs (clé d'API Anthropic).
# AI_MODEL_POST ne vaut que pour les brouillons de post LinkedIn ; vide, ils utilisent AI_MODEL.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MODEL_POST=

# Vente des parcours (Stripe Checkout + Stripe Tax). Vide : les parcours tarifés ne peuvent pas être achetés.
# Webhook à déclarer chez Stripe : <APP_URL>/paiement/stripe/webhook, événements checkout.session.completed,
# checkout.session.async_payment_succeeded (paiement), charge.refunded (remboursement fait depuis Stripe),
# charge.dispute.created et charge.dispute.closed (contestation bancaire).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_CODE=txcd_10000000
# Conditions générales de vente (/cgv) : médiateur de la consommation (obligatoire pour vendre à des
# particuliers en France) et garantie « satisfait ou remboursé » en jours (vide : pas de garantie).
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
LEGAL_REFUND_DAYS=

# Migrations de la base : jouées au démarrage de la plateforme (1). À 0, lancez-les vous-même à chaque mise à
# jour, avant `docker compose up` (commande dans le README, « Mettre à jour ») : une migration en échec laisse alors
# l'ancienne version en service.
MIGRATIONS_AT_STARTUP=1

# Secret de l'application. Vide : généré au premier démarrage et conservé dans le volume data.
APP_SECRET=
