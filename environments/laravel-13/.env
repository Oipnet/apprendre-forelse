# Environnement d'exécution des exercices : ce fichier est livré tel quel dans le navigateur.
# Rien ici n'est secret : l'application ne quitte jamais le bac à sable WebAssembly.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:tJOdHau9ChMniFIyP2BkT3t9jjDzAiQtE2RsOHNL4os=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Hachage rapide : PHP en WebAssembly est plus lent qu'en natif, et rien ici n'est un vrai mot de passe.
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# La base de l'aperçu (database/database.sqlite) vit en mémoire et repart de zéro à chaque chargement.
DB_CONNECTION=sqlite

# Pas de base pour les sessions ni le cache : des fichiers, dans storage/, sans migration préalable.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="bonjour@example.com"
MAIL_FROM_NAME="${APP_NAME}"
