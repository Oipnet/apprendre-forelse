# APP_KEY : tirée au hasard par le runtime pour chaque projet (packages/runtime-goravel/src/project.ts).
APP_NAME=Goravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
