{{ define "welcome.tmpl" }}
<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ .name }}</title>
	<style>
		body { font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #f8fafc; color: #0f172a; }
		main { text-align: center; }
		h1 { font-size: 2.5rem; margin: 0 0 .5rem; }
		p { color: #475569; }
	</style>
</head>
<body>
	<main>
		<h1>{{ .name }}</h1>
		<p>Votre application Go tourne dans le navigateur.</p>
	</main>
</body>
</html>
{{ end }}
