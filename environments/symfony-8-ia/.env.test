GEMINI_API_KEY=test
MISTRAL_API_KEY=test
OPENAI_API_KEY=sk-test

# Le jeton du serveur MCP pendant les tests (exercice « Protéger le serveur »).
MCP_JETON=jeton-de-test-mcp-4f9c2a7e
