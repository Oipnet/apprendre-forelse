{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
    <h1>Connexion</h1>
    {% if erreur %}<div class="flash flash-error">{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</div>{% endif %}
    <form action="{{ path('app_connexion') }}{% if app.request.query.get('redirect') %}?redirect={{ app.request.query.get('redirect')|url_encode }}{% endif %}" method="post" class="pile">
        <label>E-mail <input type="email" name="email" value="{{ dernier_identifiant }}" required></label>
        <label>Mot de passe <input type="password" name="motDePasse" required></label>
        <label><input type="checkbox" name="souvenir" value="1"> Se souvenir de moi</label>
        <button class="btn">Se connecter</button>
    </form>
    <p><a href="{{ path('app_mot_de_passe_oublie') }}">Mot de passe oublié ?</a> ·
       <a href="{{ path('app_inscription') }}">Créer un compte</a></p>
{% endblock %}
