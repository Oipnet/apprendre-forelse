{% extends 'base.html.twig' %}
{% block title %}Mes commandes{% endblock %}
{% block body %}
    <h1>Mes commandes</h1>
    <table>
        <tr><th>Référence</th><th>Date</th><th>Statut</th><th>Total</th></tr>
        {% for commande in commandes %}
            <tr>
                <td><a href="{{ path('app_commande_afficher', {id: commande.id}) }}">{{ commande.reference }}</a></td>
                <td>{{ commande.creeLe|date('d/m/Y') }}</td>
                <td>{{ commande.statut }}</td>
                <td>{{ commande.total|prix }}</td>
            </tr>
        {% else %}
            <tr><td colspan="4">Aucune commande.</td></tr>
        {% endfor %}
    </table>
{% endblock %}
