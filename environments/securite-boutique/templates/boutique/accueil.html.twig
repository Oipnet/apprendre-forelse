{% extends 'base.html.twig' %}
{% block title %}Brasserie Lacombe — bières artisanales de la Drôme{% endblock %}
{% block body %}
    <h1>Nos bières artisanales</h1>
    <p>Brassées à Die, dans la Drôme, depuis 2011.</p>

    <div class="grille">
        {% for biere in bieres %}
            <div class="carte">
                <strong><a href="{{ path('app_biere', {slug: biere.slug}) }}">{{ biere.nom }}</a></strong>
                <span class="style">{{ biere.style }} · {{ biere.degre }}°</span>
                <span class="prix">{{ biere.prix|prix }}</span>
            </div>
        {% endfor %}
    </div>

    <h2>Derniers avis</h2>
    {# Les avis récents passent par le partiel _avis : la faille F3.1 y est, et sa
       correction (chapitre 3) profite du coup à l'accueil comme aux fiches. #}
    {% for avis in avis_recents %}
        {% include 'boutique/_avis.html.twig' %}
    {% endfor %}
{% endblock %}
