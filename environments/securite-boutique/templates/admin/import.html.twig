{% extends 'base.html.twig' %}
{% block title %}Import — admin{% endblock %}
{% block body %}
    {% include 'admin/_menu.html.twig' %}
    <h1>Import d'un catalogue fournisseur</h1>
    <form action="{{ path('app_admin_import') }}" method="get" class="pile">
        <label>URL du catalogue <input type="text" name="url" value="{{ url }}" style="min-width:420px"></label>
        <button class="btn">Importer</button>
    </form>
    {% if erreur %}<div class="flash flash-error">{{ erreur }}</div>{% endif %}
    {% if corps is not null %}
        <h2>Réponse</h2>
        <pre style="background:#fff;border:1px solid #e0d6c8;padding:12px;overflow:auto">{{ corps }}</pre>
    {% endif %}
{% endblock %}
