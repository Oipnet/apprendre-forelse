{% extends 'base.html.twig' %}
{% block title %}Étiquettes — admin{% endblock %}
{% block body %}
    {% include 'admin/_menu.html.twig' %}
    <h1>Étiquettes</h1>
    <form action="{{ path('app_admin_etiquettes') }}" method="post" enctype="multipart/form-data" class="pile">
        <label>Fichier (jpg, png) <input type="file" name="etiquette"></label>
        <button class="btn">Déposer</button>
    </form>
    <table>
        <tr><th>Nom</th><th>Type MIME</th><th>Déposé le</th><th>Chemin</th></tr>
        {% for e in etiquettes %}
            <tr>
                <td>{{ e.nomOriginal }}</td><td>{{ e.typeMime }}</td>
                <td>{{ e.deposeLe|date('d/m/Y H:i') }}</td>
                <td><a href="/uploads/etiquettes/{{ e.chemin }}">{{ e.chemin }}</a></td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
