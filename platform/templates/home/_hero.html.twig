{#
  @theme Point de surcharge : le bandeau d'accueil : promesse, appel à essayer, illustration (home.demo).
  Variables : tryUrl (string), tryPractice (bool : l'essai est un exercice de Pratique, sans compte), theme.home.demo (array|null).
#}
<section class="lp-hero">
    <div class="lp-wrap">
        <div class="lp-hero-grid">
            <div>
                <span class="lp-eyebrow">Apprendre à développer · sans vidéo, sans installation</span>
                <h1 class="lp-h1">Apprenez à développer <em>en codant</em>, directement dans votre navigateur.</h1>
                <p class="lp-lead">
                    Pas de vidéo, pas d'installation. Un vrai projet tourne dans votre navigateur : vous écrivez le code,
                    l'aperçu se met à jour, les tests valident vos objectifs.
                </p>
                <div class="lp-cta">
                    {% if tryPractice %}
                        <a class="lp-btn lg primary" href="{{ tryUrl }}">Essayer un exercice, sans compte <span class="lp-mono">→</span></a>
                        <span class="lp-muted">Le premier chapitre de chaque parcours est gratuit avec un compte.</span>
                    {% else %}
                        <a class="lp-btn lg primary" href="{{ tryUrl }}">Essayer le premier exercice <span class="lp-mono">→</span></a>
                        <span class="lp-muted">Gratuit : créez votre compte, vous codez en deux minutes.</span>
                    {% endif %}
                </div>
            </div>

            {% if theme.home.demo %}{{ include('home/_demo.html.twig', {demo: theme.home.demo}) }}{% endif %}
        </div>
        {% if theme.home.demo %}<p class="lp-hero-note">Le code à gauche, la page à droite : changez une ligne, l'aperçu se recharge, les tests vérifient.</p>{% endif %}
    </div>
</section>
