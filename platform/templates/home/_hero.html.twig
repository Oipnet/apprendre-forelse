{#
  @theme Point de surcharge : le bandeau d'accueil : promesse, appel à essayer, illustration (home.demo).
  Variables : tryUrl (string), tryPractice (bool : l'essai est un exercice de Pratique, sans compte), theme.home.demo (array|null).
#}
{% trans_default_domain 'accueil' %}
<section class="home-hero border-b border-line bg-bg-2">
    <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{{ theme.name }}</h1>
        {% if theme.tagline %}<p class="mt-3 max-w-2xl text-lg text-ink-muted">{{ theme.tagline }}</p>{% endif %}
        <p class="home-cta mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
            <a class="btn btn-primary" href="{{ tryUrl }}">{{ (tryPractice ? 'commun.essayer_pratique' : 'commun.essayer_parcours')|trans }} <span aria-hidden="true">→</span></a>
            <span class="text-sm text-ink-muted">{{ (tryPractice ? 'hero.gratuit_pratique' : 'hero.gratuit_parcours')|trans }}</span>
        </p>
        <p class="mt-4 flex flex-wrap gap-x-4 text-sm">
            <a href="{{ path('app_tracks') }}">{{ 'hero.parcours'|trans }}</a>
            <a href="{{ path('app_practice') }}">{{ 'hero.pratique'|trans }}</a>
            {% if blog.open %}<a href="{{ path('app_blog') }}">{{ 'hero.blog'|trans }}</a>{% endif %}
        </p>
        {% if theme.home.demo %}{{ include('home/_demo.html.twig', {demo: theme.home.demo}) }}{% endif %}
    </div>
</section>
