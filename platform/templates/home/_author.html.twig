{#
  @theme Point de surcharge : « Qui est derrière » (home.author du thème), et le lien vers le moteur open source.
  Variables : theme.home.author (array : eyebrow?, title, lead), self_hosting (App\Instance\SelfHostingPage). Obligatoire : le lien vers le code du moteur (AGPL).
#}
<section class="lp-section lined">
    <div class="lp-wrap lp-two top">
        <div>
            {% if theme.home.author.eyebrow is defined %}<span class="lp-eyebrow">{{ theme.home.author.eyebrow }}</span>{% endif %}
            <h2 class="lp-h2 sm">{{ theme.home.author.title }}</h2>
        </div>
        <p class="lp-lead">{{ theme.home.author.lead }} Le moteur de la plateforme est sous licence open source (AGPL) : son code est publié, pour le lire ou <a href="{{ self_hosting.enabled ? path('app_self_hosting') : constant('App\\Instance\\SelfHostingPage::REPOSITORY') }}">le faire tourner chez vous</a>.</p>
    </div>
</section>
