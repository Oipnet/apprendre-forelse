{#
  @theme Point de surcharge : la liste d'attente (bêta fermée) ou l'invitation à commencer.
  Variables : inviteOnly (bool), tryUrl (string), tryPractice (bool). Obligatoire en bêta fermée : le formulaire vers app_waitlist, son jeton CSRF (« submit ») et le champ piège « site ».
#}
{% trans_default_domain 'accueil' %}
<section class="home-signup border-t border-line bg-bg-2" id="liste-attente">
    <div class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6">
        {% if inviteOnly %}
            {% set state = app.request.query.get('liste') %}
            <h2 class="text-2xl font-semibold">{{ 'signup.attente.titre'|trans }}</h2>
            <p class="mt-3 text-ink-muted">{{ 'signup.attente.texte'|trans }}</p>
            {% if state == 'ok' %}
                <p class="waitlist-notice ok mt-4 rounded-md border border-success bg-success-bg px-4 py-3 text-success" role="status">{{ 'signup.attente.ok'|trans }}</p>
            {% else %}
                {% if state == 'invalide' %}<p class="waitlist-notice ko mt-4 rounded-md border border-danger bg-danger-bg px-4 py-3 text-danger" role="alert">{{ 'signup.attente.invalide'|trans }}</p>{% endif %}
                <form class="waitlist-form mt-4 flex flex-wrap gap-2" method="post" action="{{ path('app_waitlist') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    {# Piège à robots : un humain ne voit pas ce champ. #}
                    <input class="absolute -left-[9999px] h-px w-px opacity-0" type="text" name="site" tabindex="-1" autocomplete="off" aria-hidden="true">
                    <input class="field max-w-sm flex-1" type="email" name="email" required maxlength="180" placeholder="{{ 'signup.attente.exemple'|trans }}" aria-label="{{ 'signup.attente.adresse'|trans }}">
                    <button class="btn btn-primary" type="submit">{{ 'signup.attente.envoyer'|trans }}</button>
                </form>
                <p class="mt-3 text-sm text-ink-muted">{{ 'signup.attente.donnees'|trans({lien: path('app_privacy')})|raw }}</p>
            {% endif %}
        {% else %}
            <h2 class="text-2xl font-semibold">{{ 'signup.ouverte.titre'|trans }}</h2>
            <p class="mt-3 text-ink-muted">{{ 'signup.ouverte.texte'|trans }}</p>
            <p class="mt-6 flex flex-wrap gap-3">
                <a class="btn btn-primary" href="{{ tryUrl }}">{{ (tryPractice ? 'commun.essayer_pratique' : 'commun.essayer_parcours')|trans }} <span aria-hidden="true">→</span></a>
                <a class="btn" rel="nofollow" href="{{ path('app_register') }}">{{ 'signup.ouverte.creer_compte'|trans }}</a>
            </p>
        {% endif %}
    </div>
</section>
