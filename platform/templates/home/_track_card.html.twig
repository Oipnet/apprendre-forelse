{#
    @theme Point de surcharge.
    La fiche d'un parcours : titre, description, offre, chapitres et leurs notions. Accueil et catalogue (/parcours).
    Variables : item (voir HomePage::card), tabbed (onglets de l'accueil), inviteOnly, heading (h3 par défaut ; h2 au catalogue).
#}
{% trans_default_domain 'accueil' %}
{% set heading = heading ?? 'h3' %}
<article class="track-card rounded-lg border border-line bg-surface p-5"{% if tabbed %} id="lp-panel-{{ item.track.id }}" role="tabpanel" aria-labelledby="lp-tab-{{ item.track.id }}" tabindex="0"{% endif %}>
    <div class="flex flex-col gap-4 md:flex-row md:justify-between">
        <div class="md:max-w-xl">
            <div class="flex flex-wrap items-center gap-2">
                <{{ heading }} class="text-xl font-semibold"><a class="text-ink" href="{{ path('app_track', {trackId: item.track.id}) }}">{{ item.track.title }}</a></{{ heading }}>
                {% if inviteOnly %}<span class="rounded bg-bg-2 px-1.5 text-xs text-ink-muted">{{ 'track_card.beta'|trans }}</span>{% endif %}
                {% if item.language %}<span class="track-language rounded bg-bg-2 px-1.5 text-xs text-ink-muted">{{ ('track_card.langue.' ~ item.language)|trans }}</span>{% endif %}
            </div>
            <p class="mt-2 text-ink-muted">{{ item.track.description }}</p>
        </div>
        <div class="track-offer flex shrink-0 flex-col gap-1 text-sm md:items-end md:text-right">
            {% set trackDuration = track_duration(item.track) %}
            <span class="count text-ink-muted">{{ (trackDuration ? 'track_card.taille_duree' : 'track_card.taille')|trans({chapitres: item.chapters|length, exercices: item.exercises, duree: trackDuration ? trackDuration|duree : ''}) }}</span>
            {% set quote = item.offer.quote %}
            {# Prix et places restantes : seulement pour qui n'a pas encore tout le parcours. #}
            {% if item.offer.locked %}
                <span class="track-price">
                    {% if quote.discounted %}<s class="text-ink-muted" aria-label="{{ 'track_card.prix_normal'|trans }}">{{ quote.normalPrice|euros }}</s>{% endif %}
                    {{ 'track_card.prix'|trans({prix: quote.price|euros|e})|raw }}
                </span>
                {% if quote.founder %}
                    <span class="text-ink-muted">{{ ('track_card.fondateur.' ~ (quote.founderEndsAt ? 'date' : 'sans_date') ~ (quote.founderSeatsLeft is not null ? '_places' : ''))|trans({date: quote.founderEndsAt ? quote.founderEndsAt|format_date('short') : '', places: quote.founderSeatsLeft ?? 0}) }}</span>
                {% endif %}
            {% endif %}
            {% if item.offer.fullAccess and app.user %}
                <a class="btn mt-1" href="{{ path('app_track', {trackId: item.track.id}) }}">{{ 'track_card.continuer'|trans }} <span aria-hidden="true">→</span></a>
            {% elseif item.offer.purchasable %}
                <a class="btn btn-primary mt-1" href="{{ path('app_purchase', {trackId: item.track.id}) }}">{{ 'track_card.acheter'|trans }}</a>
            {% elseif item.offer.comingSoon %}
                <span class="text-ink-muted">{{ 'track_card.bientot'|trans }}</span>
            {% endif %}
            {% if item.tryUrl and not item.offer.fullAccess %}<span class="text-ink-muted">{{ 'track_card.premier_chapitre_gratuit'|trans }}</span>{% endif %}
        </div>
    </div>
    <ol class="track-chapters mt-5 divide-y divide-line border-t border-line">
        {% for row in item.chapters %}
            <li class="py-3">
                <div class="flex flex-wrap items-baseline gap-x-3">
                    <span class="font-mono text-sm text-ink-muted">{{ '%02d'|format(loop.index) }}</span>
                    <span class="font-medium">{{ row.chapter.title }}</span>
                    {% set freeRow = loop.first and item.tryUrl and not item.offer.fullAccess %}{% set chapterDuration = track_duration(item.track, row.chapter) %}<span class="ml-auto text-sm text-ink-muted">{{ ('track_card.chapitre.' ~ (freeRow ? 'gratuit' : 'normal') ~ (chapterDuration ? '_duree' : ''))|trans({exercices: row.exercises, duree: chapterDuration ? chapterDuration|duree : ''}) }}</span>
                </div>
                {% if row.concepts %}
                    <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
                        {%- for concept in row.concepts -%}
                            {%- set url = notion_url(concept) -%}
                            {%- if url %}<a class="rounded border border-line px-2 py-0.5" href="{{ url }}">{{ concept }}</a>{% else %}<span class="rounded border border-line px-2 py-0.5 text-ink-muted">{{ concept }}</span>{% endif -%}
                        {%- endfor -%}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</article>
