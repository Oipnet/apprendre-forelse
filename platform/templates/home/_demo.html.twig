{#
  @theme Point de surcharge. Variables : demo (home.demo de theme.yaml : files, code, preview, goals).
  Illustration du bandeau d'accueil : un exercice tel qu'il se présente (éditeur, aperçu, objectifs).
   Le contenu vient du thème de l'instance (theme.yaml, « home.demo ») : sans elle, pas d'illustration,
   et le bandeau occupe toute la largeur. #}
<figure class="home-demo mt-8 overflow-hidden rounded-lg border border-line bg-surface" data-demo aria-label="Un exercice : le code, l'aperçu de la page et les objectifs validés">
    <div class="flex flex-wrap items-center gap-2 border-b border-line px-3 py-2 text-xs text-ink-muted">
        {% for file in demo.files|default([]) %}
            <span class="rounded px-2 py-0.5{{ loop.first ? ' bg-bg-2 text-ink' : '' }}">{{ file }}</span>
        {% endfor %}
    </div>
<pre class="overflow-x-auto bg-dark p-4 font-mono text-sm text-dark-ink">{{ demo.code|default('')|raw }}</pre>
    <div class="grid gap-4 p-4 text-sm sm:grid-cols-2">
        <div>
            <p class="text-xs text-ink-muted">{{ demo.preview.url|default('localhost/') }}</p>
            <p class="font-medium">{{ demo.preview.name|default('') }}</p>
            <p>{{ demo.preview.label|default('') }} <strong>{{ demo.preview.value|default('') }}</strong></p>
            {% if demo.preview.row is defined %}
                <p class="flex justify-between"><span>{{ demo.preview.row[0] }}</span><span>{{ demo.preview.row[1] }}</span></p>
            {% endif %}
        </div>
        <div>
            <p class="text-xs text-ink-muted">Objectifs</p>
            <ul class="mt-1 space-y-1">
                {% for goal in demo.goals|default([]) %}
                    {# Le dernier objectif est celui qui se valide sous les yeux du visiteur (animé par un thème qui le souhaite). #}
                    <li{% if loop.last %} data-demo-goal{% endif %}><i class="not-italic" aria-hidden="true">{{ loop.last ? '○' : '✓' }}</i> {{ goal }}</li>
                {% endfor %}
            </ul>
            {% if demo.goals|default([])|length %}
                <p class="mt-2 text-ink-muted"><span data-demo-score>{{ demo.goals|length - 1 }} / {{ demo.goals|length }} validés</span> <span data-demo-xp>+ 100 XP</span></p>
            {% endif %}
        </div>
    </div>
</figure>
