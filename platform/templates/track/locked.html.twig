{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{% block title %}{{ chapter.title }} · {{ track.title }} · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <p class="text-sm"><a href="{{ path('app_track', {trackId: track.id}) }}">← {{ track.title }}</a></p>
        <h1 class="mt-2 text-3xl font-semibold">{{ chapter.title }}</h1>
        {% if not offer.locked %}
            <p class="lead mt-3 text-lg text-ink-muted">{{ 'commun.chapitre_ferme'|trans }}</p>
        {% else %}
            <p class="lead mt-3 text-lg text-ink-muted">{{ (offer.comingSoon ? 'track.locked.acces_bientot' : 'track.locked.acces')|trans }}</p>
            <p class="mt-3">{{ 'commun.progression_conservee'|trans }}</p>
            {{ include('track/_price.html.twig') }}
        {% endif %}
    </main>
{% endblock %}
