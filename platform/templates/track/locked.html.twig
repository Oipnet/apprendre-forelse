{% extends 'base.html.twig' %}

{% block title %}{{ chapter.title }} · {{ track.title }} · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <p class="text-sm"><a href="{{ path('app_track', {trackId: track.id}) }}">← {{ track.title }}</a></p>
        <h1 class="mt-2 text-3xl font-semibold">{{ chapter.title }}</h1>
        {% if not offer.locked %}
            <p class="lead mt-3 text-lg text-ink-muted">Ce chapitre ne vous est pas ouvert pour l'instant.</p>
        {% else %}
            <p class="lead mt-3 text-lg text-ink-muted">Ce chapitre fait partie du parcours complet. Le premier chapitre est gratuit ; la suite demande un accès au parcours{{ offer.comingSoon ? ', dont l\'achat sera bientôt disponible' }}.</p>
            <p class="mt-3">Votre progression est conservée : si vous avez déjà travaillé ici, vous reprendrez exactement où vous en étiez.</p>
            {{ include('track/_price.html.twig') }}
        {% endif %}
    </main>
{% endblock %}
