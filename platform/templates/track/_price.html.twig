{#
  Prix d'un parcours et bouton « Acheter » ou « Continuer ». Variables : track, offer (TrackOffer), continueUrl (facultatif).
  Montants toujours formatés en euros, TTC. price-box et price sont des repères, sans style.
#}
{% trans_default_domain 'apprentissage' %}
{% set quote = offer.quote %}
<div class="price-box mt-4 space-y-2 rounded-lg border border-line bg-surface p-4">
    {% if quote.free %}
        <p class="price"><strong>{{ 'commun.gratuit'|trans }}</strong></p>
        {% if continueUrl is defined and continueUrl %}<a class="btn btn-primary" href="{{ continueUrl }}">{{ 'track.price.continuer'|trans }}</a>{% endif %}
    {% elseif offer.fullAccess %}
        <p class="price text-ink-muted">{{ 'track.price.acces_complet'|trans }}</p>
        {% if continueUrl is defined and continueUrl %}<a class="btn btn-primary" href="{{ continueUrl }}">{{ 'track.price.continuer'|trans }}</a>{% endif %}
    {% else %}
        <p class="price text-lg">
            {% if quote.discounted %}<s class="text-ink-muted" aria-label="{{ 'track.price.prix_normal'|trans }}">{{ quote.normalPrice|euros }}</s>{% endif %}
            <strong>{{ quote.price|euros }}</strong> <span class="text-sm text-ink-muted">{{ 'track.price.ttc'|trans }}</span>
        </p>
        {% if quote.founder %}
            <p class="text-sm text-ink-muted">
                {% set founder = quote.founderEndsAt ? (quote.founderSeatsLeft is not null ? 'fondateur_date_places' : 'fondateur_date') : (quote.founderSeatsLeft is not null ? 'fondateur_places' : 'fondateur') -%}
                {{ ('track.price.' ~ founder)|trans({date: quote.founderEndsAt ? quote.founderEndsAt|format_date('short'), n: quote.founderSeatsLeft}) }}
            </p>
        {% elseif quote.cohort %}
            <p class="text-sm text-ink-muted">{{ 'track.price.cohorte'|trans({cohorte: quote.cohort.name}) }}</p>
        {% endif %}
        {% if offer.purchasable %}
            <a class="btn btn-primary" href="{{ path('app_purchase', {trackId: track.id}) }}">{{ 'track.price.acheter'|trans }}</a>
        {% else %}
            {# Paiement pas encore configuré sur l'instance : le prix s'affiche, l'achat viendra. #}
            <span class="btn cursor-default opacity-60" aria-disabled="true">{{ 'track.price.bientot_disponible'|trans }}</span>
        {% endif %}
        <p class="text-sm text-ink-muted">{{ 'track.price.premier_chapitre'|trans }}</p>
    {% endif %}
</div>
