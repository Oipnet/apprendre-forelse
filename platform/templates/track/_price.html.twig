{#
  Prix d'un parcours et bouton « Acheter » ou « Continuer ». Variables : track, offer (TrackOffer), continueUrl (facultatif).
  Montants toujours formatés en euros, TTC. price-box et price sont des repères, sans style.
#}
{% set quote = offer.quote %}
<div class="price-box mt-4 space-y-2 rounded-lg border border-line bg-surface p-4">
    {% if quote.free %}
        <p class="price"><strong>Gratuit</strong></p>
        {% if continueUrl is defined and continueUrl %}<a class="btn btn-primary" href="{{ continueUrl }}">Continuer →</a>{% endif %}
    {% elseif offer.fullAccess %}
        <p class="price text-ink-muted">Vous avez accès à tout le parcours.</p>
        {% if continueUrl is defined and continueUrl %}<a class="btn btn-primary" href="{{ continueUrl }}">Continuer →</a>{% endif %}
    {% else %}
        <p class="price text-lg">
            {% if quote.discounted %}<s class="text-ink-muted" aria-label="Prix normal">{{ quote.normalPrice|euros }}</s>{% endif %}
            <strong>{{ quote.price|euros }}</strong> <span class="text-sm text-ink-muted">TTC, accès à vie</span>
        </p>
        {% if quote.founder %}
            <p class="text-sm text-ink-muted">
                Prix fondateur
                {%- if quote.founderEndsAt %} jusqu'au {{ quote.founderEndsAt|date('d/m/Y') }}{% endif %}
                {%- if quote.founderSeatsLeft is not null %}{{ quote.founderEndsAt ? ',' : '' }} encore {{ quote.founderSeatsLeft }} place{{ quote.founderSeatsLeft > 1 ? 's' }}{% endif %}.
            </p>
        {% elseif quote.cohort %}
            <p class="text-sm text-ink-muted">Tarif de votre cohorte « {{ quote.cohort.name }} ».</p>
        {% endif %}
        {% if offer.purchasable %}
            <a class="btn btn-primary" href="{{ path('app_purchase', {trackId: track.id}) }}">Acheter le parcours</a>
        {% else %}
            {# Paiement pas encore configuré sur l'instance : le prix s'affiche, l'achat viendra. #}
            <span class="btn cursor-default opacity-60" aria-disabled="true">Bientôt disponible</span>
        {% endif %}
        <p class="text-sm text-ink-muted">Premier chapitre gratuit avec un compte.</p>
    {% endif %}
</div>
