{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{# Le catalogue : tous les parcours publiés, avec les mêmes fiches que l'accueil (home/_track_card.html.twig).
   Le filtre par framework est une suite de liens : il marche sans JavaScript. #}
{% block body %}
    <main class="tracks-catalogue mx-auto w-full max-w-5xl px-4 py-10 sm:px-6">
        <h1 class="text-3xl font-semibold">{{ 'track.index.titre'|trans }}</h1>
        <p class="mt-3 max-w-2xl text-ink-muted">{{ 'track.index.intro'|trans }}</p>

        {% if frameworks|length > 1 %}
            <nav class="catalogue-filters mt-6 flex flex-wrap gap-2 text-sm" aria-label="{{ 'track.index.filtrer'|trans }}">
                <a class="rounded-full border px-3 py-1 {{ framework is null ? 'border-accent bg-accent text-on-accent hover:text-on-accent' : 'border-line' }}" href="{{ path('app_tracks') }}"{% if framework is null %} aria-current="page"{% endif %}>{{ 'commun.tous'|trans }}</a>
                {% for id, label in frameworks %}
                    <a class="rounded-full border px-3 py-1 {{ framework == id ? 'border-accent bg-accent text-on-accent hover:text-on-accent' : 'border-line' }}" href="{{ path('app_tracks', {framework: id}) }}"{% if framework == id %} aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        <div class="home-tracks mt-8 space-y-6">
            {% for item in tracks %}
                {{ include('home/_track_card.html.twig', {tabbed: false, heading: 'h2'}) }}
            {% else %}
                <p class="text-ink-muted">{{ 'track.index.aucun'|trans }}</p>
            {% endfor %}
        </div>

        {% if upcoming %}
            <div class="home-upcoming mt-10">
                <h2 class="text-lg font-semibold">{{ 'commun.en_preparation'|trans }}</h2>
                <ul class="mt-3 space-y-3">
                    {% for track in upcoming %}
                        <li>
                            <span class="font-medium">{{ track.title }}</span> <span class="rounded bg-bg-2 px-1.5 text-xs text-ink-muted">{{ 'commun.bientot'|trans }}</span>
                            <p class="text-sm text-ink-muted">{{ track.description }}</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <p class="mt-10 text-ink-muted">{{ 'track.index.pratique'|trans({url: path('app_practice')|e})|raw }}</p>
    </main>
{% endblock %}
