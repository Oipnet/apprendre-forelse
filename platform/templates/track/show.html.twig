{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{% block body %}
    {% set trackDuration = track_duration(track) %}
    {% set done = total and completed == total %}
    {% set openChapter = app.user and current ? current.chapter : 1 %}
    {% set bossEveryChapter = chapters|length > 0 and chapters|filter(c => c.items is not empty and (c.items|last).boss)|length == chapters|length %}
    {% set hasLessons = chapters|filter(c => c.lesson)|length > 0 %}
    {# Repères sans style, lus par les tests et le script du moteur : tr-chapter (« Tout ouvrir »), tr-chapter-meta, track-done,
       track-certificate, track-duration, next-track, track-about, tr-chapter-description, exercises, lesson-link. #}
    <main class="track mx-auto w-full max-w-5xl px-4 py-10 sm:px-6">
        <section class="flex flex-col gap-6 border-b border-line pb-8 md:flex-row md:justify-between">
            <div class="md:max-w-2xl">
                <p class="text-sm text-ink-muted">{{ pack.title }}</p>
                <h1 class="mt-1 text-3xl font-semibold">{{ track.title }}</h1>
                <p class="lead mt-3 text-lg text-ink-muted">{{ track.description }}</p>
                <p class="track-duration mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-muted">
                    <span>{{ (app.user ? 'track.show.exercices_reussis' : 'commun.exercices')|trans({fait: completed, n: total}) }}</span>
                    <span>{{ 'track.show.chapitres'|trans({n: chapters|length}) }}</span>
                    <span>{{ (app.user ? 'track.show.xp_gagnes' : 'commun.xp')|trans({gagne: xpEarned|nombre, xp: xpTotal|nombre}) }}</span>
                    {% if trackDuration %}<span>{{ 'track.show.duree'|trans({duree: trackDuration|duree}) }}</span>{% endif %}
                </p>
                {% if app.user %}
                    <div class="mt-3 h-2 overflow-hidden rounded-full bg-bg-2" aria-hidden="true"><div class="h-full bg-accent" style="width: {{ total ? (completed / total * 100)|round(1) : 0 }}%"></div></div>
                {% endif %}
            </div>

            <div class="md:w-72">
                {% if done %}
                    <div class="track-done space-y-2 rounded-lg border border-success bg-success-bg p-4">
                        <p class="text-sm text-success">{{ 'commun.parcours_termine'|trans }}</p>
                        <p><strong>{{ 'track.show.bravo'|trans }}</strong></p>
                        {% if certificate %}
                            <a class="track-certificate btn btn-primary w-full" href="{{ path('app_certificate', {code: certificate.code}) }}">{{ 'track.show.voir_certificat'|trans }}</a>
                            {{ include('share/_buttons.html.twig', {links: certificateShare, title: 'track.show.partager'|trans, mesure: {parcours: track.id}}) }}
                        {% elseif offer.fullAccess %}
                            <a class="track-certificate btn btn-primary w-full" href="{{ path('app_certificate_claim', {trackId: track.id}) }}">{{ 'track.show.obtenir_certificat'|trans }}</a>
                        {% endif %}
                        {% if booklet %}
                            <a class="btn w-full" href="{{ path('app_track_booklet', {trackId: track.id}) }}">{{ 'track.show.livret'|trans }}</a>
                        {% endif %}
                        {% if nextTrack %}
                            <a class="btn btn-primary w-full" href="{{ path('app_track', {trackId: nextTrack.id}) }}">{{ 'track.show.continuer_avec'|trans({titre: nextTrack.title}) }} <span aria-hidden="true">→</span></a>
                        {% endif %}
                    </div>
                {% elseif current %}
                    <div class="space-y-1 rounded-lg border border-line bg-surface p-4">
                        <p class="text-sm text-ink-muted">{{ (app.user and started ? 'track.show.vous_en_etes_la' : 'track.show.pour_commencer')|trans }}</p>
                        <p class="text-sm">{{ 'track.show.position'|trans({chapitre: current.chapter, position: current.position}) }}</p>
                        <p class="font-medium">{{ current.exercise.title }}</p>
                        <a class="btn btn-primary mt-2 w-full" href="{{ path('app_exercise', {trackId: track.id, exerciseId: current.exercise.id}) }}">{{ (app.user and started ? 'commun.reprendre' : 'track.show.commencer')|trans }} <span aria-hidden="true">→</span></a>
                    </div>
                {% endif %}
                {{ include('track/_price.html.twig', {continueUrl: null}) }}
                {% if defense %}{{ include('track/_defense.html.twig') }}{% endif %}
            </div>
        </section>

        <div class="mt-8 grid gap-8 md:grid-cols-[14rem_1fr]">
            <aside class="text-sm">
                <nav class="md:sticky md:top-4" aria-label="{{ 'track.show.chapitres_du_parcours'|trans }}">
                    <div class="flex items-center justify-between">
                        <span class="font-semibold">{{ 'track.show.chapitres_titre'|trans }}</span>
                        <button type="button" class="cursor-pointer text-accent" data-chapters-toggle hidden>{{ 'track.show.tout_ouvrir'|trans }}</button>
                    </div>
                    <ol class="mt-2 space-y-1">
                        {% for item in chapters %}
                            <li><a class="flex gap-2" href="#chapitre-{{ item.number }}" data-open-chapter="chapitre-{{ item.number }}">
                                <span class="font-mono text-ink-muted">{{ '%02d'|format(item.number) }}</span>
                                <span class="flex-1">{{ item.chapter.title }}</span>
                                <span class="text-ink-muted">{{ item.items|length }}</span>
                            </a></li>
                        {% endfor %}
                    </ol>
                    {% if bossEveryChapter or hasLessons %}
                        <p class="mt-4 text-ink-muted">
                            {%- if bossEveryChapter %}{{ (hasLessons ? 'track.show.boss_fiche' : 'track.show.boss')|trans }}{% else %}{{ 'track.show.fiche_debloquee'|trans }}{% endif %}
                            {%- if hasLessons %} {{ 'track.show.livret_final'|trans }}{% endif -%}
                        </p>
                    {% endif %}
                </nav>
            </aside>

            <div class="space-y-4">
                {% for item in chapters %}
                    {% set chapterDuration = track_duration(track, item.chapter) %}
                    {% set chapterDone = item.items|filter(e => e.state == 'completed')|length %}
                    <section class="chapter{{ item.locked ? ' locked' }} scroll-mt-4" id="chapitre-{{ item.number }}">
                        <details class="tr-chapter group rounded-lg border border-line bg-surface"{% if item.number == openChapter %} open{% endif %}>
                            <summary class="flex cursor-pointer list-none items-start gap-3 p-4">
                                <span class="font-mono text-ink-muted">{{ '%02d'|format(item.number) }}</span>
                                <span class="flex-1">
                                    <h2 class="text-lg font-semibold">
                                        {{ item.chapter.title }}
                                        {% if item.free and not offer.fullAccess %}<span class="tag free ml-1 rounded bg-success-bg px-1.5 text-xs font-normal text-success">{{ 'commun.gratuit'|trans }}</span>{% elseif item.locked %}<span class="tag ml-1 rounded bg-bg-2 px-1.5 text-xs font-normal text-ink-muted">{{ 'track.show.parcours_complet'|trans }}</span>{% endif %}
                                    </h2>
                                    <span class="tr-chapter-meta text-sm text-ink-muted">
                                        {{- (app.user ? 'track.show.exercices_faits' : 'commun.exercices')|trans({fait: chapterDone, n: item.items|length}) }} · {{ 'commun.xp'|trans({xp: item.xp|nombre}) }}
                                        {%- if chapterDuration %} · ≈ {{ chapterDuration|duree }}{% endif %}
                                        {%- if item.lesson %} · {{ 'track.show.fiche_de_cours'|trans }}{% endif -%}
                                    </span>
                                    {% if item.chapter.description %}<span class="tr-chapter-description mt-1 block text-sm">{{ item.chapter.description }}</span>{% endif %}
                                </span>
                                <span class="text-ink-muted transition group-open:rotate-180" aria-hidden="true">▾</span>
                            </summary>
                            <ol class="exercises divide-y divide-line border-t border-line">
                                {% for entry in item.items %}
                                    <li data-state="{{ entry.state }}"{% if entry.boss %} class="boss"{% endif %}>
                                        <a class="group/ex relative flex items-baseline gap-3 px-4 py-2 text-ink hover:bg-bg-2 hover:text-ink" href="{{ path('app_exercise', {trackId: track.id, exerciseId: entry.exercise.id}) }}"{% if entry.exercise.concepts %} aria-describedby="notions-{{ entry.exercise.id }}"{% endif %}>
                                            <span class="state w-6 text-center font-mono text-sm {{ entry.state == 'completed' ? 'text-success' : 'text-ink-muted' }}"><span aria-hidden="true">{{ entry.state == 'completed' ? '✓' : (entry.boss ? '★' : loop.index) }}</span><span class="sr-only">{{ (entry.state == 'completed' ? 'track.show.sr_reussi' : (entry.boss ? 'track.show.sr_final' : 'track.show.sr_exercice'))|trans({numero: loop.index}) }}</span></span>
                                            <span class="title flex-1{{ entry.boss ? ' font-semibold' }}">{{ entry.exercise.title }}</span>
                                            <span class="meta text-sm text-ink-muted">{% if entry.exercise.duration and entry.state != 'completed' %}{{ entry.exercise.duration|duree }} · {% endif %}{{ 'commun.xp'|trans({xp: entry.state == 'completed' ? '+' ~ entry.xpEarned : entry.exercise.xp}) }}</span>
                                            {% if entry.exercise.concepts %}
                                                {# Infobulle des notions abordées : au survol ou au focus clavier du lien #}
                                                <span class="hint invisible absolute left-12 top-full z-10 mt-1 flex max-w-sm flex-wrap gap-1 rounded-md border border-line bg-surface p-2 text-xs shadow group-hover/ex:visible group-focus/ex:visible" role="tooltip" id="notions-{{ entry.exercise.id }}">
                                                    <span class="hint-label w-full text-ink-muted">{{ 'track.show.notions_abordees'|trans }}</span>
                                                    {% for concept in entry.exercise.concepts %}<span class="tag rounded border border-line px-1.5">{{ concept }}</span>{% endfor %}
                                                </span>
                                            {% endif %}
                                        </a>
                                    </li>
                                {% endfor %}
                                {% if item.lesson %}
                                    <li>
                                        {% if item.lesson.unlocked %}
                                            <a class="lesson-link flex items-baseline gap-3 px-4 py-2" href="{{ path('app_chapter', {trackId: track.id, chapterId: item.chapter.id}) }}">
                                                <span class="state w-6 text-center" aria-hidden="true">▤</span>
                                                <span class="title flex-1">{{ 'track.show.fiche_chapitre'|trans }}</span>
                                                <span class="meta text-sm">{{ 'track.show.lire'|trans }}</span>
                                            </a>
                                        {% else %}
                                            <p class="lesson-link locked flex items-baseline gap-3 px-4 py-2 text-ink-muted">
                                                <span class="state w-6 text-center" aria-hidden="true">🔒</span>
                                                <span class="title flex-1">{{ 'track.show.fiche_chapitre'|trans }}</span>
                                                <span class="meta text-sm">{{ (app.user ? 'track.show.fiche_reste' : 'track.show.fiche_a_reussir')|trans({n: item.lesson.remaining}) }}</span>
                                            </p>
                                        {% endif %}
                                    </li>
                                {% endif %}
                            </ol>
                        </details>
                        {# Hors du <details> : le sommaire reste atteignable chapitre replié, pour un visiteur comme pour un robot. #}
                        <p class="mt-1 text-right text-sm"><a href="{{ path('app_chapter_summary', {trackId: track.id, chapterId: item.chapter.id}) }}">{{ 'track.show.sommaire_chapitre'|trans({numero: item.number}) }}</a></p>
                    </section>
                {% endfor %}

                {% if aboutHtml %}
                    {# La présentation du parcours (about.md) : ce qu'on y apprend, pour qui, avec quels prérequis. #}
                    <section class="track-about prose prose-theme mt-8 max-w-none">{{ aboutHtml|raw }}</section>
                {% endif %}

                {% if nextTrack and not done %}
                    <section class="next-track mt-8 rounded-lg border border-line bg-bg-2 p-5">
                        <p class="text-sm text-ink-muted">{{ 'track.show.et_ensuite'|trans }}</p>
                        <h2 class="mt-1 text-xl font-semibold"><a href="{{ path('app_track', {trackId: nextTrack.id}) }}">{{ nextTrack.title }} →</a></h2>
                        <p class="mt-2 text-ink-muted">{{ nextTrack.description }}</p>
                    </section>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
