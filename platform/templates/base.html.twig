<!DOCTYPE html>
{# Les feuilles, scripts et polices du thème (theme.yaml). La page d'exercice et les éditeurs de l'atelier les
   refusent en posant « theme_assets = false » : ils ont leur propre habillage (voir #235). #}
{% set theme_assets = theme_assets ?? true %}
{# data-theme="auto" : les pages du site suivent le thème du système (voir le thème sombre de site.css). #}
<html lang="fr"{% if theme.followsSystemTheme %} data-theme="auto"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Pages publiques : balises remplies par App\Seo\Page ou l'attribut #[Seo] de l'action. Les autres gardent leur bloc title. #}
        <title>{% if seo.title %}{{ seo.title }}{% else %}{% block title %}{{ theme.title }}{% endblock %}{% endif %}</title>
        {% if seo.description -%}
            <meta name="description" content="{{ seo.description }}">
        {% endif -%}
        {% block robots %}{% if seo.robots %}<meta name="robots" content="{{ seo.robots }}">{% endif %}{% endblock %}
        {% if seo.canonical -%}
            <link rel="canonical" href="{{ seo.canonical }}">
            <meta property="og:type" content="{{ seo.type }}">
            <meta property="og:site_name" content="{{ theme.name }}">
            <meta property="og:locale" content="fr_FR">
            <meta property="og:url" content="{{ seo.canonical }}">
            <meta property="og:title" content="{{ seo.title }}">
            {% if seo.description %}<meta property="og:description" content="{{ seo.description }}">{% endif %}
            {% if seo.image -%}
                <meta property="og:image" content="{{ seo.image }}">
            {%- elseif theme.shareUrl -%}
                <meta property="og:image" content="{{ absolute_url(theme.shareUrl) }}">
                <meta property="og:image:width" content="1200">
                <meta property="og:image:height" content="630">
            {%- endif %}
            {% if seo.image or theme.shareUrl -%}
                <meta property="og:image:alt" content="{{ seo.imageAlt ?? (theme.name ~ ' : ' ~ theme.tagline) }}">
                <meta name="twitter:card" content="summary_large_image">
            {%- else -%}
                {# Sans image, X affiche quand même une carte : titre et description. #}
                <meta name="twitter:card" content="summary">
            {% endif -%}
        {% endif -%}
        {% for data in seo.structuredData -%}
            <script type="application/ld+json">{{ data|json_ld }}</script>
        {% endfor -%}
        {%- if theme.iconUrl %}
        <link rel="icon" type="image/svg+xml" href="{{ theme.iconUrl }}">
        {%- if not theme.default %}<link rel="apple-touch-icon" href="{{ theme.iconUrl }}">{% endif %}
        {%- elseif not theme.default %}
        {# Sans icône déclarée, le navigateur irait chercher /favicon.ico — celle du moteur. Une icône
           vide vaut mieux que la marque de quelqu'un d'autre dans l'onglet. #}
        <link rel="icon" href="data:,">
        {%- endif %}
        {%- if theme.default %}
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('img/favicon-32.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('img/apple-touch-icon.png') }}">
        {%- endif %}
        {% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
        {%- if analytics.enabled %}
        {# Mesure d'audience : pages vues et référents, sans cookie ni visiteur identifié (voir /confidentialite).
           Le script vient du domaine du site, pas d'un tiers. Absent du bac à sable, qui n'hérite pas de ce gabarit. #}
        <script defer src="{{ analytics.scriptUrl }}" data-website-id="{{ analytics.websiteId }}"></script>
        {%- endif %}
        {# Les polices du haut de page, annoncées avant la feuille de styles qui les nomme (voir FontPreloadExtension). #}
        {% block font_preloads %}{% for url in font_preloads() -%}
            <link rel="preload" href="{{ url }}" as="font" type="font/woff2" crossorigin>
        {% endfor %}{% endblock %}
        {%- if theme_assets %}{% for url in theme.preloadUrls %}
        <link rel="preload" href="{{ url }}" as="font" type="font/woff2" crossorigin>
        {%- endfor %}{% endif %}
        {% block stylesheets %}
            {# Un thème qui remplace la feuille du moteur (replaces_engine_styles) en fournit une : voir plus bas. #}
            {% if not (theme_assets and theme.replacesEngineStyles) %}{{ vite_entry_link_tags('site') }}{% endif %}
        {% endblock %}
        {% block javascripts %}
            {{ vite_entry_script_tags('site') }}
        {% endblock %}
        {# Les couleurs et polices de l'instance, après la feuille de styles pour l'emporter sur elle. #}
        {%- if theme.styles %}
        <style>{{ theme.styles|raw }}</style>
        {%- endif %}
        {#- Les feuilles et scripts du thème, en dernier : ils l'emportent sur ceux du moteur, et ne les remplacent pas
            (sauf la feuille, quand le thème le déclare). Servis par ce domaine : la CSP n'a rien à ouvrir. #}
        {%- if theme_assets %}
        {%- for url in theme.stylesheetUrls %}
        <link rel="stylesheet" href="{{ url }}">
        {%- endfor %}
        {%- for url in theme.scriptUrls %}
        <script type="module" src="{{ url }}"></script>
        {%- endfor %}
        {%- endif %}
    </head>
    {# data-import-url : la progression d'invité est remontée au compte après connexion (voir site.ts). #}
    <body class="{% block body_class %}site-page{% endblock %}"{% if app.user %} data-import-url="{{ path('api_progress_import') }}"{% endif %}>
    {# Le lien « Connexion » ramène à la page courante (voir SecurityController::login), sauf depuis l'accueil, les pages de compte et d'erreur. #}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set login_suite = current_route is null or current_route in ['app_home', 'app_login', 'app_register'] ? null : app.request.pathInfo %}
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {% if theme.preview %}{{ include('_theme_preview.html.twig') }}{% endif %}
        {% block header %}
            <header class="lp-header">
                <div class="lp-wrap">
                    <a class="lp-brand" href="{{ path('app_home') }}">
                        {% if theme.logoUrl %}<img src="{{ theme.logoUrl }}" alt="" width="72" height="84">{% endif %}
                        <span class="lp-serif">{{ theme.name }}</span>
                        {%- set chip %}{% block brand_chip %}{{ theme.chip }}{% endblock %}{% endset -%}
                        {% if chip|trim %}<span class="lp-chip">{{ chip }}</span>{% endif %}
                    </a>
                    <nav aria-label="Navigation principale">
                        <a href="{{ path('app_tracks') }}">Parcours</a>
                        <a href="{{ path('app_practice') }}">Pratique</a>
                        {% if blog.open %}<a href="{{ path('app_blog') }}">Blog</a>{% endif %}
                        <a href="{{ path('app_home') }}#questions">Questions</a>
                        {% if app.user %}
                            {# Tout ce qui concerne le compte et les espaces réservés, derrière le nom : sans JS, <details> s'ouvre et se ferme seul. #}
                            <details class="lp-account" data-account-menu>
                                <summary aria-label="Menu du compte de {{ app.user.displayName }}">
                                    <span class="lp-user">{{ app.user.displayName }}</span>
                                    <span class="lp-xp">{{ app.user.xp }} XP</span>
                                    <span class="lp-account-caret" aria-hidden="true"></span>
                                </summary>
                                <div class="lp-account-menu">
                                    <a href="{{ path('app_account') }}">Mon compte</a>
                                    {% if is_granted('ROLE_AUTEUR') or is_granted('ROLE_CHEF_COHORTE') %}
                                        <p class="lp-account-label">Espaces</p>
                                        {% if is_granted('ROLE_AUTEUR') %}<a href="{{ path('app_studio') }}">Atelier</a>{% endif %}
                                        {% if is_granted('ROLE_CHEF_COHORTE') %}<a href="{{ path('chef') }}">Mes cohortes</a>{% endif %}
                                        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Administration</a>{% endif %}
                                    {% endif %}
                                    <a class="lp-account-logout" href="{{ logout_path() }}">Déconnexion</a>
                                </div>
                            </details>
                        {% else %}
                            <a href="{{ path('app_login', {suite: login_suite}) }}">Connexion</a>
                            <a class="lp-btn" rel="nofollow" href="{{ path('app_register') }}">Créer un compte</a>
                        {% endif %}
                    </nav>
                </div>
                {# Avancée de lecture : le JS la pilote, elle reste à zéro sans lui. #}
                <div class="lp-progress" data-progress aria-hidden="true"></div>
            </header>
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
        {% endblock %}
        <div id="contenu" tabindex="-1"></div>
        {% block body %}{% endblock %}
        {% block footer %}{{ include('_footer.html.twig') }}{% endblock %}
    </body>
</html>
