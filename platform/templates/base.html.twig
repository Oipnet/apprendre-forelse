<!DOCTYPE html>
{#
  @theme Point de surcharge : la page de base de tout le site. Mieux vaut surcharger ses blocs depuis les pages, ou les
  gabarits qu'elle inclut (_header, _footer), que la remplacer : c'est elle qui pose les balises de référencement, la
  CSP, les fichiers du moteur et du thème.
  Blocs : title, robots, font_preloads, stylesheets, javascripts, body_class, header (et brand_chip), body, footer.
  Variables : theme (App\Theme\Theme), seo (App\Seo\PageSeo), blog, analytics, app.
#}
{# La page d'exercice et les éditeurs de l'atelier n'étendent pas cette page : voir editor_base.html.twig (#235). #}
{# data-theme="auto" : les pages du site suivent le thème du système (voir le thème sombre de theme-default.css). #}
<html lang="fr"{% if theme.followsSystemTheme %} data-theme="auto"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Pages publiques : balises remplies par App\Seo\Page ou l'attribut #[Seo] de l'action. Les autres gardent leur bloc title. #}
        <title>{% if seo.title %}{{ seo.title }}{% else %}{% block title %}{{ theme.title }}{% endblock %}{% endif %}</title>
        {{ include('_head.html.twig') }}
        {% block robots %}{% if seo.robots %}<meta name="robots" content="{{ seo.robots }}">{% endif %}{% endblock %}
        {# Le thème default n'a que les polices du système : rien à précharger. Les polices d'un thème : preload. #}
        {% block font_preloads %}{% endblock %}
        {%- for url in theme.preloadUrls %}
        <link rel="preload" href="{{ url }}" as="font" type="font/woff2" crossorigin>
        {%- endfor %}
        {% block stylesheets %}
            {# Un thème qui remplace la feuille du moteur (replaces_engine_styles) en fournit une : voir plus bas. #}
            {% if not theme.replacesEngineStyles %}{{ vite_entry_link_tags('theme') }}{% endif %}
        {% endblock %}
        {% block javascripts %}
            {{ vite_entry_script_tags('site') }}
        {% endblock %}
        {# Les couleurs et polices de l'instance, après la feuille de styles pour l'emporter sur elle. #}
        {%- if theme.styles %}
        <style>{{ theme.styles|raw }}</style>
        {%- endif %}
        {#- Les feuilles et scripts du thème, en dernier : ils l'emportent sur ceux du moteur, et ne les remplacent pas
            (sauf la feuille, quand le thème le déclare). Servis par ce domaine : la CSP n'a rien à ouvrir. #}
        {%- for url in theme.stylesheetUrls %}
        <link rel="stylesheet" href="{{ url }}">
        {%- endfor %}
        {%- for url in theme.scriptUrls %}
        <script type="module" src="{{ url }}"></script>
        {%- endfor %}
    </head>
    {# data-import-url : la progression d'invité est remontée au compte après connexion (voir site.ts). #}
    <body class="{% block body_class %}site-page{% endblock %}"{% if app.user %} data-import-url="{{ path('api_progress_import') }}"{% endif %}>
    {# Le lien « Connexion » ramène à la page courante (voir SecurityController::login), sauf depuis l'accueil, les pages de compte et d'erreur. #}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set login_suite = current_route is null or current_route in ['app_home', 'app_login', 'app_register'] ? null : app.request.pathInfo %}
        <a class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:shadow" href="#contenu">Aller au contenu</a>
        {% if theme.preview %}{{ include('_theme_preview.html.twig') }}{% endif %}
        {% block header %}
            {%- set brand_chip %}{% block brand_chip %}{{ theme.chip }}{% endblock %}{% endset -%}
            {{ include('_header.html.twig') }}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }} mx-auto mt-4 w-full max-w-5xl px-4 sm:px-6" role="status">
                        <p class="rounded-md border px-4 py-3 {{ type in ['error', 'danger'] ? 'border-danger bg-danger-bg text-danger' : (type == 'success' ? 'border-success bg-success-bg text-success' : 'border-line bg-bg-2 text-ink') }}">{{ message }}</p>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}
        <div id="contenu" tabindex="-1"></div>
        {% block body %}{% endblock %}
        {% block footer %}{{ include('_footer.html.twig') }}{% endblock %}
    </body>
</html>
