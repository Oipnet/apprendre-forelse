{% extends 'base.html.twig' %}

{% block body_class %}site-page practice-page{% endblock %}

{% block body %}
    {% import 'practice/_card.html.twig' as ui %}
    {% set hasFilters = filters.framework or filters.notions or filters.nouveautes or filters.recherche %}
    {% set filterCount = (filters.framework ? 1 : 0) + filters.notions|length + (filters.nouveautes ? 1 : 0) + (filters.recherche ? 1 : 0) %}
    <main class="pr">
        <div class="lp-wrap">
            <div class="pr-hero">
                <div class="pr-intro">
                    <p class="pr-eyebrow">Pratique</p>
                    <h1>Se servir d'une fonctionnalité, tout de suite</h1>
                    <p class="lead">De courts exercices, à part des parcours : un code écrit à l'ancienne, à réécrire avec la fonctionnalité. Souvent une nouveauté du framework, parfois un point précis qui mérite qu'on s'y arrête.</p>
                    {% if versions %}
                        <p class="pr-versions">
                            <span class="meta">Par version :</span>
                            {% for version in versions %}
                                <a class="pr-tab" href="{{ path('app_practice_version', {slug: version.slug}) }}">{{ version.label }} <span class="pr-tab-count">{{ version.exercises }}</span></a>
                            {% endfor %}
                        </p>
                    {% endif %}
                </div>
                <ul class="pr-kpis">
                    <li><span class="pr-kpi-value">{{ total }}</span><span class="pr-kpi-label">exercice{{ total > 1 ? 's' }}</span></li>
                    <li><span class="pr-kpi-value">{{ newCount }}</span><span class="pr-kpi-label">nouveauté{{ newCount > 1 ? 's' }}</span></li>
                    {% if app.user %}
                        <li><span class="pr-kpi-value">{{ completedCount }}</span><span class="pr-kpi-label">réussi{{ completedCount > 1 ? 's' }}</span></li>
                    {% endif %}
                </ul>
            </div>

            {% if total %}
                <div class="pr-layout">
                    {# Les filtres sont un formulaire GET : sans JavaScript, le bouton « Appliquer » les envoie ;
                       avec, site.ts le masque et chaque case soumet le formulaire toute seule. Le panneau se
                       replie sous 900 px, où il passerait sinon avant les exercices. #}
                    <aside class="pr-aside">
                        <form class="pr-card" method="get" action="{{ path('app_practice') }}" data-practice-filters>
                            <input type="hidden" name="tri" value="{{ filters.tri }}">
                            <details class="fold" data-fold open>
                                <summary>
                                    <span>Filtres</span>
                                    {% if filterCount %}<span class="fold-count">{{ filterCount }} actif{{ filterCount > 1 ? 's' }}</span>{% endif %}
                                    <span class="fold-sign" aria-hidden="true"></span>
                                </summary>
                                <div class="fold-body">
                                    <label class="pr-field">
                                        <span class="pr-legend">Rechercher</span>
                                        <input type="search" name="recherche" value="{{ filters.recherche }}" placeholder="chunkBy, mail, validation…" autocomplete="off">
                                    </label>

                                    <div class="pr-group" role="group" aria-labelledby="pr-lbl-framework">
                                        <span class="pr-legend" id="pr-lbl-framework">Framework</span>
                                        <div class="pr-chips">
                                            <label class="pr-pill">
                                                <input type="radio" name="framework" value=""{{ filters.framework is null ? ' checked' }}>
                                                <span>Tous</span>
                                            </label>
                                            {% for id, label in frameworks %}
                                                <label class="pr-pill">
                                                    <input type="radio" name="framework" value="{{ id }}"{{ filters.framework == id ? ' checked' }}>
                                                    <span>{{ label }}</span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    </div>

                                    <label class="pr-check">
                                        <input type="checkbox" name="nouveautes" value="1"{{ filters.nouveautes ? ' checked' }}>
                                        <span>
                                            <span class="pr-check-title">Nouveautés seulement</span>
                                            <span class="pr-check-hint">Sorties dans les dernières versions</span>
                                        </span>
                                    </label>

                                    {% if notionCounts %}
                                        {% set head = notionCounts|slice(0, 8) %}
                                        {% set rest = notionCounts|slice(8) %}
                                        <div class="pr-group" role="group" aria-labelledby="pr-lbl-notions">
                                            <p class="pr-group-head">
                                                <span class="pr-legend" id="pr-lbl-notions">Notions</span>
                                                {% if filters.notions %}<span class="pr-note">{{ filters.notions|length }} retenue{{ filters.notions|length > 1 ? 's' }}</span>{% endif %}
                                            </p>
                                            <div class="pr-chips">
                                                {% for notion, count in head %}
                                                    <label class="pr-chip">
                                                        <input type="checkbox" name="notions[]" value="{{ notion }}"{{ notion in filters.notions ? ' checked' }}>
                                                        <span>{{ notion }}<span class="pr-chip-count">{{ count }}</span></span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                            {% if rest %}
                                                <details class="pr-more"{{ filters.notions|filter(n => n in rest|keys)|length ? ' open' }}>
                                                    <summary><span class="pr-more-open">Voir les {{ rest|length }} autres</span><span class="pr-more-close">Voir moins</span></summary>
                                                    <div class="pr-chips">
                                                        {% for notion, count in rest %}
                                                            <label class="pr-chip">
                                                                <input type="checkbox" name="notions[]" value="{{ notion }}"{{ notion in filters.notions ? ' checked' }}>
                                                                <span>{{ notion }}<span class="pr-chip-count">{{ count }}</span></span>
                                                            </label>
                                                        {% endfor %}
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    <button type="submit" class="pr-apply">Appliquer les filtres</button>
                                    {% if hasFilters %}
                                        <a class="pr-reset" href="{{ path('app_practice') }}">Réinitialiser les filtres</a>
                                    {% endif %}
                                </div>
                            </details>
                        </form>
                    </aside>

                    <div class="pr-results">
                        <div class="pr-bar">
                            <p class="pr-found">{{ shown ? shown ~ ' exercice' ~ (shown > 1 ? 's') : 'Aucun exercice' }}{% if filters.framework %} · {{ frameworks[filters.framework] ?? filters.framework }}{% endif %}</p>
                            <p class="pr-sorts">
                                <span class="meta">Trier :</span>
                                {% for id, label in {recent: 'Récents', titre: 'Titre'} %}
                                    <a class="pr-tab{{ filters.tri == id ? ' active' }}" href="{{ path('app_practice', filters|merge({tri: id})|filter(v => v is not empty)) }}"{% if filters.tri == id %} aria-current="true"{% endif %}>{{ label }}</a>
                                {% endfor %}
                            </p>
                        </div>

                        {% for group in groups %}
                            <section class="pr-set">
                                <div class="pr-set-head">
                                    <h2 class="pr-set-label">{{ group.label }}</h2>
                                    <span class="pr-rule" aria-hidden="true"></span>
                                    <span class="pr-set-count">{{ group.items|length }}</span>
                                </div>
                                <ol class="practice-list">
                                    {% for item in group.items %}{{ ui.card(item, frameworks) }}{% endfor %}
                                </ol>
                            </section>
                        {% else %}
                            <div class="pr-empty">
                                <p>Aucun exercice avec ces filtres.</p>
                                <a class="lp-btn" href="{{ path('app_practice') }}">Tout afficher</a>
                            </div>
                        {% endfor %}

                        {% if shown and not app.user %}
                            {# Sur une instance sur invitation, l'éditeur reste fermé aux visiteurs (TrackAccessChecker) :
                               la même phrase y mentirait. #}
                            {% if inviteOnly %}
                                <p class="meta pr-signup">Cette plateforme est réservée à ses membres : <a rel="nofollow" href="{{ path('app_register') }}">créez votre compte</a> avec votre code d'invitation, ou <a href="{{ path('app_login') }}">connectez-vous</a>.</p>
                            {% else %}
                                <p class="meta pr-signup">Ces exercices s'écrivent sans compte : l'éditeur s'ouvre tout de suite. Le compte garde votre progression, ouvre le mentor et les retours — <a rel="nofollow" href="{{ path('app_register') }}">créez le vôtre</a> ou <a href="{{ path('app_login') }}">connectez-vous</a>.</p>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p class="meta">Pas encore d'exercice ici : revenez bientôt.</p>
            {% endif %}
        </div>
    </main>
{% endblock %}
