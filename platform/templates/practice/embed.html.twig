{#
  La carte d'un exercice de Pratique intégrée sur un autre site (iframe, voir App\Share\PracticeEmbed) : ni en-tête
  ni pied de page, et chaque lien ouvre la plateforme dans un nouvel onglet, hors de l'iframe.
#}
{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{% block title %}{{ practice.exercise.title }} · {{ theme.name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block body_class %}site-page embed-page{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <main class="embed-card mx-auto max-w-2xl rounded-md border border-line bg-bg px-5 py-5">
        <p class="flex flex-wrap items-center gap-2 text-sm">
            <a class="flex items-center gap-2 font-semibold" href="{{ url }}" target="_blank" rel="noopener" data-umami-event="integration-ouverte" data-umami-event-lien="logo">
                {% if theme.logoUrl %}<img class="h-6 w-auto" src="{{ theme.logoUrl }}" alt="" width="54" height="63">{% endif %}
                <span>{{ theme.name }}</span>
            </a>
            <span class="tag framework">{{ framework }}</span>
            {% if practice.version %}<span class="tag new border-accent text-accent">{{ 'commun.nouveaute'|trans }}</span>{% endif %}
        </p>
        <h1 class="mt-3 text-xl font-semibold">
            <a href="{{ url }}" target="_blank" rel="noopener" data-umami-event="integration-ouverte" data-umami-event-lien="titre">{{ practice.exercise.title }}</a>
        </h1>
        <p class="mt-2 text-ink-muted">{{ practice.summary }}</p>
        <p class="mt-4 flex flex-wrap items-center gap-3">
            <a class="btn btn-primary" href="{{ url }}" target="_blank" rel="noopener" data-umami-event="integration-ouverte" data-umami-event-lien="bouton">{{ 'practice.integration.bouton'|trans }} →</a>
            <span class="text-sm text-ink-muted">{{ 'practice.integration.detail'|trans }}</span>
        </p>
    </main>
{% endblock %}
