{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{#
  Une version d'un framework : les exercices de Pratique qui la font pratiquer. Rien n'y est rédigé à la main —
  la page se remplit quand un exercice paraît (voir App\Content\PracticeVersionIndex).
  Variables : slug, label, framework, version, practices, others, items, frameworks, concepts, introHtml.
#}
{% block body %}
    {% import 'practice/_card.html.twig' as ui %}
    <main class="pr">
        <div class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6">
            <nav class="breadcrumb" aria-label="{{ 'commun.fil_ariane'|trans }}">
                <ol>
                    <li><a href="{{ path('app_home') }}">{{ 'commun.accueil'|trans }}</a></li>
                    <li><a href="{{ path('app_practice') }}">{{ 'commun.pratique'|trans }}</a></li>
                    <li aria-current="page">{{ 'practice.version.fil'|trans({version: label}) }}</li>
                </ol>
            </nav>

            <div class="pr-hero mt-3 border-b border-line pb-8">
                <div class="pr-intro">
                    <p class="text-sm font-medium text-ink-muted">{{ 'commun.pratique'|trans }}</p>
                    <h1 class="mt-1 text-3xl font-semibold">{{ 'practice.version.titre'|trans({version: label}) }}</h1>
                    {% if introHtml %}
                        {# Intro écrite dans le pack : l'auteur dit ce que la version apporte, et répond de ce
                           qu'il promet — la page ne rajoute donc pas sa réserve sur l'exhaustivité. #}
                        <div class="lead pr-written prose prose-theme mt-3 max-w-none">{{ introHtml|raw }}</div>
                    {% else %}
                        {% set shown = concepts|slice(0, 4) %}
                        <p class="lead mt-3 text-lg text-ink-muted">
                            {{ (shown ? 'practice.version.resume_notions' : 'practice.version.resume')|trans({n: items|length, notions: shown|join(', ', 'commun.liste_et'|trans)}) }}
                            {{ 'practice.version.principe'|trans }}
                        </p>
                        <p class="pr-scope mt-3 text-sm text-ink-muted">{{ 'practice.version.portee'|trans({version: label}) }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="pr-results mt-8">
                <section class="pr-set">
                    <ol class="practice-list space-y-3">
                        {% for item in items %}{{ ui.card(item, frameworks, false) }}{% endfor %}
                    </ol>
                </section>

                {% if others %}
                    <p class="pr-versions mt-6 flex flex-wrap items-center gap-2 text-sm">
                        <span class="text-ink-muted">{{ 'practice.version.autres'|trans({framework: frameworks[framework] ?? framework}) }}</span>
                        {% for other in others %}
                            <a class="pr-tab tag" href="{{ path('app_practice_version', {slug: other.slug}) }}">{{ other.label }} <span class="pr-tab-count font-medium text-ink">{{ other.exercises }}</span></a>
                        {% endfor %}
                    </p>
                {% endif %}

                <p class="pr-versions mt-6 flex flex-wrap items-center gap-2 text-sm">
                    <a class="pr-tab tag" href="{{ path('app_practice') }}">{{ 'practice.version.toute_la_pratique'|trans }}</a>
                </p>
            </div>
        </div>
    </main>
{% endblock %}
