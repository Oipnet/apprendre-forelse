{#
  @theme Point de surcharge. Variables : theme (App\Theme\Theme), blog (App\Content\Blog), login_suite (string|null), moteur_version.
  Obligatoire : la version et la licence du moteur (AGPL), les liens vers les mentions légales et la confidentialité.
  Pied de page commun à toutes les pages du site (l'éditeur d'exercice et l'atelier, en plein écran, n'en ont pas). #}
<footer class="site-footer">
    <div class="lp-wrap">
        <div class="ft-top">
            <div class="ft-brand">
                <a class="ft-logo" href="{{ path('app_home') }}">
                    {% if theme.logoUrl %}<img src="{{ theme.logoUrl }}" alt="" width="36" height="42" loading="lazy" decoding="async">{% endif %}
                    <span class="lp-serif">{{ theme.name }}</span>
                    {% if theme.chip %}<span class="lp-chip">{{ theme.chip }}</span>{% endif %}
                </a>
                <p>{{ theme.tagline }}</p>
            </div>
            <nav class="ft-cols" aria-label="Pied de page">
                <div>
                    <h2>Apprendre</h2>
                    <ul>
                        <li><a href="{{ path('app_tracks') }}">Les parcours</a></li>
                        <li><a href="{{ path('app_practice') }}">Pratique</a></li>
                        <li><a href="{{ path('app_concepts') }}">Les notions</a></li>
                        {% if blog.open %}<li><a href="{{ path('app_blog') }}">Le blog</a></li>{% endif %}
                        <li><a href="{{ path('app_home') }}#questions">Questions fréquentes</a></li>
                    </ul>
                </div>
                <div>
                    <h2>{{ theme.name }}</h2>
                    <ul>
                        <li><a href="{{ path('app_organizations') }}">Écoles et entreprises</a></li>
                        {% if self_hosting.enabled %}<li><a href="{{ path('app_self_hosting') }}">Auto-hébergement</a></li>{% endif %}
                        <li><a href="{{ path('app_contact') }}">Contact</a></li>
                        <li>{% if app.user %}<a href="{{ path('app_account') }}">Mon compte</a>{% else %}<a href="{{ path('app_login', {suite: login_suite ?? null}) }}">Connexion</a>{% endif %}</li>
                    </ul>
                </div>
                <div>
                    <h2>Informations</h2>
                    <ul>
                        <li><a href="{{ path('app_legal_notice') }}">Mentions légales</a></li>
                        <li><a href="{{ path('app_privacy') }}">Confidentialité</a></li>
                        <li><a href="{{ path('app_terms') }}">Conditions de vente</a></li>
                    </ul>
                </div>
            </nav>
        </div>
        <div class="ft-bottom">
            <p>Les langages et frameworks cités sont des marques de leurs titulaires respectifs ; ce site n'est affilié à aucun d'eux.</p>
            <p class="site-moteur">Moteur {{ moteur_version }} · <abbr title="GNU Affero General Public License v3.0 ou ultérieure">AGPL-3.0</abbr></p>
        </div>
    </div>
</footer>
