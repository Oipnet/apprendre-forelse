{#
  @theme Point de surcharge. Variables : theme (App\Theme\Theme), seo (App\Seo\PageSeo : alternates, les autres langues de la page), blog (App\Content\Blog), login_suite (string|null), moteur_version.
  Obligatoire : la version et la licence du moteur (AGPL) avec le lien vers son code, les liens vers les mentions
  légales et la confidentialité.
  Pied de page commun à toutes les pages du site (l'éditeur d'exercice et l'atelier, en plein écran, n'en ont pas).
  Les classes site-*, footer-* ne portent aucun style : ce sont des repères pour les tests et les thèmes. #}
<footer class="site-footer mt-auto border-t border-line bg-bg-2 text-sm">
    <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1fr_2fr]">
        <div class="footer-brand">
            <a class="flex items-center gap-2 font-semibold text-ink no-underline hover:text-ink" href="{{ path('app_home') }}">
                {% if theme.logoUrl %}<img class="h-6 w-auto" src="{{ theme.logoUrl }}" alt="" width="36" height="42" loading="lazy" decoding="async">{% endif %}
                <span>{{ theme.name }}</span>
                {% if theme.chip %}<span class="rounded border border-line px-1.5 text-xs font-normal text-ink-muted">{{ theme.chip }}</span>{% endif %}
            </a>
            <p class="mt-2 text-ink-muted">{{ theme.tagline }}</p>
            {% for language, url in seo.alternates|filter((url, language) => language != 'x-default' and language != seo.language) %}
                <p class="footer-language mt-2"><a href="{{ url }}" hreflang="{{ language }}" lang="{{ language }}">{{ ('footer.langue.' ~ language)|trans }}</a></p>
            {% endfor %}
        </div>
        <nav class="grid gap-6 sm:grid-cols-3" aria-label="{{ 'footer.navigation'|trans }}">
            <div>
                <h2 class="font-semibold">{{ 'footer.apprendre'|trans }}</h2>
                <ul class="mt-2 space-y-1">
                    <li><a href="{{ path('app_tracks') }}">{{ 'footer.parcours'|trans }}</a></li>
                    <li><a href="{{ path('app_practice') }}">{{ 'footer.pratique'|trans }}</a></li>
                    <li><a href="{{ path('app_concepts') }}">{{ 'footer.notions'|trans }}</a></li>
                    {% if blog.open %}<li><a href="{{ path('app_blog') }}">{{ 'footer.blog'|trans }}</a></li>{% endif %}
                </ul>
            </div>
            <div>
                <h2 class="font-semibold">{{ theme.name }}</h2>
                <ul class="mt-2 space-y-1">
                    <li><a href="{{ path('app_organizations') }}">{{ 'footer.organisations'|trans }}</a></li>
                    {% if self_hosting.enabled %}<li><a href="{{ path('app_self_hosting') }}">{{ 'footer.auto_hebergement'|trans }}</a></li>{% endif %}
                    <li><a href="{{ path('app_contact') }}">{{ 'footer.contact'|trans }}</a></li>
                    <li>{% if app.user %}<a href="{{ path('app_account') }}">{{ 'footer.mon_compte'|trans }}</a>{% else %}<a href="{{ path('app_login', {suite: login_suite ?? null}) }}">{{ 'footer.connexion'|trans }}</a>{% endif %}</li>
                </ul>
            </div>
            <div>
                <h2 class="font-semibold">{{ 'footer.informations'|trans }}</h2>
                <ul class="mt-2 space-y-1">
                    <li><a href="{{ path('app_legal_notice') }}">{{ 'footer.mentions_legales'|trans }}</a></li>
                    <li><a href="{{ path('app_privacy') }}">{{ 'footer.confidentialite'|trans }}</a></li>
                    <li><a href="{{ path('app_terms') }}">{{ 'footer.conditions_vente'|trans }}</a></li>
                </ul>
            </div>
        </nav>
        <div class="space-y-1 border-t border-line pt-4 text-xs text-ink-muted md:col-span-2">
            <p>{{ 'footer.marques'|trans }}</p>
            <p class="site-moteur">{{ 'footer.moteur'|trans({version: moteur_version|e, depot: constant('App\\Instance\\SelfHostingPage::REPOSITORY')|e})|raw }}</p>
        </div>
    </div>
</footer>
