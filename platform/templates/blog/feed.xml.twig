<?xml version="1.0" encoding="UTF-8"?>
{% trans_default_domain 'blog' %}
{# Le flux du blog (voir BlogController::feed) : le texte complet, échappé plutôt qu'en CDATA, pour qu'aucun article ne le casse. #}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:media="http://search.yahoo.com/mrss/">
    <channel>
        <title>{{ 'commun.blog_de'|trans({site: theme.name}) }}</title>
        <link>{{ blog_url }}</link>
        <description>{{ 'feed.description'|trans({site: theme.name}) }}</description>
        <language>{{ app.request.locale }}</language>
        <atom:link href="{{ self }}" rel="self" type="application/rss+xml"/>
{% if items is not empty %}
        <lastBuildDate>{{ (items|first).article.published|date('r') }}</lastBuildDate>
{% endif %}
{% for item in items %}
        <item>
            <title>{{ item.article.title }}</title>
            <link>{{ item.url }}</link>
            <guid isPermaLink="true">{{ item.url }}</guid>
            <pubDate>{{ item.article.published|date('r') }}</pubDate>
            <description>{{ item.article.description }}</description>
{% for tag in item.article.tags %}
            <category>{{ tag }}</category>
{% endfor %}
            <content:encoded>{{ item.html }}</content:encoded>
            <enclosure url="{{ item.image.url }}" length="{{ item.image.length }}" type="image/png"/>
            <media:content url="{{ item.image.url }}" medium="image" type="image/png" width="{{ constant('App\\Share\\ShareImageRenderer::WIDTH') }}" height="{{ constant('App\\Share\\ShareImageRenderer::HEIGHT') }}"/>
        </item>
{% endfor %}
    </channel>
</rss>
