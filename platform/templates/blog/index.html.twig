{% extends 'base.html.twig' %}
{% trans_default_domain 'blog' %}

{#
  Le blog : l'article le plus récent mis en avant, puis les autres rangés par mois (voir App\Controller\BlogController).
  Les sujets filtrent la liste : une suite de liens, sans JavaScript ; la page filtrée n'a pas d'article à la une.
  Variables : articles (tous les articles parus), featured (Article|null), months (list<{month, articles}>), topics
  (array<filtre, {label, count}>), topic (le filtre choisi, ou null), count (le nombre d'articles listés), languages (les
  autres langues du blog).
#}
{% block title %}{{ 'commun.blog'|trans }} · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="blog-page mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
        <nav class="breadcrumb" aria-label="{{ 'commun.fil_ariane'|trans }}">
            <ol>
                <li><a href="{{ path('app_home') }}">{{ 'commun.accueil'|trans }}</a></li>
                <li aria-current="page">{{ 'commun.blog'|trans }}</li>
            </ol>
        </nav>

        <div class="flex flex-wrap items-end justify-between gap-6 border-b border-line pb-8">
            <div class="max-w-3xl">
                <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">{{ 'commun.blog'|trans }}</h1>
                <p class="lead mt-4 text-lg text-ink-muted">{{ 'index.intro'|trans }}</p>
            </div>
            <ul class="flex flex-wrap gap-2 text-sm font-medium">
                <li class="blog-feed"><a class="btn" href="{{ path('app_blog_feed') }}" type="application/rss+xml">{{ 'index.flux'|trans }}</a></li>
                {% for locale in languages %}
                    <li class="blog-language"><a class="btn" href="{{ path('app_blog', {_locale: locale}) }}" hreflang="{{ locale }}" lang="{{ locale }}">{{ ('index.version.' ~ locale)|trans }}</a></li>
                {% endfor %}
            </ul>
        </div>

        {% if featured %}
            <article class="blog-featured mt-10 rounded-xl border border-line bg-surface p-6 shadow-sm sm:p-10">
                <p class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs tracking-widest uppercase">
                    <span class="text-accent">{{ 'index.a_la_une'|trans }}</span>
                    <span class="meta text-ink-muted"><time datetime="{{ featured.published|date('Y-m-d') }}">{{ featured.published|date_longue }}</time> · {{ 'commun.lecture'|trans({minutes: featured.readingMinutes}) }}</span>
                </p>
                <h2 class="mt-4 max-w-4xl text-3xl leading-tight font-semibold sm:text-4xl"><a class="text-ink no-underline hover:text-accent" href="{{ path('app_article', {slug: featured.slug}) }}">{{ featured.title }}</a></h2>
                <p class="mt-4 max-w-3xl text-lg text-ink-muted">{{ featured.description }}</p>
                {% if featured.tags %}
                    <p class="blog-tags mt-4 flex flex-wrap gap-2">
                        {% for id, tag in featured.topics %}<a class="tag" href="{{ path('app_blog', {sujet: id}) }}">{{ tag }}</a>{% endfor %}
                    </p>
                {% endif %}
                <a class="btn btn-primary mt-6" href="{{ path('app_article', {slug: featured.slug}) }}">{{ 'index.lire'|trans }} →</a>
            </article>
        {% endif %}

        <div class="mt-12 flex flex-wrap items-start gap-12">
            <section class="min-w-0 flex-[999_1_32rem]" aria-labelledby="blog-tous">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 id="blog-tous" class="text-2xl font-semibold">{{ topic ? topics[topic].label : 'index.tous'|trans }}</h2>
                    <span class="text-sm text-ink-muted">{{ 'index.nombre'|trans({n: count}) }}</span>
                </div>

                {% if topics %}
                    <nav class="blog-topics mt-4 flex flex-wrap gap-2 text-sm" aria-label="{{ 'index.filtrer'|trans }}">
                        <a class="rounded-full border px-3 py-1 {{ topic is null ? 'border-accent bg-accent text-on-accent hover:text-on-accent' : 'border-line' }}" href="{{ path('app_blog') }}"{% if topic is null %} aria-current="page"{% endif %}>{{ 'index.tous_sujets'|trans }} <span class="opacity-70">{{ articles|length }}</span></a>
                        {% for id, item in topics %}
                            <a class="rounded-full border px-3 py-1 {{ topic == id ? 'border-accent bg-accent text-on-accent hover:text-on-accent' : 'border-line' }}" href="{{ path('app_blog', {sujet: id}) }}"{% if topic == id %} aria-current="page"{% endif %}>{{ item.label }} <span class="opacity-70">{{ item.count }}</span></a>
                        {% endfor %}
                    </nav>
                {% endif %}

                {% for group in months %}
                    <div class="blog-month mt-8">
                        <h3 class="font-mono text-xs tracking-widest text-ink-muted uppercase">{{ group.month|date_motif('LLLL y') }}</h3>
                        <ol class="blog-list mt-1">
                            {% for article in group.articles %}
                                <li class="border-t border-line py-6">{{ include('blog/_article_card.html.twig') }}</li>
                            {% endfor %}
                        </ol>
                    </div>
                {% endfor %}
            </section>

            <aside class="flex flex-[1_1_18rem] flex-col gap-5">
                {% if theme.person %}
                    <div class="blog-author rounded-xl border border-line bg-bg-2 p-6">
                        <p class="font-mono text-xs tracking-widest text-accent uppercase">{{ 'index.auteur'|trans }}</p>
                        <p class="mt-3 font-serif text-2xl">{{ theme.person.name }}</p>
                        <p class="mt-1 text-sm text-ink-muted">{{ theme.person.jobTitle }}</p>
                        <a class="btn btn-primary mt-5" href="{{ path('app_contact') }}">{{ 'index.contact'|trans }} →</a>
                    </div>
                {% endif %}
                <div class="rounded-xl border border-line bg-surface p-6">
                    <h2 class="text-xl font-semibold">{{ 'index.suivre'|trans }}</h2>
                    <p class="mt-2 text-sm text-ink-muted">{{ 'index.suivre_detail'|trans }}</p>
                    <p class="mt-3 text-sm font-medium"><a href="{{ path('app_blog_feed') }}" type="application/rss+xml">{{ 'index.flux'|trans }} →</a></p>
                </div>
            </aside>
        </div>
    </main>
{% endblock %}
