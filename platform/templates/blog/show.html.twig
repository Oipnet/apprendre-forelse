{% extends 'base.html.twig' %}
{% trans_default_domain 'blog' %}

{#
  Un article du blog, rendu depuis le Markdown de son pack (voir App\Content\Article).
  Variables : article, html, scheduled, translations (le même article dans les autres langues), previous, next.
#}
{% block title %}{{ article.title }} · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="blog-page mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <nav class="breadcrumb" aria-label="{{ 'commun.fil_ariane'|trans }}">
            <ol>
                <li><a href="{{ path('app_home') }}">{{ 'commun.accueil'|trans }}</a></li>
                <li><a href="{{ path('app_blog') }}">{{ 'commun.blog'|trans }}</a></li>
                <li aria-current="page">{{ article.title }}</li>
            </ol>
        </nav>

        {% if article.restricted %}
            <p class="blog-notice mt-4 rounded-md border border-line bg-bg-2 px-4 py-3 text-sm">{{ 'show.en_preparation'|trans }}</p>
        {% elseif scheduled %}
            <p class="blog-notice mt-4 rounded-md border border-line bg-bg-2 px-4 py-3 text-sm">{{ 'show.programme'|trans({date: article.published|date_longue}) }}</p>
        {% endif %}

        <article class="mt-4">
            <header>
                <h1 class="text-3xl font-semibold">{{ article.title }}</h1>
                <p class="meta mt-2 text-sm text-ink-muted">
                    {%- if theme.person %}{{ theme.person.name }} · {% endif -%}
                    <time datetime="{{ article.published|date('Y-m-d') }}">{{ article.published|date_longue }}</time>
                    {%- if article.updated %} · {{ 'show.mis_a_jour'|trans({datetime: article.updated|date('Y-m-d'), date: article.updated|date_longue|e})|raw }}{% endif %}
                    · {{ 'commun.lecture'|trans({minutes: article.readingMinutes}) }}
                </p>
                {%- for locale, translation in translations %}
                <p class="blog-translation mt-2 text-sm"><a href="{{ path('app_article', {_locale: locale, slug: translation.slug}) }}" hreflang="{{ locale }}" lang="{{ locale }}">{{ ('show.version.' ~ locale)|trans }}</a></p>
                {%- endfor %}
            </header>

            <div class="lesson prose prose-theme mt-8 max-w-none">{{ html|raw }}</div>
        </article>

        {% if previous or next %}
            <nav class="blog-nav mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-6" aria-label="{{ 'show.autres'|trans }}">
                {% if previous %}<a class="btn" href="{{ path('app_article', {slug: previous.slug}) }}">← {{ previous.title }}</a>{% endif %}
                {% if next %}<a class="btn" href="{{ path('app_article', {slug: next.slug}) }}">{{ next.title }} →</a>{% endif %}
            </nav>
        {% endif %}
        <p class="blog-back mt-6 text-sm"><a href="{{ path('app_blog') }}">{{ 'show.tous'|trans }}</a></p>
    </main>
{% endblock %}
