{#
  Les notions d'un exercice ou d'un chapitre, en pastilles. Celles qui ont une page y mènent ; les autres
  restent de simples pastilles (voir ConceptIndex : une notion vue une seule fois ne relie rien).
  Variables : concepts (list<string>), label (facultatif, le texte qui les introduit).
#}
{% if concepts %}
    <p class="exercise-concepts mt-3 flex flex-wrap items-center gap-1.5">
        {%- if label is defined and label %}<span class="meta text-sm text-ink-muted">{{ label }}</span> {% endif -%}
        {%- for concept in concepts -%}
            {%- set url = notion_url(concept) -%}
            {%- if url %}<a class="tag" href="{{ url }}">{{ concept }}</a>{% else %}<span class="tag">{{ concept }}</span>{% endif -%}
        {%- endfor -%}
    </p>
{% endif %}
