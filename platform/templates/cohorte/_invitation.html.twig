{# Lien d'invitation à copier dans un message aux apprenants (le bouton n'apparaît qu'avec JavaScript). #}
{% set invitation = url('app_register', {code: cohort.code}) %}
<span class="beta-copy">
    <input class="form-control form-control-sm" type="text" value="{{ invitation }}" readonly aria-label="Lien d'invitation de {{ cohort.name }}" onfocus="this.select()">
    <button class="btn btn-sm btn-secondary" type="button" data-copy="{{ invitation }}" hidden>Copier</button>
</span>
