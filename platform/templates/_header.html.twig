{#
  @theme Point de surcharge : l'en-tête des pages du site (marque, navigation, menu du compte).
  Variables : theme (App\Theme\Theme), brand_chip (la puce, déjà rendue : « atelier » dans l'atelier), login_suite
  (string|null : la page où revenir après connexion), blog (App\Content\Blog), app.user (App\Entity\User|null).
  Obligatoire : les liens de connexion et d'inscription pour un visiteur, le menu du compte et la déconnexion pour un
  apprenant. Le menu du compte garde [data-account-menu] : le script du moteur le referme d'un clic ailleurs.
  Les classes site-*, account-* ne portent aucun style : ce sont des repères pour les tests et les thèmes.
#}
<header class="site-header border-b border-line bg-surface">
    <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
        <a class="site-brand flex items-center gap-2 font-semibold text-ink no-underline hover:text-ink" href="{{ path('app_home') }}">
            {% if theme.logoUrl %}<img class="h-8 w-auto" src="{{ theme.logoUrl }}" alt="" width="72" height="84">{% endif %}
            <span class="site-name text-lg">{{ theme.name }}</span>
            {% if brand_chip|trim %}<span class="site-chip rounded border border-line px-1.5 text-xs font-normal text-ink-muted">{{ brand_chip }}</span>{% endif %}
        </a>
        <nav class="flex flex-1 flex-wrap items-center justify-end gap-x-4 gap-y-2 text-sm" aria-label="Navigation principale">
            <a href="{{ path('app_tracks') }}">Parcours</a>
            <a href="{{ path('app_practice') }}">Pratique</a>
            {% if blog.open %}<a href="{{ path('app_blog') }}">Blog</a>{% endif %}
            {% if app.user %}
                {# Tout ce qui concerne le compte et les espaces réservés, derrière le nom : sans JS, <details> s'ouvre et se ferme seul. #}
                <details class="account relative" data-account-menu>
                    <summary class="flex cursor-pointer list-none items-center gap-2" aria-label="Menu du compte de {{ app.user.displayName }}">
                        <span class="account-name font-medium">{{ app.user.displayName }}</span>
                        <span class="account-xp rounded bg-bg-2 px-1.5 text-xs text-ink-muted">{{ app.user.xp }} XP</span>
                        <span aria-hidden="true">▾</span>
                    </summary>
                    <div class="account-menu absolute right-0 z-20 mt-2 flex min-w-48 flex-col gap-1 rounded-md border border-line bg-surface p-2 shadow-lg">
                        <a class="rounded px-2 py-1" href="{{ path('app_account') }}">Mon compte</a>
                        {% if is_granted('ROLE_AUTEUR') or is_granted('ROLE_CHEF_COHORTE') %}
                            <p class="account-label mt-1 px-2 text-xs uppercase tracking-wide text-ink-muted">Espaces</p>
                            {% if is_granted('ROLE_AUTEUR') %}<a class="rounded px-2 py-1" href="{{ path('app_studio') }}">Atelier</a>{% endif %}
                            {% if is_granted('ROLE_CHEF_COHORTE') %}<a class="rounded px-2 py-1" href="{{ path('chef') }}">Mes cohortes</a>{% endif %}
                            {% if is_granted('ROLE_ADMIN') %}<a class="rounded px-2 py-1" href="{{ path('admin') }}">Administration</a>{% endif %}
                        {% endif %}
                        <a class="account-logout mt-1 rounded border-t border-line px-2 py-1" href="{{ logout_path() }}">Déconnexion</a>
                    </div>
                </details>
            {% else %}
                <a href="{{ path('app_login', {suite: login_suite}) }}">Connexion</a>
                <a class="btn btn-primary" rel="nofollow" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </nav>
    </div>
</header>
