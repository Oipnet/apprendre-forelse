{% extends 'base.html.twig' %}

{% block title %}Classement · {{ theme.name }}{% endblock %}

{% block body %}
    {% set me = board.viewer %}
    <main class="lb mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <header class="border-b border-line pb-6">
            <h1 class="text-3xl font-semibold">Classement</h1>
            <p class="mt-2 text-ink-muted">Les apprenants qui ont choisi d'y paraître, à l'XP gagnée sur les exercices réussis, parcours et Pratique. Un indice ou la solution consultée font gagner moins d'XP.</p>
            <nav class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="Période">
                {% for period in periods %}
                    <a class="tag {{ period == board.period ? 'border-highlight text-highlight' }}" href="{{ path('app_leaderboard', {periode: period.value}) }}"{% if period == board.period %} aria-current="page"{% endif %}>{{ period.label }}</a>
                {% endfor %}
            </nav>
        </header>

        {% if app.user %}
            <div class="lb-me mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-line bg-surface p-4">
                <p class="flex-1">
                    {% if me and me.listed %}
                        Vous êtes <strong>{{ me.rank }}<sup>{{ me.rank == 1 ? 'er' : 'e' }}</sup></strong> sur {{ board.total }}, avec {{ me.xp }} XP.
                    {% elseif me %}
                        Vous seriez <strong>{{ me.rank }}<sup>{{ me.rank == 1 ? 'er' : 'e' }}</sup></strong>, avec {{ me.xp }} XP. Votre pseudo, « {{ app.user.displayName }} », n'apparaît que si vous le choisissez.
                    {% elseif app.user.leaderboardOptIn %}
                        Réussissez un exercice {{ board.period.value == 'mois' ? 'ce mois-ci ' }}pour entrer dans le classement.
                    {% else %}
                        Réussissez un exercice, et choisissez d'apparaître ici sous votre pseudo, « {{ app.user.displayName }} ».
                    {% endif %}
                </p>
                {{ include('leaderboard/_opt_in.html.twig', {retour: 'classement'}) }}
            </div>
        {% else %}
            <p class="mt-6 text-ink-muted"><a href="{{ path('app_register') }}" rel="nofollow">Créez un compte</a> pour garder votre progression et, si vous le souhaitez, apparaître ici.</p>
        {% endif %}

        {% if board.entries is empty %}
            <p class="mt-8 text-ink-muted">Personne au classement {{ board.period.value == 'mois' ? 'ce mois-ci' : 'pour l\'instant' }}.</p>
        {% else %}
            <table class="lb-table mt-8 w-full text-left">
                <thead class="text-sm text-ink-muted">
                    <tr class="border-b border-line">
                        <th class="py-2 pr-4 font-medium" scope="col">Rang</th>
                        <th class="py-2 pr-4 font-medium" scope="col">Pseudo</th>
                        <th class="py-2 pr-4 text-right font-medium" scope="col">Exercices</th>
                        <th class="py-2 text-right font-medium" scope="col">XP</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in board.entries %}
                        {% set mine = me and me.userId == entry.userId %}
                        <tr class="border-b border-line{{ mine ? ' bg-bg-2 font-semibold' }}"{% if mine %} aria-current="true"{% endif %}>
                            <td class="py-2 pr-4 font-mono">{{ entry.rank }}</td>
                            <td class="py-2 pr-4">{{ entry.displayName }}</td>
                            <td class="py-2 pr-4 text-right font-mono">{{ entry.exercises }}</td>
                            <td class="xp py-2 text-right font-mono">{{ entry.xp }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if board.total > board.entries|length %}
                <p class="mt-3 text-sm text-ink-muted">Les {{ board.entries|length }} premiers sur {{ board.total }}.</p>
            {% endif %}
        {% endif %}

        <p class="mt-8 text-sm text-ink-muted">Les réussites sont rejouées sur nos serveurs avec le code envoyé : une réussite que les tests n'y confirment pas sort du classement.</p>
    </main>
{% endblock %}
