{% extends 'base.html.twig' %}
{% trans_default_domain 'classement' %}

{% block title %}{{ 'index.titre'|trans }} · {{ theme.name }}{% endblock %}

{#
  Le classement : en-tête et filtres (période, parcours), bandeau « Votre position », podium des trois premiers (ou,
  avant trois classés, l'encart « Vous ouvrez la marche »), tableau à partir du quatrième, et colonne latérale (barème,
  vérification des réussites, visibilité). Les classes lb-* sont des repères pour les tests et les thèmes.
#}
{% macro xp(value) %}{{ value|nombre }}{% endmacro %}
{% macro avatar(entry, size) %}
    {%- set colors = ['bg-accent/15', 'bg-success/15', 'bg-highlight/15', 'bg-danger/10', 'bg-ink/10'] -%}
    <span class="flex flex-none items-center justify-center rounded-full font-serif font-semibold text-ink {{ colors[entry.userId % 5] }} {{ size == 'lg' ? 'size-13 text-2xl' : 'size-8.5 text-base' }}" aria-hidden="true">{{ entry.initial }}</span>
{%- endmacro %}

{% block body %}
    {% set me = board.viewer %}
    {% set listed = me and me.listed %}
    {% set moves = board.showsMoves %}
    <main class="lb mx-auto w-full max-w-6xl px-4 pt-10 pb-16 sm:px-6 lg:pt-12">
        <header class="mb-8 flex flex-wrap items-end justify-between gap-6">
            <div class="min-w-0 flex-[1_1_420px]">
                <p class="mb-1.5 font-mono text-xs tracking-[0.18em] text-accent uppercase">{{ 'index.communaute'|trans }}</p>
                <h1 class="mb-2.5 font-serif text-4xl leading-tight font-semibold sm:text-5xl">{{ 'index.titre'|trans }}</h1>
                <p class="max-w-xl text-lg text-ink-muted">{{ 'index.intro'|trans }}</p>
            </div>
            {# Sans script, les boutons de période envoient le formulaire, et « Afficher » applique le parcours choisi. #}
            <form class="lb-filters flex flex-wrap items-center gap-3" method="get" action="{{ path('app_leaderboard') }}" data-auto-submit>
                <div class="flex rounded-full bg-bg-2 p-1" role="group" aria-label="{{ 'index.periode'|trans }}">
                    {% for period in periods %}
                        {% set on = period == board.period %}
                        <button class="min-h-11 rounded-full border px-4 text-sm font-medium {{ on ? 'border-line bg-surface text-ink shadow-sm' : 'border-transparent text-ink-muted hover:text-ink' }}" type="submit" name="periode" value="{{ period.value }}" aria-pressed="{{ on ? 'true' : 'false' }}">{{ period|trans }}</button>
                    {% endfor %}
                </div>
                <label class="flex items-center gap-2 text-sm text-ink-muted">
                    <span>{{ 'index.parcours'|trans }}</span>
                    <select class="min-h-11 max-w-60 rounded-lg border border-line bg-surface px-3 text-sm text-ink" name="parcours">
                        <option value="">{{ 'index.tous'|trans }}</option>
                        {% for value, label in trackFilters %}
                            <option value="{{ value }}"{% if value == board.track %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <noscript><button class="btn min-h-11 text-sm" type="submit" name="periode" value="{{ board.period.value }}">{{ 'index.afficher'|trans }}</button></noscript>
            </form>
        </header>

        <div class="flex flex-wrap items-start gap-8">
            <div class="flex min-w-0 flex-[999_1_600px] flex-col gap-7">
                <section class="lb-me flex flex-wrap items-center gap-x-9 gap-y-5 rounded-2xl bg-dark px-6 py-6 text-dark-ink sm:px-7" aria-label="{{ 'index.votre_position'|trans }}">
                    {% if listed %}
                        {% set ahead = board.ahead %}
                        <p class="flex items-baseline gap-1 font-serif">
                            <span class="text-6xl leading-none font-semibold">{{ me.rank }}</span>
                            <span class="text-2xl font-medium">{{ 'index.rang_suffixe'|trans({n: me.rank}) }}</span>
                        </p>
                        <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-2.5">
                            <p class="text-lg">{{ 'index.sur_classes'|trans({n: board.total, total: board.total}) }} · <span class="font-mono text-accent-line">{{ 'commun.xp'|trans({xp: me.xp|nombre}) }}</span> · {{ 'index.exercices'|trans({n: me.exercises}) }}</p>
                            <div class="h-2 overflow-hidden rounded-full bg-dark-ink/15" aria-hidden="true">
                                <div class="h-full rounded-full bg-accent-line" style="width: {{ ahead ? max(2, (100 * me.xp / (ahead.xp + 1))|round) : 100 }}%"></div>
                            </div>
                            <p class="text-sm text-dark-ink/75">
                                {%- if ahead %}{{ 'index.devant'|trans({xp: (ahead.xp - me.xp + 1)|nombre, pseudo: ahead.displayName}) }}
                                {%- elseif board.total == 1 %}{{ 'index.premier_seul'|trans }}
                                {%- else %}{{ 'index.en_tete'|trans }}{% endif -%}
                            </p>
                        </div>
                        {% if board.monthXp is not null or me.move is not null or me.isNew %}
                            <p class="flex flex-col gap-0.5 border-l border-dark-ink/20 pl-6">
                                {% if me.move is not null %}
                                    <span class="font-mono text-2xl text-accent-line">{{ me.move > 0 ? '+' ~ me.move : (me.move < 0 ? '−' ~ (-me.move) : '=') }}{% if me.move != 0 %} {{ 'index.places'|trans({n: me.move|abs}) }}{% endif %}</span>
                                    <span class="text-sm text-dark-ink/75">{{ 'index.depuis'|trans({mois: board.previousMonth}) }}</span>
                                {% else %}
                                    <span class="font-mono text-2xl text-accent-line">+{{ 'commun.xp'|trans({xp: (board.monthXp ?? me.xp)|nombre}) }}</span>
                                    <span class="text-sm text-dark-ink/75">{{ 'index.ce_mois_ci'|trans }}</span>
                                {% endif %}
                            </p>
                        {% endif %}
                    {% else %}
                        <div class="min-w-0 flex-[1_1_320px]">
                            {% if me %}
                                <p class="font-serif text-2xl font-semibold">{{ 'index.vous_seriez'|trans({rang: me.rank, n: me.rank, xp: me.xp|nombre})|raw }}</p>
                                <p class="mt-1 text-dark-ink/75">{{ 'index.rejoignez_pseudo'|trans({pseudo: app.user.displayName}) }}</p>
                            {% elseif app.user and app.user.leaderboardOptIn %}
                                <p class="font-serif text-2xl font-semibold">{{ 'index.inscrit'|trans }}</p>
                                <p class="mt-1 text-dark-ink/75">{{ 'index.reussissez_pour_entrer'|trans({mois: board.period.value == 'mois' ? 'oui' : 'non', filtre: board.track ? 'oui' : 'non'}) }}</p>
                            {% elseif app.user %}
                                <p class="font-serif text-2xl font-semibold">{{ 'index.rejoignez'|trans }}</p>
                                <p class="mt-1 text-dark-ink/75">{{ 'index.reussissez_pseudo'|trans({pseudo: app.user.displayName}) }}</p>
                            {% else %}
                                <p class="font-serif text-2xl font-semibold">{{ 'index.entrez'|trans }}</p>
                                <p class="mt-1 text-dark-ink/75">{{ 'index.creez_compte'|trans }}</p>
                            {% endif %}
                        </div>
                        {% if not app.user %}
                            <a class="btn btn-primary min-h-11" href="{{ path('app_register') }}" rel="nofollow">{{ 'index.creer_compte'|trans }}</a>
                        {% elseif not app.user.leaderboardOptIn %}
                            <form method="post" action="{{ path('app_leaderboard_opt_in') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('leaderboard') }}">
                                <input type="hidden" name="retour" value="classement">
                                <input type="hidden" name="participer" value="1">
                                <button class="btn btn-primary min-h-11" type="submit">{{ 'commun.apparaitre'|trans }}</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </section>

                {% if board.hasPodium %}
                    <section class="lb-podium grid grid-cols-3 items-end gap-2 sm:gap-3.5" aria-label="{{ 'index.podium'|trans }}">
                        {% for entry in board.podium %}
                            {% set first = loop.index == 2 %}
                            {% set mine = listed and me.userId == entry.userId %}
                            <div class="flex min-w-0 flex-col items-center gap-2 rounded-2xl border px-2 pt-5 text-center sm:px-4 {{ first ? 'bg-accent/10' : 'bg-surface' }} {{ mine ? 'border-accent' : (first ? 'border-accent-line' : 'border-line') }} {# Les marches du podium : le premier plus haut, le troisième plus bas. #}pb-5 {{ loop.index == 2 ? 'min-h-72' : (loop.index == 1 ? 'min-h-64' : 'min-h-56') }}"{% if mine %} aria-current="true"{% endif %}>
                                <span class="font-mono text-xs tracking-[0.14em] text-accent uppercase">{{ 'index.place_podium'|trans({rang: entry.rank, n: entry.rank}) }}</span>
                                {{ _self.avatar(entry, 'lg') }}
                                <span class="max-w-full truncate text-[17px] font-semibold">{{ entry.displayName }}</span>
                                <span class="font-mono text-lg font-bold">{{ _self.xp(entry.xp) }} <span class="text-xs font-normal text-ink-muted">{{ 'commun.unite_xp'|trans }}</span></span>
                                {% if entry.tracks %}<span class="max-w-full text-[13px] text-ink-muted">{{ entry.tracks|join(' · ') }}</span>{% endif %}
                                {% if mine %}<span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-on-accent">{{ 'index.vous'|trans }}</span>{% endif %}
                            </div>
                        {% endfor %}
                    </section>
                {% else %}
                    <section class="lb-start flex flex-wrap items-center gap-x-7 gap-y-5 rounded-2xl border-[1.5px] border-dashed border-accent-line bg-bg-2 p-6 sm:p-7" aria-labelledby="lb-start-title">
                        <span class="flex size-14 flex-none items-center justify-center rounded-full bg-accent/15 text-accent" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </span>
                        <div class="min-w-0 flex-[1_1_280px]">
                            <h2 class="mb-1 font-serif text-2xl font-semibold" id="lb-start-title">{{ (listed ? 'index.ouvrez_la_marche' : 'index.demarre')|trans }}</h2>
                            <p class="text-ink-muted">{{ 'index.podium_bientot'|trans }}</p>
                        </div>
                        <div class="share flex flex-col items-start gap-1" data-share="{{ {text: share.text, natif: share.natif, lien: share.lien, mesure: {page: 'classement'}}|json_encode }}">
                            <button class="btn btn-primary min-h-11 gap-2" type="button" data-share-copy>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                                {{ 'index.copier_lien'|trans }}
                            </button>
                            <span class="share-status text-sm text-ink-muted" role="status"></span>
                        </div>
                    </section>
                {% endif %}

                <section class="lb-board overflow-hidden rounded-2xl border border-line bg-surface" aria-labelledby="lb-board-title">
                    <h2 class="sr-only" id="lb-board-title">{{ 'index.tableau'|trans }}</h2>
                    {% if board.rows or board.freeSpots > 0 %}
                        <div class="overflow-x-auto">
                            <table class="lb-table w-full min-w-[560px] text-left">
                                <thead class="text-[13px] text-ink-muted">
                                    <tr class="border-b border-line">
                                        <th class="w-16 py-3.5 pr-3 pl-6 font-normal" scope="col">{{ 'index.col_rang'|trans }}</th>
                                        <th class="py-3.5 pr-3 font-normal" scope="col">{{ 'index.col_apprenant'|trans }}</th>
                                        {% if moves %}<th class="w-24 py-3.5 pr-3 font-normal" scope="col">{{ 'index.col_evolution'|trans }}</th>{% endif %}
                                        <th class="w-24 py-3.5 pr-3 text-right font-normal" scope="col">{{ 'index.col_exercices'|trans }}</th>
                                        <th class="w-44 py-3.5 pr-6 text-right font-normal" scope="col">{{ 'commun.unite_xp'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for entry in board.rows %}
                                        {% set mine = listed and me.userId == entry.userId %}
                                        <tr class="border-b border-line/60 last:border-b-0 {{ mine ? 'bg-accent/10 shadow-[inset_3px_0_0_var(--color-accent)]' }}"{% if mine %} aria-current="true"{% endif %}>
                                            <td class="py-3 pr-3 pl-6 font-mono text-[15px] font-bold">{{ entry.rank }}</td>
                                            <td class="py-3 pr-3">
                                                <div class="flex min-w-0 items-center gap-3">
                                                    {{ _self.avatar(entry, 'sm') }}
                                                    <div class="flex min-w-0 flex-col">
                                                        <span class="flex items-center gap-2 font-semibold"><span class="lb-name">{{ entry.displayName }}</span>{% if mine %}<span class="rounded-full bg-accent px-2 text-[11px] font-semibold text-on-accent">{{ 'index.vous'|trans }}</span>{% endif %}</span>
                                                        {% if entry.tracks %}<span class="truncate text-[13px] text-ink-muted">{{ entry.tracks|join(' · ') }}</span>{% endif %}
                                                    </div>
                                                </div>
                                            </td>
                                            {% if moves %}
                                                <td class="lb-move py-3 pr-3 font-mono text-[13px]">
                                                    {% if entry.isNew %}
                                                        <span class="rounded-full bg-ink/10 px-2 py-0.5 font-sans text-xs font-semibold">{{ 'index.nouveau'|trans }}</span>
                                                    {% elseif entry.move > 0 %}
                                                        <span class="inline-flex items-center gap-1 text-success"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>+{{ entry.move }}<span class="sr-only"> {{ 'index.places'|trans({n: entry.move}) }}</span></span>
                                                    {% elseif entry.move < 0 %}
                                                        <span class="inline-flex items-center gap-1 text-danger"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>−{{ -entry.move }}<span class="sr-only"> {{ 'index.places'|trans({n: -entry.move}) }}</span></span>
                                                    {% else %}
                                                        <span class="text-ink-muted">=<span class="sr-only"> {{ 'index.meme_place'|trans }}</span></span>
                                                    {% endif %}
                                                </td>
                                            {% endif %}
                                            <td class="py-3 pr-3 text-right font-mono text-[15px]">{{ entry.exercises }}</td>
                                            <td class="py-3 pr-6">
                                                <div class="flex flex-col items-end gap-1.5">
                                                    <span class="xp font-mono text-[15px] font-bold">{{ _self.xp(entry.xp) }}</span>
                                                    <span class="block h-1 w-full overflow-hidden rounded-full bg-bg-2" aria-hidden="true"><span class="block h-full rounded-full bg-accent" style="width: {{ max(3, (100 * entry.xp / max(1, board.maxXp))|round) }}%"></span></span>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    {% if board.freeSpots > 0 %}
                                        {% for spot in (board.entries|length + 1)..3 %}
                                            <tr class="lb-free border-b border-line/60 text-ink-muted last:border-b-0">
                                                <td class="py-3 pr-3 pl-6 font-mono text-[15px]">{{ spot }}</td>
                                                <td class="py-3 pr-3"><span class="flex items-center gap-3"><span class="size-8.5 flex-none rounded-full border-[1.5px] border-dashed border-accent-line" aria-hidden="true"></span>{{ 'index.place_libre'|trans }}</span></td>
                                                {% if moves %}<td class="py-3 pr-3"></td>{% endif %}
                                                <td class="py-3 pr-3 text-right">—</td>
                                                <td class="py-3 pr-6 text-right">—</td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                    <p class="lb-note bg-bg-2 px-6 py-3.5 text-[13px] text-ink-muted">{{ board.periodNote }}{% if board.total > board.entries|length %} {{ 'index.premiers'|trans({n: board.entries|length, total: board.total}) }}{% endif %}</p>
                </section>
            </div>

            <aside class="flex min-w-0 flex-[1_1_280px] flex-col gap-4">
                <section class="lb-scale rounded-2xl border border-line bg-surface p-5.5" aria-labelledby="lb-scale-title">
                    <h2 class="mb-3.5 font-serif text-xl font-semibold" id="lb-scale-title">{{ 'index.bareme.titre'|trans }}</h2>
                    <dl class="flex flex-col gap-3 text-sm">
                        {% if scale.track %}
                            <div class="flex justify-between gap-3"><dt>{{ 'index.bareme.exercice'|trans }}</dt><dd class="text-right font-mono font-bold text-accent">{{ (scale.track[0] == scale.track[1] ? 'commun.xp' : 'index.bareme.fourchette')|trans({xp: scale.track[0], min: scale.track[0], max: scale.track[1]}) }}</dd></div>
                        {% endif %}
                        <div class="flex justify-between gap-3"><dt>{{ 'index.bareme.indice'|trans }}</dt><dd class="text-right font-mono text-accent">{{ 'index.bareme.indice_valeur'|trans({pourcentage: scale.hintPenalty}) }}</dd></div>
                        <div class="flex justify-between gap-3"><dt>{{ 'index.bareme.solution'|trans }}</dt><dd class="text-right font-mono text-accent">{{ 'commun.xp'|trans({xp: 0}) }}</dd></div>
                        <div class="flex justify-between gap-3 border-t border-line pt-3"><dt>{{ 'index.bareme.parcours'|trans }}</dt><dd class="text-right font-mono font-bold text-accent">{{ 'index.bareme.parcours_valeur'|trans({pourcentage: scale.trackBonus}) }}</dd></div>
                        {% if scale.practice %}
                            <div class="flex justify-between gap-3"><dt>{{ 'index.bareme.pratique'|trans }}</dt><dd class="text-right font-mono font-bold text-accent">{{ (scale.practice[0] == scale.practice[1] ? 'commun.xp' : 'index.bareme.fourchette')|trans({xp: scale.practice[0], min: scale.practice[0], max: scale.practice[1]}) }}</dd></div>
                        {% endif %}
                    </dl>
                    <p class="mt-3.5 text-xs text-ink-muted">{{ 'index.bareme.plancher'|trans({pourcentage: scale.floor}) }}</p>
                </section>

                <section class="lb-verified flex gap-3.5 rounded-2xl border border-success/25 bg-success-bg p-5.5 text-success" aria-labelledby="lb-verified-title">
                    <svg class="mt-0.5 flex-none" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    <div>
                        <h2 class="mb-1 font-sans text-[15px] font-semibold" id="lb-verified-title">{{ 'index.verifiees.titre'|trans }}</h2>
                        <p class="text-sm text-ink">{{ 'index.verifiees.texte'|trans }}</p>
                    </div>
                </section>

                {% if app.user %}
                    <section class="lb-visibility rounded-2xl border border-line bg-surface p-5.5" aria-labelledby="lb-visibility-title">
                        <h2 class="mb-1.5 font-serif text-xl font-semibold" id="lb-visibility-title">{{ 'index.visibilite.titre'|trans }}</h2>
                        <p class="mb-3.5 text-sm text-ink-muted">
                            {%- if app.user.leaderboardOptIn %}{{ 'index.visibilite.visible'|trans({pseudo: app.user.displayName|e})|raw }}
                            {%- else %}{{ 'index.visibilite.invisible'|trans({pseudo: app.user.displayName|e})|raw }}{% endif %} {{ 'index.visibilite.confidentialite'|trans }}
                        </p>
                        <div class="flex flex-wrap items-center gap-2">
                            <a class="btn min-h-11 text-sm" href="{{ path('app_account') }}#profil">{{ 'index.visibilite.changer_pseudo'|trans }}</a>
                            <form method="post" action="{{ path('app_leaderboard_opt_in') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('leaderboard') }}">
                                <input type="hidden" name="retour" value="classement">
                                {% if app.user.leaderboardOptIn %}
                                    <input type="hidden" name="participer" value="0">
                                    <button class="min-h-11 px-3.5 text-sm font-medium text-danger underline underline-offset-3 hover:no-underline" type="submit">{{ 'commun.me_retirer'|trans }}</button>
                                {% else %}
                                    <input type="hidden" name="participer" value="1">
                                    <button class="min-h-11 px-3.5 text-sm font-medium text-accent underline underline-offset-3 hover:no-underline" type="submit">{{ 'index.visibilite.rejoindre'|trans }}</button>
                                {% endif %}
                            </form>
                        </div>
                    </section>
                {% endif %}
            </aside>
        </div>
    </main>
{% endblock %}
