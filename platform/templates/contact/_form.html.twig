{#
  Formulaire de contact, partagé par /contact et /ecoles-et-entreprises. Variables : form, open, submitLabel.
  Sans adresse de réception configurée (CONTACT_EMAIL, LEGAL_PUBLISHER_EMAIL), on ne propose pas de formulaire.
#}
{% trans_default_domain 'compte' %}
{% if open %}
    <div class="site-form contact-form mt-6">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {% if form.subject is defined %}{{ form_row(form.subject) }}{% endif %}
            <div class="contact-pair grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
            </div>
            {% if form.organization is defined %}
                <div class="contact-pair grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(form.organization) }}
                    {{ form_row(form.headcount) }}
                </div>
            {% endif %}
            {{ form_row(form.message) }}
            {# Piège à robots : un humain ne voit pas ce champ. #}
            {{ form_widget(form.site) }}
            <p class="text-sm text-ink-muted">{{ 'contact.form.confidentialite'|trans({lien: path('app_privacy')})|raw }}</p>
            <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
        {{ form_end(form) }}
    </div>
{% else %}
    <p class="text-sm text-ink-muted">{{ 'contact.form.indisponible'|trans({lien: path('app_legal_notice')})|raw }}</p>
{% endif %}
