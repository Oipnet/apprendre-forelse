{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block body %}
    <main class="contact-page mx-auto w-full max-w-2xl px-4 py-10 sm:px-6">
        <p class="text-sm text-ink-muted">{{ 'contact.index.surtitre'|trans }}</p>
        <h1 class="text-2xl font-semibold">{{ 'contact.index.titre'|trans }}</h1>
        <p class="lead mt-3 text-lg text-ink-muted">{{ 'contact.index.intro'|trans }}</p>

        <ul class="contact-shortcuts my-6 list-disc space-y-2 pl-5">
            <li>{{ 'contact.index.raccourcis.exercice'|trans|raw }}</li>
            <li>{{ 'contact.index.raccourcis.organisations'|trans({lien: path('app_organizations')})|raw }}</li>
            {% if app.user %}<li>{{ 'contact.index.raccourcis.compte'|trans({lien: path('app_account')})|raw }}</li>{% endif %}
        </ul>

        {{ include('contact/_form.html.twig', {submitLabel: 'contact.index.envoyer'|trans}) }}
    </main>
{% endblock %}
