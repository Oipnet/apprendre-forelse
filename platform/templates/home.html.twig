{% extends 'base.html.twig' %}

{#
  @theme Point de surcharge : la page d'accueil, faite de sections qui se surchargent une à une (home/_hero,
  home/_promise, home/_how, home/_showcase, home/_tracks, home/_ai, home/_audience, home/_author, home/_signup,
  home/_faq). Remplacer ce fichier change leur ordre, ou en retire.
  Variables : tracks, upcoming, faq, tryUrl, tryPractice (voir HomePage::home), inviteOnly (bool), theme.home
  (sections déclarées par theme.yaml : showcase, author, demo, chacune null si absente).
#}

{% block body_class %}site-page landing{% endblock %}

{% block body %}
    {# Les sections décoratives (home/_promise, _how, _ai, _audience) sont vides dans le thème default : un thème les remplit. #}
    <main class="home">
        {{ include('home/_hero.html.twig') }}

        {{ include('home/_promise.html.twig') }}

        {{ include('home/_how.html.twig') }}

        {% if theme.home.showcase %}{{ include('home/_showcase.html.twig', {showcase: theme.home.showcase}) }}{% endif %}

        {{ include('home/_tracks.html.twig') }}

        {{ include('home/_ai.html.twig') }}

        {{ include('home/_audience.html.twig') }}

        {% if theme.home.author %}{{ include('home/_author.html.twig') }}{% endif %}

        {{ include('home/_signup.html.twig') }}

        {{ include('home/_faq.html.twig') }}
    </main>
{% endblock %}
