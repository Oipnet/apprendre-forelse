{% extends 'base.html.twig' %}

{% block title %}Mon compte · {{ theme.name }}{% endblock %}

{% macro track_tag(state) %}
    {%- set tags = {
        started: ['En cours', 'rust'],
        done: ['Terminé', 'green'],
        open: ['Accès actif', 'green'],
        free: ['Gratuit', 'green'],
        not_started: ['Non démarré', 'muted'],
    } -%}
    <span class="ac-tag tag {{ {rust: 'border-highlight text-highlight', green: 'border-success text-success', muted: ''}[tags[state][1]] }}">{{ tags[state][0] }}</span>
{%- endmacro %}

{% macro next_line(row) %}
    {%- if row.state == 'done' -%}
        Parcours terminé, bravo.
    {%- elseif row.next -%}
        {{ row.completed or row.lastActivity ? 'Prochain exercice' : 'Premier exercice' }} : <strong>{{ row.next.title }}</strong>
    {%- endif -%}
{%- endmacro %}

{% macro action(row, class) %}
    {%- if row.state == 'done' -%}
        <a class="{{ class }}" href="{{ path('app_track', {trackId: row.track.id}) }}">Revoir le parcours <span aria-hidden="true">→</span></a>
    {%- elseif row.next -%}
        <a class="{{ class }}" href="{{ path('app_exercise', {trackId: row.track.id, exerciseId: row.next.id}) }}">{{ row.completed or row.lastActivity ? 'Reprendre' : 'Commencer' }} <span aria-hidden="true">→</span></a>
    {%- endif -%}
{%- endmacro %}

{% block body %}
    {% set user = app.user %}
    {% set featured = progress|filter(row => row.state == 'started')|first %}
    <main class="account mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
        {% if not user.emailVerified %}
            <div class="mb-6 flex flex-wrap items-center gap-3 rounded-md border border-highlight bg-bg-2 px-4 py-3" id="confirmation">
                <span class="font-bold text-highlight" aria-hidden="true">!</span>
                <p class="flex-1"><strong>Confirmez votre adresse {{ user.email }}.</strong> Le lien est dans l'email reçu à l'inscription. Sans adresse confirmée, un reçu ou un lien de mot de passe oublié risque de ne jamais vous parvenir.</p>
                <form method="post" action="{{ path('app_account_resend_confirmation') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <button class="btn text-sm" type="submit">Renvoyer le lien</button>
                </form>
            </div>
        {% endif %}

        <header class="flex flex-col gap-4 border-b border-line pb-6 md:flex-row md:items-end md:justify-between">
            <div>
                <h1 class="text-3xl font-semibold">Mon compte</h1>
                <p class="mt-1 text-ink-muted">{{ user.displayName }}{% if user.cohort %} · cohorte « {{ user.cohort.name }} »{% endif %}</p>
            </div>
            <dl class="ac-kpis flex gap-6 [&_dd]:text-2xl [&_dd]:font-semibold [&_div]:flex [&_div]:flex-col-reverse [&_dt]:text-sm [&_dt]:text-ink-muted">
                <div><dt>XP</dt> <dd>{{ user.xp }}</dd></div>
                <div><dt>exercice{{ completedExercises > 1 ? 's' }} réussi{{ completedExercises > 1 ? 's' }}</dt> <dd>{{ completedExercises }}</dd></div>
                <div><dt>accès actif{{ activeAccesses > 1 ? 's' }}</dt> <dd>{{ activeAccesses }}</dd></div>
            </dl>
        </header>

        <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_20rem]">
            <div class="space-y-10">
                <section id="progression">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h2 class="text-xl font-semibold">Reprendre où j'en suis</h2>
                        <a href="{{ path('app_tracks') }}">Tous les parcours →</a>
                    </div>

                    {% if featured %}
                        <article class="ac-featured mt-4 rounded-lg border border-line bg-surface p-5">
                            <div class="text-sm text-ink-muted">En cours</div>
                            <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <a class="text-lg font-semibold" href="{{ path('app_track', {trackId: featured.track.id}) }}">{{ featured.track.title }}</a>
                                    <p>{{ _self.next_line(featured) }}</p>
                                </div>
                                {{ _self.action(featured, 'btn btn-primary') }}
                            </div>
                            <div class="mt-4">
                                <div class="flex justify-between text-sm text-ink-muted"><span>{{ featured.completed }} / {{ featured.total }} exercices</span><span class="xp">{{ featured.xp }} XP</span></div>
                                <div class="mt-1 h-2 overflow-hidden rounded-full bg-bg-2" aria-hidden="true"><div class="h-full bg-accent" style="width: {{ featured.total ? max(1, (featured.completed / featured.total * 100)|round) : 0 }}%"></div></div>
                            </div>
                        </article>
                    {% endif %}

                    {% set others = featured ? progress|filter(row => row.track.id != featured.track.id) : progress %}
                    {% if others is not empty %}
                        <ul class="mt-4 space-y-3">
                            {% for row in others %}
                                <li class="rounded-lg border border-line bg-surface p-4">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2 font-medium">
                                            <a href="{{ path('app_track', {trackId: row.track.id}) }}">{{ row.track.title }}</a>
                                            {{ _self.track_tag(row.state) }}
                                        </div>
                                        <p>{{ _self.next_line(row) }}</p>
                                    </div>
                                    <div class="mt-3">
                                        <div class="flex justify-between text-sm text-ink-muted"><span>{{ row.completed }} / {{ row.total }} exercices</span><span class="{{ row.xp ? 'xp' }}">{{ row.xp }} XP</span></div>
                                        <div class="my-1 h-1.5 overflow-hidden rounded-full bg-bg-2" aria-hidden="true"><div class="h-full bg-accent" style="width: {{ row.total ? (row.completed / row.total * 100)|round : 0 }}%"></div></div>
                                        {{ _self.action(row, 'btn mt-2') }}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% elseif not featured %}
                        <p class="text-sm text-ink-muted">Aucun parcours ouvert pour l'instant. <a href="{{ path('app_tracks') }}">Choisir un parcours</a> : le premier chapitre est toujours gratuit.</p>
                    {% endif %}
                </section>

                <section id="profil">
                    <h2 class="text-xl font-semibold">Profil</h2>
                    <p class="mt-1 text-ink-muted">Votre pseudo s'affiche en haut des pages{% if user.cohort %} et dans le suivi de votre cohorte{% endif %}.</p>
                    <div class="mt-4 space-y-4">
                        <div class="rounded-lg border border-line bg-surface p-4">
                            {{ form_start(profileForm) }}
                                {{ form_row(profileForm.displayName) }}
                                {{ form_row(profileForm.email) }}
                                {% if profileForm.currentPassword is defined %}
                                    {{ form_row(profileForm.currentPassword, {attr: {placeholder: '••••••••'}}) }}
                                {% elseif not recentSignIn %}
                                    <p class="text-sm text-ink-muted">Pour changer d'adresse, confirmez d'abord votre identité avec {% for name, identity in identities|filter((identity, name) => oauth.get(name)) %}{{ not loop.first ? (loop.last ? ' ou ' : ', ') }}<a href="{{ path('app_oauth_start', {fournisseur: name, mode: 'confirmer', suite: path('app_account') ~ '#profil'}) }}">{{ oauth.label(name) }}</a>{% else %}un compte lié{% endfor %}.</p>
                                {% endif %}
                                {{ form_errors(profileForm) }}
                                <button class="btn btn-primary" type="submit">Enregistrer</button>
                            {{ form_end(profileForm) }}
                        </div>
                        <div class="rounded-lg border border-line bg-surface p-4" id="mot-de-passe">
                            <div class="mb-3 font-semibold">Mot de passe</div>
                            {% if user.hasPassword %}
                                {{ form_start(passwordForm) }}
                                    {{ form_row(passwordForm.currentPassword, {attr: {placeholder: '••••••••'}}) }}
                                    {{ form_row(passwordForm.plainPassword, {attr: {placeholder: '8 caractères minimum'}}) }}
                                    <button class="btn" type="submit">Changer le mot de passe</button>
                                {{ form_end(passwordForm) }}
                            {% else %}
                                <p class="text-sm text-ink-muted">Vous vous connectez avec {{ identities|keys|map(name => oauth.label(name))|join(', ', ' ou ') }}. Pour pouvoir aussi vous connecter avec votre adresse, choisissez un mot de passe avec <a href="{{ path('app_forgot_password_request') }}">« Mot de passe oublié ? »</a> : le lien part à {{ user.email }}.</p>
                            {% endif %}
                        </div>
                        {# Un fournisseur activé, ou retiré de la configuration mais encore lié : on peut toujours le délier. #}
                        {% set shown = oauthProviders|map(provider => provider.name)|merge(identities|keys)|reduce((names, name) => name in names ? names : names|merge([name]), []) %}
                        {% for name in shown %}
                            {% set identity = identities[name] ?? null %}
                            {% set label = oauth.label(name) %}
                            <div class="rounded-lg border border-line bg-surface p-4" id="{{ name }}">
                                <div class="mb-2 font-semibold">{{ label }}</div>
                                {% if identity %}
                                    <p class="text-sm text-ink-muted">Lié au compte {{ label }} <strong>{{ identity.username }}</strong> depuis le {{ identity.linkedAt|date('d/m/Y') }} : vous pouvez vous connecter avec.</p>
                                    {% if user.hasPassword or identities|length > 1 %}
                                        <form method="post" action="{{ path('app_account_oauth_unlink', {fournisseur: name}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                            <button class="btn text-sm" type="submit">Délier {{ label }}</button>
                                        </form>
                                    {% else %}
                                        <p class="text-sm text-ink-muted">C'est votre seul moyen de connexion : pour le délier, choisissez d'abord un mot de passe.</p>
                                    {% endif %}
                                {% else %}
                                    <p class="text-sm text-ink-muted">Liez votre compte {{ label }} pour vous connecter sans mot de passe.</p>
                                    <a class="btn text-sm" href="{{ path('app_oauth_start', {fournisseur: name, mode: 'lier'}) }}">Lier mon compte {{ label }}</a>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>

                <section id="suppression">
                    <details class="group rounded-lg border border-danger"{% if deleteOpen %} open{% endif %}>
                        <summary class="flex cursor-pointer list-none flex-wrap items-start gap-4 p-4">
                            <span class="flex-1 text-sm">
                                <span class="block font-semibold text-danger">Supprimer mon compte</span>
                                <span>Votre compte, votre code, votre progression, vos avis et vos accès aux parcours sont effacés tout de suite. <strong>Un parcours acheté ne sera plus accessible</strong> ; l'achat reste dans notre comptabilité, sans lien avec vous. C'est irréversible.</span>
                            </span>
                            <span class="btn border-danger text-danger" aria-hidden="true"><span class="group-open:hidden">Supprimer mon compte</span><span class="hidden group-open:inline">Annuler</span></span>
                        </summary>
                        <div class="border-t border-danger p-4">
                            {{ form_start(deleteForm) }}
                                {{ form_errors(deleteForm) }}
                                {% if deleteForm.password is defined %}
                                    {{ form_row(deleteForm.password, {label: 'Votre mot de passe, pour confirmer'}) }}
                                {% elseif not recentSignIn %}
                                    <p>Confirmez d'abord votre identité avec {% for name, identity in identities|filter((identity, name) => oauth.get(name)) %}{{ not loop.first ? (loop.last ? ' ou ' : ', ') }}<a href="{{ path('app_oauth_start', {fournisseur: name, mode: 'confirmer', suite: path('app_account') ~ '#suppression'}) }}">{{ oauth.label(name) }}</a>{% else %}un compte lié{% endfor %}, puis revenez ici.</p>
                                {% endif %}
                                <button class="btn btn-danger" type="submit">Supprimer définitivement</button>
                            {{ form_end(deleteForm) }}
                        </div>
                    </details>
                </section>
            </div>

            <aside class="space-y-4">
                <div class="rounded-lg border border-line bg-surface p-4" id="acces">
                    <div class="mb-2 font-semibold">Mes accès</div>
                    {% if accesses is empty %}
                        <p class="text-sm text-ink-muted">Aucun accès pour l'instant. Le premier chapitre de chaque parcours est gratuit.</p>
                    {% else %}
                        <ul class="space-y-3">
                            {% for access in accesses %}
                                {% set track = tracks[access.trackId] ?? null %}
                                {% set state = access.active(now) ? 'actif' : (access.startsAt > now ? 'à venir' : 'terminé') %}
                                <li>
                                    <div class="flex items-center justify-between gap-2">
                                        {% if track %}<a href="{{ path('app_track', {trackId: track.id}) }}">{{ track.title }}</a>{% else %}<span>{{ access.trackId }}</span>{% endif %}
                                        <span class="ac-tag tag {{ state == 'actif' ? 'border-success text-success' }}">{{ state }}</span>
                                    </div>
                                    <div class="text-sm text-ink-muted">{{ access.source.label }}{% if access.cohort %} ({{ access.cohort.name }}){% endif %} · {{ access.endsAt ? 'jusqu\'au ' ~ access.endsAt|date('d/m/Y') : 'à vie' }}</div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

                <div class="rounded-lg border border-line bg-surface p-4" id="achats">
                    <div class="mb-2 font-semibold">Mes achats</div>
                    {% if purchases is empty %}
                        <p class="text-sm text-ink-muted">Aucun pour l'instant.</p>
                    {% else %}
                        <ul class="space-y-3">
                            {% for purchase in purchases %}
                                {% set track = tracks[purchase.trackId] ?? null %}
                                <li>
                                    <div class="flex items-center justify-between gap-2">
                                        <span>{{ track ? track.title : purchase.trackId }}</span>
                                        <span class="font-mono">{{ (purchase.amountPaid ?? purchase.price)|euros }}</span>
                                    </div>
                                    <div class="text-sm text-ink-muted">{{ purchase.createdAt|date('d/m/Y') }} · {{ purchase.status.label }}</div>
                                    {% if purchase.stripeInvoiceId or purchase.receiptUrl %}
                                        <div class="mt-1 flex gap-3">
                                            {% if purchase.stripeInvoiceId %}<a href="{{ path('app_account_invoice', {id: purchase.id}) }}">Facture (PDF)</a>{% endif %}
                                            {% if purchase.receiptUrl %}<a href="{{ purchase.receiptUrl }}" target="_blank" rel="noopener">Reçu</a>{% endif %}
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

                <div class="space-y-3 rounded-lg border border-line bg-bg-2 p-4">
                    <div class="font-semibold">Pratique</div>
                    <p>{{ practiceCompleted ? practiceCompleted ~ ' exercice' ~ (practiceCompleted > 1 ? 's' : '') ~ ' réussi' ~ (practiceCompleted > 1 ? 's' : '') ~ ' hors parcours.' : 'De courts exercices hors parcours, sur une fonctionnalité précise.' }}</p>
                    <a class="btn" href="{{ path('app_practice') }}">Voir les exercices <span aria-hidden="true">→</span></a>
                </div>
            </aside>
        </div>
    </main>
{% endblock %}
