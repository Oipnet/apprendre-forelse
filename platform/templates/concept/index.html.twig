{% extends 'base.html.twig' %}

{#
  L'index des notions : la porte d'entrée de qui cherche « les filtres Twig » plutôt qu'un parcours.
  Variables : concepts (list<{name, slug, exercises}>).
#}
{% block title %}Les notions travaillées · Forelse{% endblock %}

{% block body %}
    <main class="page concepts-page">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li aria-current="page">Les notions</li>
            </ol>
        </nav>

        <h1>Les notions travaillées</h1>
        <p class="lead">Chaque exercice annonce ce qu'il fait travailler. Voici toutes ces notions, et par où les pratiquer.</p>

        {% if concepts %}
            <ul class="concepts-list">
                {% for concept in concepts %}
                    <li>
                        <a href="{{ path('app_concept', {slug: concept.slug}) }}">{{ concept.name }}</a>
                        <span class="meta">{{ concept.exercises }} exercice{{ concept.exercises > 1 ? 's' }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucune notion n'est encore travaillée par plus d'un exercice.</p>
        {% endif %}
    </main>
{% endblock %}
