{% extends 'base.html.twig' %}

{#
  L'index des notions : la porte d'entrée de qui cherche « les filtres Twig » plutôt qu'un parcours.
  Variables : concepts (list<{name, slug, exercises}>).
#}
{% block title %}Les notions travaillées · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="concepts-page mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li aria-current="page">Les notions</li>
            </ol>
        </nav>

        <h1 class="mt-3 text-3xl font-semibold">Les notions travaillées</h1>
        <p class="lead mt-3 text-lg text-ink-muted">Chaque exercice annonce ce qu'il fait travailler. Voici toutes ces notions, et par où les pratiquer.</p>

        {% if concepts %}
            <ul class="concepts-list mt-8 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                {% for concept in concepts %}
                    <li>
                        <a href="{{ path('app_concept', {slug: concept.slug}) }}">{{ concept.name }}</a>
                        <span class="text-sm text-ink-muted">{{ concept.exercises }} exercice{{ concept.exercises > 1 ? 's' }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="mt-8">Aucune notion n'est encore travaillée par plus d'un exercice.</p>
        {% endif %}
    </main>
{% endblock %}
