{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'security.oauth_register.titre_page'|trans({fournisseur: provider.label, site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ 'security.oauth_register.titre'|trans }}</h1>
        <p class="text-sm text-ink-muted">{{ 'security.oauth_register.profil'|trans({fournisseur: provider.label|e, identifiant: profile.username|e, email: profile.primaryEmail|e})|raw }}</p>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.invitationCode) }}
            <p class="text-sm text-ink-muted">{{ 'security.commun.confidentialite'|trans({lien: path('app_privacy')})|raw }}</p>
            <button class="btn btn-primary w-full" type="submit">{{ 'security.commun.creer_mon_compte'|trans }}</button>
        {{ form_end(form) }}
        {% if inviteOnly %}
            <p class="text-sm text-ink-muted">{{ 'security.commun.liste_attente'|trans({lien: path('app_home') ~ '#liste-attente'})|raw }}</p>
        {% endif %}
    </main>
{% endblock %}
