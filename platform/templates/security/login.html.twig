{% extends 'base.html.twig' %}

{% block title %}Connexion · {{ marque.name }}{% endblock %}

{% block body %}
    <main class="form-card">
        <h1>Connexion</h1>
        {% if error %}
            <div class="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <form method="post">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
            <p class="meta"><a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a></p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="primary" type="submit">Se connecter</button>
        </form>
        <p class="meta">Pas encore de compte ? <a href="{{ path('app_register') }}">Créez-en un</a>.</p>
    </main>
{% endblock %}
