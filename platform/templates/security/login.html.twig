{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'security.login.titre_page'|trans({site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ 'security.login.titre'|trans }}</h1>
        {% if error %}
            <div class="alert rounded-md border border-danger bg-danger-bg px-4 py-3 text-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <form class="space-y-4" method="post">
            <div><label class="mb-1 block font-medium" for="email">{{ 'security.login.email'|trans }}</label>
            <input class="field" type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus></div>
            <div><label class="mb-1 block font-medium" for="password">{{ 'security.login.mot_de_passe'|trans }}</label>
            <input class="field" type="password" id="password" name="password" autocomplete="current-password" required></div>
            <label class="checkbox flex items-center gap-2"><input class="accent-accent" type="checkbox" name="_remember_me" value="1"> {{ 'security.login.rester_connecte'|trans }}</label>
            <p class="text-sm text-ink-muted"><a href="{{ path('app_forgot_password_request') }}">{{ 'security.login.mot_de_passe_oublie'|trans }}</a></p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            {% if suite %}
                {# Après la connexion, la page d'où l'on vient ; après un échec, ce même formulaire, qui s'en souvient. #}
                <input type="hidden" name="_target_path" value="{{ suite }}">
                <input type="hidden" name="_failure_path" value="{{ path('app_login', {suite: suite}) }}">
            {% endif %}
            <button class="btn btn-primary w-full" type="submit">{{ 'security.login.se_connecter'|trans }}</button>
        </form>
        {% if oauth.enabled %}
            <div class="oauth space-y-2 border-t border-line pt-4">
                {% for provider in oauth.enabled %}
                    <a class="btn w-full" href="{{ path('app_oauth_start', {fournisseur: provider.name}|merge(suite ? {suite: suite} : {})) }}">{{ 'security.login.continuer_avec'|trans({fournisseur: provider.label}) }}</a>
                {% endfor %}
            </div>
        {% endif %}
        <p class="text-sm text-ink-muted">{{ 'security.login.pas_de_compte'|trans({lien: path('app_register', suite ? {suite: suite} : {})})|raw }}</p>
    </main>
{% endblock %}
