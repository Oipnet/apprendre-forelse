{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'security.reset_password.reset.titre_page'|trans({site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ 'security.reset_password.reset.titre'|trans }}</h1>
        {{ form_start(form) }}
            {{ form_row(form.plainPassword) }}
            <button class="btn btn-primary w-full" type="submit">{{ 'security.reset_password.reset.envoyer'|trans }}</button>
        {{ form_end(form) }}
    </main>
{% endblock %}
