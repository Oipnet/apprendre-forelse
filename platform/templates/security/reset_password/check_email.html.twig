{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'security.reset_password.check_email.titre_page'|trans({site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ 'security.reset_password.check_email.titre'|trans }}</h1>
        <p>{{ 'security.reset_password.check_email.texte'|trans({duree: resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
        <p class="text-sm text-ink-muted">{{ 'security.reset_password.check_email.rien_recu'|trans({lien: path('app_forgot_password_request')})|raw }}</p>
    </main>
{% endblock %}
