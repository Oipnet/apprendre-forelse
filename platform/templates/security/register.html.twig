{% extends 'base.html.twig' %}

{% block title %}Créer un compte · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">Créer un compte</h1>
        <p class="text-sm text-ink-muted">{{ inviteOnly ? 'Bêta sur invitation. ' : 'Gratuit. ' }}Votre progression et votre XP sont sauvegardées.</p>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {% if form.invitationCode is defined %}{{ form_row(form.invitationCode) }}{% endif %}
            {{ form_row(form.displayName) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword) }}
            <p class="text-sm text-ink-muted">Votre adresse ne sert qu'à votre compte : <a href="{{ path('app_privacy') }}">politique de confidentialité</a>.</p>
            <button class="btn btn-primary w-full" type="submit">Créer mon compte</button>
        {{ form_end(form) }}
        {% if oauth.enabled %}
            <div class="oauth space-y-2 border-t border-line pt-4">
                {% for provider in oauth.enabled %}
                    <a class="btn w-full" href="{{ path('app_oauth_start', {fournisseur: provider.name}|merge(app.request.query.get('suite') ? {suite: app.request.query.get('suite')} : {})) }}">S'inscrire avec {{ provider.label }}</a>
                {% endfor %}
                <p class="text-sm text-ink-muted">Sans mot de passe : votre adresse est celle que le service a vérifiée.</p>
            </div>
        {% endif %}
        <p class="text-sm text-ink-muted">Déjà inscrit ? <a href="{{ path('app_login', {suite: app.request.query.get('suite')}) }}">Connectez-vous</a>.</p>
        {% if inviteOnly %}
            <p class="text-sm text-ink-muted">Pas de code d'invitation ? <a href="{{ path('app_home') }}#liste-attente">Laissez votre adresse sur la liste d'attente</a> : vous serez prévenu à l'ouverture.</p>
        {% endif %}
    </main>
{% endblock %}
