{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'security.register.titre_page'|trans({site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ 'security.register.titre'|trans }}</h1>
        <p class="text-sm text-ink-muted">{{ (inviteOnly ? 'security.register.intro_invitation' : 'security.register.intro')|trans }}</p>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {% if form.invitationCode is defined %}{{ form_row(form.invitationCode) }}{% endif %}
            {{ form_row(form.displayName) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword) }}
            <p class="text-sm text-ink-muted">{{ 'security.commun.confidentialite'|trans({lien: path('app_privacy')})|raw }}</p>
            <button class="btn btn-primary w-full" type="submit">{{ 'security.commun.creer_mon_compte'|trans }}</button>
        {{ form_end(form) }}
        {% if oauth.enabled %}
            <div class="oauth space-y-2 border-t border-line pt-4">
                {% for provider in oauth.enabled %}
                    <a class="btn w-full" href="{{ path('app_oauth_start', {fournisseur: provider.name}|merge(app.request.query.get('suite') ? {suite: app.request.query.get('suite')} : {})) }}">{{ 'security.register.inscription_avec'|trans({fournisseur: provider.label}) }}</a>
                {% endfor %}
                <p class="text-sm text-ink-muted">{{ 'security.register.sans_mot_de_passe'|trans }}</p>
            </div>
        {% endif %}
        <p class="text-sm text-ink-muted">{{ 'security.register.deja_inscrit'|trans({lien: path('app_login', {suite: app.request.query.get('suite')})})|raw }}</p>
        {% if inviteOnly %}
            <p class="text-sm text-ink-muted">{{ 'security.commun.liste_attente'|trans({lien: path('app_home') ~ '#liste-attente'})|raw }}</p>
        {% endif %}
    </main>
{% endblock %}
