{% extends 'studio/_chrome.html.twig' %}

{% block title %}Pratique · Atelier · {{ theme.name }}{% endblock %}

{% block body %}
    <main>
        <div class="flex flex-wrap items-center gap-2">
            <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
                <a class="text-sm" href="{{ path('app_studio') }}"><span aria-hidden="true">←</span> Tous les parcours</a>
                <div class="flex flex-col gap-4 border-b border-line pb-6 md:flex-row md:justify-between">
                    <div class="md:max-w-2xl">
                        <div class="flex flex-wrap items-center gap-2">
                            <h1 class="mt-1 text-3xl font-semibold">Exercices de pratique</h1>
                        </div>
                        <p class="lead mt-2 text-lg text-ink-muted">Les courts exercices hors parcours : ils n'appartiennent à aucun chapitre, ne rapportent pas d'XP, et paraissent à la date qu'ils portent.</p>
                    </div>
                    <div class="st-track-actions flex flex-wrap gap-2">
                        <a class="btn" href="{{ path('app_practice') }}">Voir la page publique</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
            {% if pratique %}
                <ol class="st-exercises divide-y divide-line border-t border-line mt-6 space-y-3">
                    {% for practice in pratique %}
                        <li>
                            <a href="{{ path('app_studio_exercise_pratique', {exerciseId: practice.exercise.id}) }}">
                                <span class="font-mono">{{ loop.index }}</span>
                                <span class="flex-1">{{ practice.exercise.title }}</span>
                                <span class="font-mono text-xs text-ink-muted">{{ practice.exercise.id }}</span>
                                {% if practice.isRestricted %}<span class="tag draft">En préparation</span>{% endif %}
                                {% if practice_scheduled(practice) %}<span class="tag draft">Programmé</span>{% endif %}
                                {% if practice.version %}<span class="tag live">{{ practice.framework }} {{ practice.version }}</span>{% endif %}
                                <span class="text-sm text-ink-muted">{{ practice.packId }} · {{ practice.published|date('d/m/Y') }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            {% else %}
                <div class="st-empty rounded-lg border border-dashed border-line p-8 text-center">
                    <p>Aucun exercice de Pratique dans les packs installés.</p>
                </div>
            {% endif %}

            {% if packsModifiables %}
                <div class="st-chapter-foot flex flex-wrap gap-3 border-t border-line p-3 text-sm mt-6 rounded-lg border border-dashed border-line p-4">
                    <details class="mt-4 rounded-lg border border-dashed border-line p-4"{{ pratique ? '' : ' open' }}>
                        <summary class="cursor-pointer font-medium text-accent">Ajouter un exercice <span aria-hidden="true">+</span></summary>
                        <form class="nouvel-exercice" data-nouveau="{{ path('app_studio_create_pratique') }}">
                            <input class="field" name="id" placeholder="symfony-8-1-map-query-string" required pattern="[a-z0-9][a-z0-9-]*" aria-label="Identifiant">
                            <input class="field" name="titre" placeholder="Lire la requête avec #[MapQueryString]" required aria-label="Titre">
                            <select class="field" name="pack" aria-label="Pack">
                                {% for pack in packsModifiables %}
                                    <option value="{{ pack.id }}">{{ pack.title }}</option>
                                {% endfor %}
                            </select>
                            <select class="field" name="environnement" aria-label="Environnement">
                                {% for environnement in environnements %}
                                    <option value="{{ environnement }}">{{ environnement }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary">Créer l'exercice</button>
                            <span class="erreur text-sm text-danger" role="alert"></span>
                        </form>
                    </details>
                </div>
            {% else %}
                <p class="st-hint text-sm text-ink-muted">Aucun pack modifiable : l'atelier ne peut créer un exercice que dans un pack où il a le droit d'écrire.</p>
            {% endif %}
        </div>
    </main>
{% endblock %}
