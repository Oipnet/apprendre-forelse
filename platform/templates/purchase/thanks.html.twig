{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'purchase.thanks.titre_page'|trans({site: theme.name}) }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Paiement pas encore confirmé par Stripe : la page se recharge seule. #}
    {% if purchase.status.value == 'pending' %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        {% if purchase.status.value == 'paid' %}
            <h1 class="text-2xl font-semibold">{{ 'purchase.thanks.paye.titre'|trans }}</h1>
            <p>{{ (track ? 'purchase.thanks.paye.texte_parcours' : 'purchase.thanks.paye.texte')|trans({parcours: track ? track.title : ''}) }}</p>
            {% if track %}<a class="btn btn-primary" href="{{ path('app_track', {trackId: track.id}) }}">{{ 'purchase.thanks.paye.aller'|trans }}</a>{% endif %}
            {% if purchase.receiptUrl %}<p class="text-sm text-ink-muted"><a href="{{ purchase.receiptUrl }}" target="_blank" rel="noopener">{{ 'purchase.thanks.paye.recu'|trans }}</a></p>{% endif %}
        {% elseif purchase.status.value == 'pending' %}
            <h1 class="text-2xl font-semibold">{{ 'purchase.thanks.en_attente.titre'|trans }}</h1>
            <p role="status">{{ 'purchase.thanks.en_attente.texte'|trans }}</p>
            <p class="text-sm text-ink-muted">{{ 'purchase.thanks.en_attente.rien_ne_bouge'|trans({lien_page: path('app_purchase_thanks', {id: purchase.id}), lien_compte: path('app_account')})|raw }}</p>
        {% elseif purchase.status.value == 'abandoned' %}
            <h1 class="text-2xl font-semibold">{{ 'purchase.thanks.abandonne.titre'|trans }}</h1>
            <p>{{ 'purchase.thanks.abandonne.texte'|trans }}</p>
            {% if track %}<a class="btn btn-primary" href="{{ path('app_purchase', {trackId: track.id}) }}">{{ 'purchase.thanks.abandonne.reessayer'|trans }}</a>{% endif %}
        {% elseif purchase.status.value == 'disputed' %}
            <h1 class="text-2xl font-semibold">{{ 'purchase.thanks.conteste.titre'|trans }}</h1>
            <p>{{ 'purchase.thanks.conteste.texte'|trans }}</p>
        {% else %}
            <h1 class="text-2xl font-semibold">{{ 'purchase.thanks.rembourse.titre'|trans }}</h1>
            <p>{{ 'purchase.thanks.rembourse.texte'|trans }}</p>
        {% endif %}
    </main>
{% endblock %}
