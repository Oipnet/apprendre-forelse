{% extends 'base.html.twig' %}

{% trans_default_domain 'compte' %}

{% block title %}{{ 'purchase.checkout.titre_page'|trans({parcours: track.title, site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="form-card mx-auto my-10 w-full max-w-md space-y-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <h1 class="text-2xl font-semibold">{{ track.title }}</h1>
        <p class="price text-xl">
            {% if offer.quote.discounted %}<s class="text-sm text-ink-muted" aria-label="{{ 'purchase.checkout.prix_normal'|trans }}">{{ offer.quote.normalPrice|euros }}</s>{% endif %}
            <strong>{{ offer.quote.price|euros }}</strong> <span class="text-sm text-ink-muted">{{ 'purchase.checkout.ttc'|trans }}</span>
        </p>
        <p><strong>{{ 'purchase.checkout.acces_a_vie'|trans }}</strong></p>
        {% if offer.quote.founder %}
            <p class="text-sm text-ink-muted">{{ ('purchase.checkout.fondateur.' ~ (offer.quote.founderSeatsLeft is not null ? 'places' : 'sans_places') ~ (offer.quote.founderEndsAt ? '_date' : ''))|trans({places: offer.quote.founderSeatsLeft ?? 0, date: offer.quote.founderEndsAt ? offer.quote.founderEndsAt|format_date('short') : ''}) }}</p>
        {% elseif offer.quote.cohort %}
            <p class="text-sm text-ink-muted">{{ 'purchase.checkout.cohorte'|trans({nom: offer.quote.cohort.name}) }}</p>
        {% endif %}
        <p class="text-sm text-ink-muted">{{ 'purchase.checkout.tva'|trans }}</p>

        {{ form_start(form) }}
            <div class="waiver flex items-start gap-2 [&_input]:mt-1 [&_input]:accent-accent">
                {{ form_widget(form.termsOfSale) }}
                {{ form_label(form.termsOfSale) }}
            </div>
            {{ form_errors(form.termsOfSale) }}
            <div class="waiver flex items-start gap-2 [&_input]:mt-1 [&_input]:accent-accent">
                {{ form_widget(form.withdrawalWaiver) }}
                {{ form_label(form.withdrawalWaiver) }}
            </div>
            {{ form_errors(form.withdrawalWaiver) }}
            <button class="btn btn-primary w-full" type="submit">{{ 'purchase.checkout.payer'|trans({prix: offer.quote.price|euros}) }}</button>
        {{ form_end(form) }}
        <p class="text-sm text-ink-muted"><a href="{{ path('app_track', {trackId: track.id}) }}">{{ 'purchase.checkout.retour'|trans }}</a></p>
    </main>
{% endblock %}
