<!DOCTYPE html>
<html lang="fr" data-host-origin="{{ host_origin }}">
    <head>
        <meta charset="UTF-8">
        <title>Aperçu</title>
        <style>
            html, body { margin: 0; height: 100%; background: #fff; }
            iframe { border: 0; width: 100%; height: 100%; display: block; }
        </style>
        {{ vite_entry_script_tags('sandbox') }}
    </head>
    <body>
        {# Mêmes droits que l'iframe du relais côté plateforme, qui les impose de toute façon :
           rien pour naviguer la page parente. allow-same-origin laisse le Service Worker servir l'aperçu. #}
        <iframe id="preview" title="Aperçu de l'application" sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-popups allow-downloads"></iframe>
    </body>
</html>
