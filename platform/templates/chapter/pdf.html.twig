{# Fiche de cours d'un chapitre en PDF. #}
{% trans_default_domain 'certificat' %}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'chapter.pdf.titre'|trans({chapitre: chapter.title}) }}</title>
    {{ include('chapter/_pdf_styles.html.twig') }}
</head>
<body>
    <div class="cover">
        <p class="pack">{{ pack.title }}</p>
        <p class="track">{{ track.title }}</p>
        <p class="number">{{ 'chapter.chapitre'|trans({numero: number}) }}</p>
        <h1>{{ chapter.title }}</h1>
        {% if concepts %}
            <p class="concepts">{% for concept in concepts %}<span>{{ concept }}</span>{% endfor %}</p>
        {% endif %}
        <p class="learner">
            {{ (xp ? 'chapter.pdf.etablie_xp_html' : 'chapter.pdf.etablie_html')|trans({nom: user.displayName|e, date: date|format_date('short')|e, exercices: chapter.exerciseIds|length, xp: xp})|raw }}
        </p>
    </div>
    <div class="lesson">{{ html|raw }}</div>
</body>
</html>
