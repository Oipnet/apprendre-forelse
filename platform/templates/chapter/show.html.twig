{% extends 'base.html.twig' %}
{% trans_default_domain 'apprentissage' %}

{% block title %}{{ chapter.title }} · {{ 'chapter.show.fiche'|trans }} · {{ theme.name }}{% endblock %}

{% block body %}
    <main class="lesson-page mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <p class="text-sm text-ink-muted"><a href="{{ path('app_track', {trackId: track.id}) }}">{{ track.title }}</a> · {{ 'commun.chapitre_numero'|trans({numero: number}) }}</p>
        <h1 class="mt-2 text-3xl font-semibold">{{ chapter.title }}</h1>
        <p class="lead mt-3 text-lg text-ink-muted">{{ 'chapter.show.intro'|trans }}</p>

        <div class="lesson-summary mt-6 flex flex-wrap items-center gap-3 rounded-lg border border-line bg-bg-2 p-4">
            {% if concepts %}
                <p class="concepts flex flex-wrap gap-1.5">{% for concept in concepts %}<span class="tag">{{ concept }}</span>{% endfor %}</p>
            {% endif %}
            <p class="text-sm text-ink-muted">{{ 'chapter.show.exercices'|trans({n: chapter.exerciseIds|length}) }}{% if xp %} · ⭐ {{ 'chapter.show.xp_gagnes'|trans({xp: xp}) }}{% endif %}</p>
            <a class="btn btn-primary ml-auto" href="{{ path('app_chapter_pdf', {trackId: track.id, chapterId: chapter.id}) }}">{{ 'chapter.show.pdf'|trans }}</a>
        </div>

        <article class="lesson prose prose-theme mt-8 max-w-none">{{ html|raw }}</article>

        <nav class="lesson-nav mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-6">
            <a class="btn" href="{{ path('app_track', {trackId: track.id}) }}">{{ 'commun.retour_parcours'|trans }}</a>
            {% if nextExercise %}
                <a class="btn btn-primary" href="{{ path('app_exercise', {trackId: track.id, exerciseId: nextExercise.id}) }}">{{ 'chapter.show.suivant'|trans({titre: nextChapter.title}) }}</a>
            {% endif %}
        </nav>
    </main>
{% endblock %}
