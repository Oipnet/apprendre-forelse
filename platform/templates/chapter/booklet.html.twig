{# Livret d'un parcours : toutes les fiches de cours, derrière une page de garde et un sommaire. #}
{% trans_default_domain 'certificat' %}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'chapter.booklet.titre'|trans({parcours: track.title}) }}</title>
    {{ include('chapter/_pdf_styles.html.twig') }}
    <style>
        .toc h2 { font-size: 15pt; margin: 0 0 12pt; }
        .toc ol { padding-left: 0; list-style: none; }
        .toc li { margin: 0 0 8pt; padding-bottom: 8pt; border-bottom: 1px solid #eee; }
        .toc .number { color: #7c6cf2; font-weight: bold; margin-right: 8pt; }
        .toc .concepts { color: #777; font-size: 9pt; margin: 2pt 0 0 0; }
        .chapter-head { page-break-before: always; margin: 0 0 18pt; padding-bottom: 8pt; border-bottom: 2px solid #7c6cf2; }
        .chapter-head .number { color: #7c6cf2; font-size: 11pt; font-weight: bold; margin: 0; }
        .chapter-head h1 { font-size: 20pt; margin: 2pt 0 6pt; }
        .chapter-head .concepts span { display: inline-block; padding: 1pt 7pt; margin: 0 4pt 4pt 0; border: 1px solid #ccc; border-radius: 10pt; font-size: 8.5pt; color: #555; }
    </style>
</head>
<body>
    <div class="cover">
        <p class="pack">{{ pack.title }}</p>
        <p class="number">{{ 'chapter.booklet.surtitre'|trans }}</p>
        <h1>{{ track.title }}</h1>
        {% if track.description %}<p class="track">{{ track.description }}</p>{% endif %}
        <p class="learner">
            {{ (xp ? 'chapter.booklet.etabli_xp_html' : 'chapter.booklet.etabli_html')|trans({nom: user.displayName|e, date: date|format_date('short')|e, exercices: track.exerciseIds|length, xp: xp})|raw }}
        </p>
    </div>

    <div class="toc">
        <h2>{{ 'chapter.booklet.sommaire'|trans }}</h2>
        <ol>
            {% for item in chapters %}
                <li>
                    <span class="number">{{ item.number }}</span> {{ item.chapter.title }}
                    {% if item.concepts %}<p class="concepts">{{ item.concepts|join(' · ') }}</p>{% endif %}
                </li>
            {% endfor %}
        </ol>
    </div>

    {% for item in chapters %}
        <div class="chapter-head">
            <p class="number">{{ 'chapter.chapitre'|trans({numero: item.number}) }}</p>
            <h1>{{ item.chapter.title }}</h1>
            {% if item.concepts %}<p class="concepts">{% for concept in item.concepts %}<span>{{ concept }}</span>{% endfor %}</p>{% endif %}
        </div>
        <div class="lesson">{{ item.html|raw }}</div>
    {% endfor %}
</body>
</html>
