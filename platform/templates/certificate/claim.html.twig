{% extends 'base.html.twig' %}
{% trans_default_domain 'certificat' %}

{# Demander le certificat d'un parcours terminé : le nom à imprimer, confirmé une fois pour toutes. Variables : track, form, unconfirmed (réussites pas encore confirmées par le serveur, form est alors null), previous. #}
{% block title %}{{ 'claim.titre'|trans({parcours: track.title, site: theme.name}) }}{% endblock %}

{% block body %}
    <main class="certificate-claim mx-auto w-full max-w-xl px-4 py-10 sm:px-6">
        <p class="text-sm text-ink-muted"><a href="{{ path('app_track', {trackId: track.id}) }}">{{ track.title }}</a></p>
        <h1 class="mt-1 text-3xl font-semibold">{{ 'claim.h1'|trans }}</h1>
        <p class="lead mt-3 text-ink-muted">{{ 'claim.intro'|trans }}</p>
        {% if previous and previous.revoked %}
            <p class="mt-3 text-sm text-ink-muted">{{ 'claim.precedent_revoque'|trans({code: previous.code}) }}</p>
        {% endif %}

        {% if unconfirmed %}
            <div class="certificate-unconfirmed mt-6 rounded-lg border border-line bg-surface p-4">
                {% if unconfirmed.failed %}
                    <p>{{ 'claim.echec'|trans }}</p>
                    <ul class="mt-2 list-disc pl-5">{% for title in unconfirmed.failed %}<li>{{ title }}</li>{% endfor %}</ul>
                    <p class="mt-3 text-sm text-ink-muted">{{ 'claim.echec_contact_html'|trans({url: path('app_contact', {objet: 'certificat'})|e})|raw }}</p>
                {% else %}
                    <p>{{ 'claim.verification_html'|trans({exercices: unconfirmed.pending|length})|raw }}</p>
                    <p class="mt-2 text-sm text-ink-muted">{{ 'claim.verification_duree'|trans }}</p>
                {% endif %}
            </div>
        {% else %}
            <div class="mt-6 rounded-lg border border-line bg-surface p-4">
                {{ form_start(form) }}
                    {{ form_row(form.holderName) }}
                    <button type="submit" class="btn btn-primary mt-2 w-full">{{ 'claim.obtenir'|trans }}</button>
                {{ form_end(form) }}
            </div>
        {% endif %}
    </main>
{% endblock %}
