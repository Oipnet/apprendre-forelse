{% extends 'base.html.twig' %}
{% trans_default_domain 'certificat' %}

{#
  La page de vérification d'un certificat : publique (un recruteur, une école), hors de l'index. Le détail de chaque
  exercice y est, tel qu'au jour de la délivrance. Variables : certificate, holder (le titulaire regarde), linkedinUrl, share (ses liens de partage, pour le titulaire).
  Repères lus par les tests : certificate-status, certificate-summary, certificate-mentions, certificate-exercises, certificate-contest.
#}
{% block title %}{{ 'show.titre'|trans({parcours: certificate.trackTitle, titulaire: certificate.holderName, site: theme.name}) }}{% endblock %}

{% block body %}
    {% set count = certificate.exerciseCount %}
    <main class="certificate mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
        <p class="text-sm text-ink-muted">{{ 'show.surtitre'|trans({site: theme.name}) }}</p>
        <h1 class="mt-1 text-3xl font-semibold">{{ certificate.trackTitle }}</h1>
        <p class="lead mt-3 text-lg">{{ 'show.delivre_html'|trans({titulaire: certificate.holderName|e, date: certificate.issuedAt|format_date('short')|e})|raw }}</p>

        {% if certificate.revoked %}
            <div class="certificate-status mt-4 rounded-lg border border-danger bg-danger-bg p-4">
                <p>{{ (certificate.disputed ? 'show.revoque_conteste_html' : 'show.revoque_html')|trans({date: certificate.revokedAt|format_date('short')|e})|raw }}</p>
                {% if holder %}
                    <p class="mt-1 text-sm">{{ 'show.motif'|trans({motif: certificate.revocationReason}) }}</p>
                    <a class="certificate-contest btn mt-3" href="{{ path('app_contact', {objet: 'certificat', certificat: certificate.code}) }}">{{ 'show.contester'|trans }}</a>
                {% endif %}
            </div>
        {% else %}
            <p class="certificate-status mt-4 rounded-lg border border-success bg-success-bg p-4 text-success">{{ 'show.valide'|trans({code: certificate.code}) }}</p>
        {% endif %}

        <p class="certificate-summary mt-6">
            {{ 'show.resume'|trans({exercices: count, sans_solution: certificate.withoutSolutionCount, sans_aide: certificate.unaidedCount, xp: certificate.xp|number_format(0, ',', ' ')}) }}
        </p>

        {% if certificate.mentions %}
            <ul class="certificate-mentions mt-4 space-y-1">
                {% for mention in certificate.mentions %}<li>★ {{ mention.label }}</li>{% endfor %}
            </ul>
        {% endif %}

        {% if holder and not certificate.revoked %}
            <div class="mt-6 flex flex-wrap gap-2">
                <a class="btn btn-primary" href="{{ path('app_certificate_pdf', {code: certificate.code}) }}">{{ 'show.telecharger_pdf'|trans }}</a>
                {% if linkedinUrl %}<a class="btn" href="{{ linkedinUrl }}" target="_blank" rel="noopener">{{ 'show.linkedin'|trans }}</a>{% endif %}
            </div>
            {% if share %}
                {{ include('share/_buttons.html.twig', {links: share, title: 'show.partager'|trans, mesure: {parcours: certificate.trackId}}) }}
            {% endif %}
        {% endif %}

        <h2 class="mt-10 text-xl font-semibold">{{ 'show.exercices'|trans }}</h2>
        <div class="certificate-exercises mt-4 space-y-6">
            {% for chapter, exercises in certificate.exercisesByChapter %}
                <section>
                    <h3 class="font-semibold">{{ chapter }}</h3>
                    <ul class="mt-2 divide-y divide-line text-sm">
                        {% for exercise in exercises %}
                            <li class="flex justify-between gap-4 py-1.5">
                                <span>{{ exercise.title }}</span>
                                <span class="shrink-0 {{ exercise.solutionRevealed ? 'text-highlight' : 'text-ink-muted' }}">
                                    {%- if exercise.solutionRevealed -%}
                                        {{ 'show.solution_consultee'|trans }}
                                    {%- elseif exercise.hintsUsed -%}
                                        {{ 'show.indices'|trans({indices: exercise.hintsUsed, disponibles: exercise.hintsAvailable}) }}
                                    {%- else -%}
                                        {{ 'show.sans_indice'|trans }}
                                    {%- endif -%}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>

        <p class="mt-10 text-sm text-ink-muted">
            {{ 'show.attestation'|trans({site: theme.name}) }}
            {{ 'show.pas_un_diplome'|trans }}
        </p>
    </main>
{% endblock %}
