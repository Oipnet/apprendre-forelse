{% extends 'emails/_layout.html.twig' %}

{% block preheader %}Votre certificat « {{ certificate.trackTitle }} » est de nouveau valide.{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">Bonjour {{ user.displayName }},</p>

<p style="margin:0 0 12px;">Votre certificat de réussite du parcours <strong>{{ certificate.trackTitle }}</strong> (code {{ certificate.code }}) est rétabli : sa page de vérification le montre de nouveau comme valide.</p>

{{ include('emails/_button.html.twig', {href: url('app_certificate', {code: certificate.code}), label: 'Voir le certificat'}) }}
{% endblock %}

{% block reason %}Vous recevez cet email parce que ce certificat vous a été délivré sur {{ theme.name }}.{% endblock %}
