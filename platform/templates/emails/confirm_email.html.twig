{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% block preheader %}{{ (change ? 'confirm_email.apercu_changement' : 'confirm_email.apercu')|trans({heures: hours}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ 'commun.bonjour'|trans({nom: user.displayName}) }}</p>

{% if change %}
<p style="margin:0 0 12px;">{{ 'confirm_email.changement'|trans({site: theme.name}) }}</p>
{% else %}
<p style="margin:0 0 12px;">{{ 'confirm_email.bienvenue'|trans({site: theme.name}) }}</p>
{% endif %}

{{ include('emails/_button.html.twig', {href: link, label: 'confirm_email.bouton'|trans}) }}

<p style="margin:0 0 12px;">{{ 'confirm_email.validite'|trans({heures: hours}) }}</p>

{% if change %}
<p style="margin:0;">{{ 'confirm_email.ignorer_changement'|trans }}</p>
{% else %}
<p style="margin:0;">{{ 'confirm_email.ignorer'|trans }}</p>
{% endif %}
{% endblock %}

{% block reason %}{{ 'confirm_email.raison'|trans({site: theme.name}) }}{% endblock %}
