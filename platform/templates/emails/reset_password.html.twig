{% extends 'emails/_layout.html.twig' %}

{% set link = url('app_reset_password', {token: resetToken.token}) %}
{% set validity = resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') %}

{% block preheader %}Choisissez un nouveau mot de passe : le lien est valable {{ validity }}.{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">Bonjour {{ user.displayName }},</p>

<p style="margin:0 0 4px;">Pour choisir un nouveau mot de passe sur {{ marque.name }} :</p>

{{ include('emails/_button.html.twig', {href: link, label: 'Choisir un mot de passe'}) }}

<p style="margin:0 0 12px;">Le lien est valable {{ validity }} et ne sert qu'une fois.</p>

<p style="margin:0;">Si vous n'avez rien demandé, ignorez cet email : votre mot de passe reste inchangé.</p>
{% endblock %}

{% block reason %}Vous recevez cet email parce qu'un nouveau mot de passe a été demandé pour votre compte {{ marque.name }}.{% endblock %}
