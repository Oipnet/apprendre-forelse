{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% set link = url('app_reset_password', {token: resetToken.token}) %}
{% set validity = resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') %}

{% block preheader %}{{ 'reset_password.apercu'|trans({validite: validity}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ 'commun.bonjour'|trans({nom: user.displayName}) }}</p>

<p style="margin:0 0 4px;">{{ 'reset_password.intro'|trans({site: theme.name}) }}</p>

{{ include('emails/_button.html.twig', {href: link, label: 'reset_password.bouton'|trans}) }}

<p style="margin:0 0 12px;">{{ 'reset_password.validite'|trans({validite: validity}) }}</p>

<p style="margin:0;">{{ 'reset_password.ignorer'|trans }}</p>
{% endblock %}

{% block reason %}{{ 'reset_password.raison'|trans({site: theme.name}) }}{% endblock %}
