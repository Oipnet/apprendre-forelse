{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% set title = track ? track.title : purchase.trackId %}
{% set compte = url('app_account') ~ '#achats' %}
{% set vendeur = include('emails/_seller.twig') %}
{% set couleur = theme.emailColors.accent %}

{% block preheader %}{{ 'purchase_confirmation.apercu'|trans({parcours: title}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ purchase.user ? 'commun.bonjour'|trans({nom: purchase.user.displayName}) : 'commun.bonjour_anonyme'|trans }}</p>

<p style="margin:0 0 12px;">{{ 'purchase_confirmation.merci'|trans({parcours: title}) }}</p>

{% if track %}{{ include('emails/_button.html.twig', {href: url('app_track', {trackId: track.id}), label: 'purchase_confirmation.bouton'|trans}) }}{% endif %}

<p style="margin:0 0 12px;">{% if purchase.paidAt %}{{ 'purchase_confirmation.montant_date'|trans({montant: (purchase.amountPaid ?? purchase.price)|euros, date: purchase.paidAt|format_date('short')}) }}{% else %}{{ 'purchase_confirmation.montant'|trans({montant: (purchase.amountPaid ?? purchase.price)|euros}) }}{% endif %}</p>

{# Reçu et facture : un lien chacun quand ils mènent à deux endroits, une seule ligne quand c'est le compte. #}
{% if purchase.receiptUrl %}
<p style="margin:0 0 12px;">{% if purchase.stripeInvoiceId %}{{ 'purchase_confirmation.recu_facture_html'|trans({url: purchase.receiptUrl|e, compte: compte|e, couleur: couleur|e})|raw }}{% else %}{{ 'purchase_confirmation.recu_html'|trans({url: purchase.receiptUrl|e, couleur: couleur|e})|raw }}{% endif %}</p>
{% elseif purchase.stripeInvoiceId %}
<p style="margin:0 0 12px;">{{ 'purchase_confirmation.recu_et_facture_html'|trans({compte: compte|e, couleur: couleur|e})|raw }}</p>
{% else %}
<p style="margin:0 0 12px;">{{ 'purchase_confirmation.recu_a_venir_html'|trans({compte: compte|e, couleur: couleur|e})|raw }}</p>
{% endif %}

{% if purchase.termsVersion %}<p style="margin:0 0 12px;">{{ 'purchase_confirmation.cgv_html'|trans({url: url('app_terms')|e, couleur: couleur|e, date: purchase.termsVersion|format_date('short')})|raw }}</p>{% endif %}

<p style="margin:0;">{{ 'purchase_confirmation.renonciation'|trans({date: purchase.withdrawalWaiverAcceptedAt|format_date('short'), heure: purchase.withdrawalWaiverAcceptedAt|format_time('short')}) }}</p>
{% endblock %}

{% block reason %}{{ 'purchase_confirmation.raison'|trans({site: theme.name}) }}{% endblock %}

{# vendeur : déjà échappé par emails/_seller.twig. #}
{% block legal %}{% if vendeur %}<p style="margin:6px 0 0;">{{ 'purchase_confirmation.vendeur'|trans({vendeur: vendeur ~ ''})|raw }}</p>{% endif %}{% endblock %}
