{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% set link = url('app_track', {trackId: track.id}) %}

{% block preheader %}{{ 'defense_convocation.apercu'|trans({parcours: track.title, date: defense.startsAt|format_date('short'), heure: defense.startsAt|format_time('short')}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ 'commun.bonjour'|trans({nom: learner.displayName}) }}</p>

<p style="margin:0 0 12px;">{{ 'defense_convocation.reservee'|trans({parcours: track.title}) }}</p>

{% set lieu %}{% if defense.mode.value == 'online' %}<a class="lien" href="{{ defense.place }}" style="color:{{ theme.emailColors.accent }};word-break:break-all;">{{ defense.place }}</a>{% else %}{{ defense.place }}{% endif %}{% endset %}
<p style="margin:0 0 12px;">
    {{ 'defense_convocation.quand_html'|trans({date: defense.startsAt|format_date('short')|e, heure: defense.startsAt|format_time('short')|e, minutes: defense.durationMinutes})|raw }}<br>
    {{ 'commun.libelle_valeur'|trans({libelle: defense.mode|trans|e, valeur: lieu ~ ''})|raw -}}
</p>

<p style="margin:0 0 4px;">{{ 'defense_convocation.preparation'|trans }}</p>

{{ include('emails/_button.html.twig', {href: link, label: 'defense_convocation.bouton'|trans}) }}

<p style="margin:0;">{{ 'defense_convocation.empechement'|trans }}</p>
{% endblock %}

{% block reason %}{{ 'defense_convocation.raison'|trans({site: theme.name}) }}{% endblock %}
