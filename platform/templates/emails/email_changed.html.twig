{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% block preheader %}{{ 'email_changed.apercu'|trans({site: theme.name, adresse: newEmail}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ 'commun.bonjour'|trans({nom: user.displayName}) }}</p>

<p style="margin:0 0 12px;">{{ 'email_changed.remplacee_html'|trans({site: theme.name|e, adresse: newEmail|e})|raw }}</p>

<p style="margin:0 0 12px;">{{ 'email_changed.si_c_est_vous'|trans }}</p>

{# Sans adresse de contact, l'email n'a pas de Reply-To : y répondre n'irait nulle part (voir App\Mail\Sender). #}
<p style="margin:0;">{% if contact %}{{ 'email_changed.ecrivez_nous_html'|trans({contact: contact|e, couleur: theme.emailColors.accent|e})|raw }}{% else %}{{ 'email_changed.prevenez_html'|trans({url: url('app_legal_notice')|e, couleur: theme.emailColors.accent|e})|raw }}{% endif %}</p>
{% endblock %}

{% block reason %}{{ 'email_changed.raison'|trans({site: theme.name}) }}{% endblock %}
