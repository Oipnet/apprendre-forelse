{% extends 'emails/_layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% block preheader %}{{ 'registration_attempt.apercu'|trans({site: theme.name}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ 'commun.bonjour'|trans({nom: user.displayName}) }}</p>

<p style="margin:0 0 12px;">{{ 'registration_attempt.tentative'|trans({site: theme.name}) }}</p>

<p style="margin:0 0 4px;">{{ 'registration_attempt.si_c_etait_vous'|trans }}</p>

{{ include('emails/_button.html.twig', {href: url('app_login'), label: 'registration_attempt.bouton'|trans}) }}

<p style="margin:0 0 12px;">{{ 'registration_attempt.oubli_html'|trans({url: url('app_forgot_password_request')|e, couleur: theme.emailColors.accent|e})|raw }}</p>

<p style="margin:0;">{{ 'registration_attempt.ignorer'|trans }}</p>
{% endblock %}

{% block reason %}{{ 'registration_attempt.raison'|trans({site: theme.name}) }}{% endblock %}
