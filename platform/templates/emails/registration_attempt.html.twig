{% extends 'emails/_layout.html.twig' %}

{% block preheader %}Quelqu'un a essayé de créer un compte {{ marque.name }} avec votre adresse.{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">Bonjour {{ user.displayName }},</p>

<p style="margin:0 0 12px;">Quelqu'un vient d'essayer de créer un compte sur {{ marque.name }} avec votre adresse email. Or vous en avez déjà un.</p>

<p style="margin:0 0 4px;">Si c'était vous, connectez-vous :</p>

{{ include('emails/_button.html.twig', {href: url('app_login'), label: 'Me connecter'}) }}

<p style="margin:0 0 12px;">Mot de passe oublié ? <a class="lien" href="{{ url('app_forgot_password_request') }}" style="color:#9a5b18;">Choisissez-en un nouveau</a>.</p>

<p style="margin:0;">Si ce n'était pas vous, ignorez cet email : aucun compte n'a été créé et le vôtre n'a pas changé.</p>
{% endblock %}

{% block reason %}Vous recevez cet email parce qu'une inscription à {{ marque.name }} a été tentée avec votre adresse.{% endblock %}
