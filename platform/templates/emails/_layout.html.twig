{#-
  Le cadre commun des emails HTML : langue, largeur, en-tête de la marque, pied de page. Chaque email remplit :
  - preheader : le texte d'aperçu de la boîte de réception (sinon, le client reprend « Bonjour Ada, … ») ;
  - content : le message ;
  - reason : pourquoi la personne reçoit cet email.
  CSS en ligne : la plupart des clients ignorent les feuilles de styles. Couleurs de la palette papier du site ;
  un client en mode sombre les inverse lui-même, le <style> ne sert qu'à ceux qui le lisent (Apple Mail).
-#}
{%- set site = url('app_home') -%}
{%- set logo = marque.emailLogoUrl -%}
{%- if logo and logo starts with '/' %}{% set logo = site|trim('/', 'right') ~ logo %}{% endif -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ email.subject }}</title>
<style>
@media (prefers-color-scheme: dark) {
    body, .page { background: #1a1612 !important; }
    .bouton { background: #f0eadd !important; }
    .bouton a { color: #1a1612 !important; }
    .pied { border-top-color: #3b332a !important; }
    .carte { background: #24201a !important; border-color: #3b332a !important; }
    .texte, .texte a.nom { color: #f0eadd !important; }
    .discret { color: #b3a996 !important; }
    .lien { color: #e3a35c !important; }
}
</style>
</head>
<body style="margin:0;padding:0;background:#f7f3ec;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{% block preheader %}{% endblock %}</div>
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f3ec;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" class="carte" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#fffdf8;border:1px solid #e2d9c9;border-radius:10px;">
                <tr>
                    <td class="texte" style="padding:24px 32px 4px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#16120e;">
                        <a class="nom" href="{{ site }}" style="color:#16120e;text-decoration:none;font-size:20px;font-weight:bold;">
                            {%- if logo %}<img src="{{ logo }}" alt="" width="34" height="40" style="vertical-align:middle;border:0;margin-right:10px;">{% endif -%}
                            <span style="vertical-align:middle;">{{ marque.name }}</span>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td class="texte" style="padding:12px 32px 20px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#16120e;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td class="discret pied" style="padding:16px 32px 24px;border-top:1px solid #e2d9c9;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#6a6252;">
                        <p style="margin:0 0 6px;">{{ marque.signature }} · <a class="lien" href="{{ site }}" style="color:#9a5b18;">{{ site|trim('/', 'right')|replace({'https://': '', 'http://': ''}) }}</a></p>
                        <p style="margin:0;">{% block reason %}{% endblock %}</p>
                        {% block legal %}{% endblock %}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
