# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# PostgreSQL. En local, créez une fois le rôle et les bases (voir README), puis `make install`.
# La base de test est « formation_test » (suffixe _test, voir config/packages/doctrine.yaml).
# Surchargez dans .env.local si votre serveur diffère (mot de passe, port, version).
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/formation?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app ###
# Packs de contenu chargés par la plateforme (chemins séparés par des virgules).
# Ajoutez vos packs privés dans .env.local.
CONTENT_PACKS_PATHS="%kernel.project_dir%/../examples/packs"
# Environnements d'exécution (projets de base empaquetés par environments/bin/build-env.sh), dossiers
# séparés par des virgules : ceux livrés avec le moteur, puis ceux que l'instance installe elle-même
# depuis un dépôt Git (voir INSTALLED_ENVIRONMENTS_DIR).
ENVIRONMENTS_DIR="%kernel.project_dir%/../environments,%kernel.project_dir%/var/environnements"
# Dossier écrivable où l'administration installe des environnements. Vide : la fonctionnalité est absente.
INSTALLED_ENVIRONMENTS_DIR="%kernel.project_dir%/var/environnements"
# Hôtes acceptés pour un dépôt d'environnement, séparés par des virgules. Vide : tous les hôtes en https.
ENVIRONMENT_SOURCES_ALLOWLIST=
# Fichiers à télécharger (archives déposées par la CI du dépôt de contenu). En production,
# le volume monté /downloads (voir deploy/compose.yaml) ; en local, un dossier de var/.
DOWNLOADS_DIR="%kernel.project_dir%/var/downloads"
# Identité de l'instance : dossier contenant marque.yaml, ses images et, au besoin, templates/.
# Vide : la marque du moteur (voir README, « Habiller son instance »).
BRANDING_DIR=
# Dossier des sessions (l'image Docker le place dans le volume /data, pour survivre aux déploiements)
SESSIONS_DIR="%kernel.project_dir%/var/sessions/%kernel.environment%"
# Origine « bac à sable » qui sert l'aperçu du code des apprenants. Elle DOIT différer de
# celle de la plateforme (idéalement un autre domaine) : le HTML/JS généré par l'apprenant
# ne doit avoir accès ni aux cookies ni aux pages de la plateforme.
# 1 = inscription sur invitation seulement : un code de cohorte (créée dans /admin) est exigé. 0 = inscription libre, code facultatif.
REGISTRATION_INVITE_ONLY=0
# 1 = page /auto-hebergement (moteur libre, parcours de Forelse sur devis), liée en pied de page. Propre à l'instance de Forelse.
SELF_HOSTING_PAGE=0
SANDBOX_ORIGIN=http://127.0.0.1:8001

# Moteurs de recherche : 0 = rien n'est indexé (préproduction, instance interne d'une école).
# Le bac à sable n'est jamais indexé, quelle que soit cette valeur.
SEARCH_INDEXING=1
# Balise de vérification de Google Search Console (méthode « balise HTML ») : la valeur de content="…". Vide = pas de balise.
GOOGLE_SITE_VERIFICATION=

# Mesure d'audience (Umami auto-hébergé, sans cookie : pas de bandeau de consentement). Les deux vides,
# le cas par défaut : aucune balise dans les pages, rien n'est mesuré. En production, elles sont posées
# par deploy/compose.yaml ; l'identifiant vient du site créé dans le tableau de bord d'Umami.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
###< app ###

###> atelier des auteurs ###
# Génération assistée (facultative) : brouillons d'exercices dans l'atelier, de fiches de cours avec content:lesson-draft --ia.
# Sans clé, tout fonctionne sans elle.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
###< atelier des auteurs ###

###> mentions légales ###
# Qui édite et héberge CETTE instance (pages /mentions-legales et /confidentialite). Le moteur est
# open source : rien n'est écrit dans les pages, tout vient d'ici. Vide = signalé comme manquant.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_LEGAL_FORM=
LEGAL_PUBLISHER_REGISTRATION=
LEGAL_PUBLISHER_VAT=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLISHER_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
# Conditions générales de vente (/cgv) : médiateur de la consommation auquel l'éditeur adhère, obligatoire pour
# vendre à des particuliers (sans lui, l'achat reste « bientôt disponible »), et garantie commerciale « satisfait ou
# remboursé » en jours (vide : pas de garantie).
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
LEGAL_REFUND_DAYS=
###< mentions légales ###

###> symfony/mailer ###
# Envoi des emails (confirmation d'adresse, mot de passe oublié, achats, contact). null:// = rien n'est envoyé ;
# en dev, l'email est visible dans le profiler (/_profiler, onglet « E-mails »), ou dans Mailpit (make dev-mail,
# http://localhost:8025) avec MAILER_DSN=smtp://localhost:1025 dans .env.local.
# En production : Brevo (voir ci-dessous), à définir dans .env.local ou sur le serveur.
MAILER_DSN=null://null
# Expéditeur, « Nom <adresse> ». Le domaine de l'adresse doit être authentifié chez Brevo (SPF, DKIM, DMARC).
MAILER_FROM="Forelse <ne-pas-repondre@forelse.fr>"
# Messages du formulaire de contact et des écoles (/contact, /ecoles-et-entreprises). Vide : LEGAL_PUBLISHER_EMAIL.
CONTACT_EMAIL=
# Alerte à chaque nouvelle inscription (nom, email, cohorte, lien vers la fiche admin). Vide = pas d'alerte.
REGISTRATION_ALERT_EMAIL=
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# Clé d'API Brevo (Paramètres → Clés API) ; l'API HTTPS évite d'ouvrir un port SMTP depuis le conteneur.
# MAILER_DSN=brevo+api://CLE_API@default
###< symfony/brevo-mailer ###

###> paiement (Stripe) ###
# Achat des parcours payants (Stripe Checkout + Stripe Tax). Vide = pas de paiement : le bouton d'achat l'indique.
# Mode test par défaut : clés « sk_test_… » (https://dashboard.stripe.com/test/apikeys). Les clés « sk_live_… »
# ne vont que dans l'environnement du serveur de production, jamais dans un fichier commité.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (https://dashboard.stripe.com/test/webhooks, ou `stripe listen`), « whsec_… ».
# Point d'entrée à déclarer chez Stripe : https://<instance>/paiement/stripe/webhook, événements
# checkout.session.completed et checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=
# Code fiscal Stripe Tax du produit vendu (services fournis par voie électronique par défaut).
STRIPE_TAX_CODE=txcd_10000000

###> Devis de cohorte (mode « établissement ») ###
# Prix par apprenant et par parcours (TTC, en centimes), puis barème dégressif « effectif:pourcentage ».
# Estimation seulement : le devis signé est saisi dans /admin.
COHORT_UNIT_PRICE=3000
COHORT_TIERS="1:100,10:70,30:50"
###< Devis de cohorte ###
###< paiement (Stripe) ###
