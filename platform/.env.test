# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Le client de test se présente comme http://localhost
DEFAULT_URI=http://localhost

# Mentions légales : une instance configurée (le cas « rien de renseigné » est testé en remplaçant le service).
LEGAL_PUBLISHER_NAME="Exemple SAS"
LEGAL_PUBLISHER_LEGAL_FORM="SAS au capital de 1 000 €"
LEGAL_PUBLISHER_REGISTRATION="RCS Lyon 123 456 789"
LEGAL_PUBLISHER_ADDRESS="1 rue de l'Exemple, 69000 Lyon"
LEGAL_PUBLISHER_EMAIL=contact@example.test
LEGAL_PUBLICATION_DIRECTOR="Ada Lovelace"
LEGAL_HOST_NAME="Hébergeur Test"
LEGAL_HOST_ADDRESS="2 rue des Serveurs, 59100 Roubaix"
LEGAL_MEDIATOR_NAME="Médiateur Test"
LEGAL_MEDIATOR_URL=https://mediateur.example.test
LEGAL_REFUND_DAYS=14

# Alerte de nouvelle inscription : envoyée (le cas « vide » est testé en surchargeant la variable).
REGISTRATION_ALERT_EMAIL=alerte@example.test

# Paiement : une passerelle factice remplace Stripe (config/services.yaml) ; le secret sert à signer les webhooks simulés.
STRIPE_SECRET_KEY=sk_test_factice
STRIPE_WEBHOOK_SECRET=whsec_test
