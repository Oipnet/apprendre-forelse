# Analyse statique du moteur. Les erreurs connues sont gelées dans phpstan-baseline.neon : la CI échoue sur
# toute erreur nouvelle. Corriger une erreur de la baseline, puis la régénérer :
#   vendor/bin/phpstan analyse --generate-baseline
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: var/cache/phpstan
    symfony:
        # Le conteneur compilé en dev (bin/console lint:container, ou n'importe quelle commande, le produit).
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
